@using Newtonsoft.Json.Linq
@model WarehouseScannerCore.Models.ScanOutboundModel
@{
    var getText = ViewBag.GetText as Func<string, string, string>;
    var currentCulture = ViewBag.CurrentCulture as string ?? "zh-CN";
    var userId = ViewBag.UserId as string;
    var lastPackId = ViewBag.LastPackId as string ?? "";  // 获取最后一次的 Pack ID

    string GetText(string section, string key)
    {
        return getText?.Invoke(section, key) ?? $"[{section}.{key}]";
    }
}

<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=3.0, user-scalable=yes">
    <title>@GetText("Outbound", "Title")</title>

    <link rel="stylesheet" href="~/css/fontawesome/all.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/shared-scanner.css" asp-append-version="true">
    <!-- SweetAlert2 CSS -->
    <link rel="stylesheet" href="~/css/sweetalert2.css">

    <style>
        /* ========== 基础字体和触摸优化 ========== */
        * {
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-size: 16px;
            line-height: 1.4;
        }

        /* 通用容器样式 */
        .form-container {
            width: 100%;
            max-width: 100%;
            overflow: hidden;
            box-sizing: border-box;
            padding: 0 10px;
        }

        /* ========== 大按钮样式 ========== */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 14px 24px;
            font-size: 18px;
            font-weight: 600;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.2s;
            min-height: 56px;
            touch-action: manipulation;
        }

        .btn-primary {
            background-color: #007bff;
            color: white;
        }

            .btn-primary:active {
                background-color: #0056b3;
                transform: scale(0.98);
            }

        .btn-secondary {
            background-color: #6c757d;
            color: white;
        }

            .btn-secondary:active {
                background-color: #545b62;
                transform: scale(0.98);
            }

        .btn-danger {
            background-color: #dc3545;
            color: white;
        }

            .btn-danger:active {
                background-color: #c82333;
                transform: scale(0.98);
            }

        .btn-pack {
            background-color: #28a745;
            color: white;
        }

            .btn-pack:active {
                background-color: #1e7e34;
                transform: scale(0.98);
            }

        /* 按钮组布局 */
        .button-group {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 20px;
        }

        /* 手机横屏/平板时按钮横向排列 */
        @@media (min-width: 768px) {
            .button-group {
                flex-direction: row;
                gap: 15px;
            }

            .btn {
                flex: 1;
            }
        }

        /* Pack ID 行样式 */
        .pack-id-row {
            display: flex;
            gap: 10px;
            align-items: center;
            margin-bottom: 20px;
        }

            .pack-id-row .pack-id-input {
                flex: 1;
            }

        /* ========== 大文本框样式 ========== */
        .input-field {
            width: 100%;
            padding: 14px 16px;
            border: 2px solid #ddd;
            border-radius: 10px;
            font-size: 18px;
            transition: border-color 0.2s;
            background-color: white;
            min-height: 52px;
        }

            .input-field:focus {
                outline: none;
                border-color: #007bff;
                box-shadow: 0 0 0 3px rgba(0,123,255,0.1);
            }

            .input-field.readonly {
                background-color: #f5f5f5;
                cursor: not-allowed;
            }

        /* 同一行三个输入框布局 - 用于表单网格内 */
        .order-row {
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
        }

            .order-row .order-no {
                flex: 2;
                min-width: 150px;
            }

            .order-row .order-line {
                flex: 1;
                min-width: 80px;
            }

            .order-row .order-rel {
                flex: 1;
                min-width: 80px;
            }

        /* 提示文字 */
        .input-hint {
            font-size: 14px;
            color: #6c757d;
            margin-top: 6px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        /* 错误信息 */
        .error-message {
            color: #dc3545;
            font-size: 14px;
            margin-top: 5px;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        /* 批号单选框容器样式（移动端大触控目标） */
        .lot-radio-container {
            margin-top: 8px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .lot-radio-label {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 16px;
            line-height: 1.4;
            cursor: pointer;
            padding: 12px 14px;
            min-height: 44px;            /* 移动端推荐最小触控高度 */
            box-sizing: border-box;
            border: 1px solid #d0d7e2;
            border-radius: 8px;
            background: #ffffff;
            transition: background 0.15s, border-color 0.15s;
        }
        .lot-radio-label:active {
            background: #e8f0fe;
        }
        .lot-radio-label.checked {
            border-color: #1a73e8;
            background: #e8f0fe;
        }
        .lot-radio-label input[type="radio"] {
            margin: 0;
            width: 20px;
            height: 20px;
            flex: 0 0 auto;
            cursor: pointer;
            accent-color: #1a73e8;
        }

        /* 必填星号样式 */
        .required {
            color: #dc3545;
            margin-left: 4px;
        }

        /* ========== 复选框样式 ========== */
        .manual-checkbox-container {
            display: flex;
            justify-content: flex-end;
            margin-top: 15px;
            margin-bottom: 15px;
            width: 100%;
        }

            .manual-checkbox-container label {
                font-size: 18px;
                display: flex;
                align-items: center;
                gap: 12px;
                cursor: pointer;
                padding: 12px 20px;
                background-color: #f0f0f0;
                border-radius: 12px;
                transition: background-color 0.2s;
                touch-action: manipulation;
            }

                .manual-checkbox-container label:active {
                    background-color: #e0e0e0;
                }

            .manual-checkbox-container input[type="checkbox"] {
                width: 24px;
                height: 24px;
                cursor: pointer;
                margin-right: 8px;
            }

        /* 表格中的复选框 */
        .order-select {
            cursor: pointer;
            width: 22px;
            height: 22px;
            margin: 0 auto;
            display: block;
        }

        /* ========== 客户查询区域 ========== */
        .customer-search {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 20px;
            width: 100%;
            box-sizing: border-box;
        }

            .customer-search .input-group {
                display: flex;
                flex-direction: column;
                gap: 12px;
                width: 100%;
            }

            .customer-search .input-field {
                flex: 1;
                width: 100%;
            }

        @@media (min-width: 768px) {
            .customer-search .input-group {
                flex-direction: row;
            }
        }

        /* ========== 订单表格容器 ========== */
        .orders-table-container {
            background: white;
            border-radius: 12px;
            padding: 15px;
            margin-top: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            width: 100%;
            max-width: 100%;
            box-sizing: border-box;
            overflow: hidden;
        }

            .orders-table-container h3 {
                margin-top: 0;
                margin-bottom: 15px;
                font-size: 20px;
            }

        /* 表格外层包装器 */
        .table-outer-wrapper {
            width: 100%;
            max-width: 100%;
            overflow-x: auto;
            position: relative;
            box-sizing: border-box;
            -webkit-overflow-scrolling: touch;
        }

        /* 表格内层包装器 */
        .table-inner-wrapper {
            max-height: 300px;
            overflow-y: auto;
            width: 100%;
            box-sizing: border-box;
            -webkit-overflow-scrolling: touch;
        }

        @@media (min-width: 768px) and (max-width: 1024px) {
            .table-inner-wrapper {
                max-height: 450px;
            }
        }

        @@media (min-width: 1024px) {
            .table-inner-wrapper {
                max-height: 400px;
            }
        }

        /* 表格样式 */
        .orders-table {
            width: 100%;
            min-width: 1560px;     /* 14 列：仅保留右侧「▼ 库存信息」按钮列 */
            border-collapse: separate;
            border-spacing: 0;
            font-size: 15px;
            table-layout: fixed;
            box-sizing: border-box;
        }

        @@media (min-width: 768px) {
            .orders-table {
                font-size: 14px;
            }
        }

        /* 表头样式 — 允许换行，最多2行 */
        .table-header th {
            position: sticky !important;
            top: 0 !important;
            z-index: 105 !important;
            padding: 8px 6px;
            border-bottom: 2px solid #ddd;
            white-space: normal;
            word-break: break-word;
            line-height: 1.2;
            max-height: 2.4em;
            overflow: hidden;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s;
            box-sizing: border-box;
            background-color: #f2f2f2 !important;
            font-size: 14px;
        }

            .table-header th:active {
                background-color: #e0e0e0 !important;
            }

        /* 固定列样式 */
        .col-fix-1 {
            position: sticky !important;
            left: 0 !important;
            z-index: 106 !important;
            width: 90px !important;
            min-width: 90px !important;
            max-width: 90px !important;
            text-align: center;
            background-color: #f2f2f2 !important;
        }

        .col-fix-2 {
            position: sticky !important;
            left: 90px !important;
            z-index: 105 !important;
            width: 65px !important;
            min-width: 65px !important;
            max-width: 65px !important;
            background-color: #f2f2f2 !important;
            white-space: normal !important;
            word-break: break-word;
            line-height: 1.2;
        }

        .col-fix-3 {
            position: sticky !important;
            left: 155px !important;
            z-index: 105 !important;
            width: 220px !important;
            min-width: 200px !important;
            max-width: 300px !important;
            background-color: #f2f2f2 !important;
            white-space: normal !important;
            word-break: break-word;
            line-height: 1.2;
        }

        .col-fix-4 {
            position: sticky !important;
            left: 375px !important;
            z-index: 105 !important;
            width: 100px !important;
            min-width: 90px !important;
            max-width: 110px !important;
            background-color: #f2f2f2 !important;
            white-space: normal !important;
            word-break: break-word;
            line-height: 1.2;
        }

        /* 表格内容样式 */
        .orders-table td {
            padding: 12px 10px;
            border-bottom: 1px solid #ddd;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            box-sizing: border-box;
            font-size: 15px;
        }

        @@media (min-width: 768px) {
            .orders-table td {
                padding: 10px 10px;
                font-size: 14px;
            }
        }

        /* 非固定列宽度 — Order No/Line/Release/RequiredQty/AvailableStock/Comments 缩窄 (65px) */
        .orders-table th:not([class^="col-fix"]):not(.col-expander):not(.col-part):not(.col-po),
        .orders-table td:not([class^="col-fix"]):not(.col-expander):not(.col-part):not(.col-po) {
            width: 65px !important;
            min-width: 55px !important;
            max-width: 75px !important;
        }
        .orders-table th:not([class^="col-fix"]):not(.col-expander):not(.col-part):not(.col-po) {
            white-space: normal !important;
            word-break: break-word;
            line-height: 1.15;
        }

        /* PO 列 — 110px 固定宽度 */
        .orders-table th.col-po,
        .orders-table td.col-po {
            width: 110px !important;
            min-width: 100px !important;
            max-width: 120px !important;
            white-space: normal !important;
            word-break: break-word;
        }

        /* Part Number 列：固定宽度，内容自适应 */
        .orders-table th.col-part,
        .orders-table td.col-part {
            width: 180px !important;
            min-width: 150px !important;
            max-width: 250px !important;
            white-space: normal !important;
            word-break: break-all;
            overflow: visible !important;
            text-overflow: clip !important;
        }

        /* 内容行固定列背景色 */
        .orders-table tbody .col-fix-1,
        .orders-table tbody .col-fix-2,
        .orders-table tbody .col-fix-3,
        .orders-table tbody .col-fix-4 {
            background-color: #ffffff !important;
            z-index: 100 !important;
        }

        /* 行点击效果 */
        .orders-table tbody tr:active {
            background-color: #f0f0f0 !important;
        }

        .orders-table tbody tr:hover {
            background-color: #f5f5f5 !important;
            cursor: pointer;
        }
        /* 鼠标悬停整行：固定列也要同步变色（优先级更高） */
        .orders-table tbody tr:hover .col-fix-1,
        .orders-table tbody tr:hover .col-fix-2,
        .orders-table tbody tr:hover .col-fix-3,
        .orders-table tbody tr:hover .col-fix-4 {
            background-color: #f5f5f5 !important;
        }

        .orders-table tbody tr:active .col-fix-1,
        .orders-table tbody tr:active .col-fix-2,
        .orders-table tbody tr:active .col-fix-3,
        .orders-table tbody tr:active .col-fix-4 {
            background-color: #f0f0f0 !important;
        }

        /* 右侧「Stock Info」按钮列（sticky right）：点击后打开右侧抽屉（桌面）或底部弹层（手机） */
        .orders-table th.col-expander,
        .orders-table td.col-expander {
            width: 124px !important;
            min-width: 124px !important;
            max-width: 124px !important;
            text-align: center !important;
            padding: 8px 6px !important;
            position: sticky !important;
            right: 0 !important;
            z-index: 105 !important;
            background-color: #f2f2f2 !important;
            border-left: 1px solid #e8ecf1;
        }
        .orders-table tbody td.col-expander { background-color: #fff !important; }
        .orders-table tbody tr:hover td.col-expander { background-color: #f5f5f5 !important; }
        .orders-table tbody tr.inv-row-active td.col-expander { background-color: #e8f1fb !important; }

        /* 蓝色胶囊「▼ Stock Info」按钮 */
        .inv-arrow {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            min-width: 108px;
            height: 30px;
            padding: 0 12px;
            font-size: 12.5px;
            font-weight: 600;
            letter-spacing: 0.2px;
            color: #fff;
            background: linear-gradient(180deg, #4d94e6 0%, #2b79d4 100%);
            cursor: pointer;
            border-radius: 15px;
            border: 1px solid #2b79d4;
            box-shadow: 0 1px 2px rgba(45,123,213,0.28), inset 0 1px 0 rgba(255,255,255,0.25);
            transition: transform 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
            user-select: none;
            touch-action: manipulation;
            white-space: nowrap;
        }
        .inv-arrow .arr { font-size: 11px; line-height: 1; opacity: 0.95; }
        .inv-arrow:hover {
            background: linear-gradient(180deg, #5fa2ef 0%, #3684de 100%);
            box-shadow: 0 2px 6px rgba(45,123,213,0.4), inset 0 1px 0 rgba(255,255,255,0.28);
            transform: translateY(-1px);
        }
        .inv-arrow:active { transform: translateY(0); box-shadow: 0 1px 2px rgba(45,123,213,0.3); }

        /* 库存卡片网格（抽屉 / 手机弹层共用） */
        .inv-card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
            gap: 8px;
        }
        .inv-card {
            background: #fff;
            border: 1px solid #dce4ee;
            border-radius: 6px;
            padding: 8px 10px;
            font-size: 12.5px;
            line-height: 1.55;
            box-shadow: 0 1px 2px rgba(0,0,0,0.04);
        }
        .inv-card-row { display: flex; justify-content: space-between; gap: 6px; }
        .inv-card-row .lbl { color: #657587; font-weight: 500; }
        .inv-card-row .val { color: #1d2a39; font-weight: 600; text-align: right; word-break: break-all; }
        .inv-card-row .qty { color: #e34d59; font-weight: 700; font-size: 13px; }

        .inv-loading-hint, .inv-empty-hint, .inv-drawer-loading, .inv-drawer-empty { color: #8595a7; font-style: italic; padding: 6px 0; }

        /* ========== 库存抽屉 / 手机底部弹层 ========== */
        .inv-drawer-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.45);
            z-index: 2000;
            opacity: 0;
            visibility: hidden;
            transition: opacity .25s ease, visibility .25s;
        }
        .inv-drawer-overlay.open { opacity: 1; visibility: visible; }

        /* 抽屉打开时禁止 body 滚动，避免底层表格随鼠标/手指滚动 */
        body.inv-drawer-open { overflow: hidden !important; }

        .inv-drawer {
            position: fixed;
            top: 0;
            right: 0;
            width: 420px;
            height: 100%;
            background: #fff;
            z-index: 2001;
            transform: translateX(100%);
            transition: transform .3s cubic-bezier(.16,1,.3,1);
            display: flex;
            flex-direction: column;
            box-shadow: -4px 0 24px rgba(0,0,0,0.12);
        }
        .inv-drawer.open { transform: translateX(0); }

        .inv-drawer-header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 14px 18px;
            border-bottom: 1px solid #e8ecf1;
            background: #f8fbff;
        }
        .inv-drawer-title   { font-size: 15px; font-weight: 700; color: #1d2a39; }
        .inv-drawer-subtitle { font-size: 12.5px; color: #657587; margin-top: 2px; }
        .inv-drawer-close {
            width: 32px; height: 32px; border: none; background: transparent;
            font-size: 20px; color: #657587; cursor: pointer; border-radius: 6px;
        }
        .inv-drawer-close:hover { background: #eef2f7; }
        .inv-drawer-body {
            flex: 1;
            overflow-y: auto;
            padding: 16px 18px;
            background: linear-gradient(180deg, #f8fbff 0%, #f0f6ff 100%);
        }

        /* 手机端：抽屉变为底部弹层 */
        @@media (max-width: 768px) {
            .inv-drawer {
                top: auto;
                bottom: 0;
                left: 0;
                right: 0;
                width: 100%;
                height: 75vh;
                max-height: 520px;
                transform: translateY(100%);
                border-radius: 16px 16px 0 0;
                box-shadow: 0 -4px 24px rgba(0,0,0,0.12);
            }
            .inv-drawer.open { transform: translateY(0); }
            .inv-card-grid { grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)) !important; }
        }

        /* 排序图标 */
        .sortable {
            position: relative;
            padding-right: 25px !important;
        }

            .sortable:after {
                content: "⇅";
                position: absolute;
                right: 8px;
                top: 50%;
                transform: translateY(-50%);
                opacity: 0.5;
                font-size: 13px;
            }

        .sort-asc:after {
            content: "↑";
            opacity: 1;
        }

        .sort-desc:after {
            content: "↓";
            opacity: 1;
        }

        /* ========== 表单网格布局 ========== */
        .form-grid {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-top: 20px;
        }

        .form-item {
            width: 100%;
        }

            .form-item label {
                display: block;
                font-size: 17px;
                font-weight: 600;
                margin-bottom: 10px;
            }

        /* 订单信息区域 - 使用与物料代码一致的样式，标题在上方 */
        .order-info-item {
            width: 100%;
            margin-bottom: 20px;
        }

            .order-info-item label {
                display: block;
                font-size: 17px;
                font-weight: 600;
                margin-bottom: 10px;
            }

        @@media (min-width: 768px) {
            .form-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 20px;
            }

            .form-item.full-width {
                grid-column: 1 / -1;
            }

            .form-item label {
                font-size: 16px;
            }

            .order-info-item label {
                font-size: 16px;
            }
        }

        /* 全宽元素 */
        .full-width {
            grid-column: 1 / -1;
        }

        /* 文本域 */
        textarea.input-field {
            resize: vertical;
            min-height: 100px;
        }

        /* ========== 页面头部 ========== */
        .page-header {
            margin-bottom: 20px;
            padding: 0 15px;
        }

        .page-title {
            font-size: 26px;
            margin: 0 0 8px 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .page-subtitle {
            font-size: 15px;
            color: #6c757d;
        }

        /* 手机端隐藏页面标题 + 表单单列压缩 */
        @@media (max-width: 768px) {
            .page-header { display: none !important; }
            .form-container { padding: 12px; }
            .button-group { gap: 8px; flex-wrap: wrap; }
            .button-group .btn { flex: 1; min-width: 44%; min-height: 48px; font-size: 15px; padding: 12px 8px; touch-action: manipulation; }

            /* ========== 手机端：表格 → 卡片式布局 ========== */
            .orders-table-container { padding: 10px; margin-top: 12px; border-radius: 10px; }
            .orders-table-container h3 { font-size: 16px; margin-bottom: 10px; }

            /* 隐藏表头，用卡片内 label 显示 */
            .orders-table thead { display: none !important; }
            .orders-table, .orders-table tbody, .orders-table tr, .orders-table td {
                display: block !important;
                width: 100% !important;
                min-width: 100% !important;
                max-width: 100% !important;
            }
            /* 每张订单一张卡片 */
            .orders-table tbody tr {
                position: relative !important;
                display: block !important;
                margin-bottom: 14px !important;
                padding: 14px 12px 12px 52px !important;
                border: 1px solid #e2e5e9 !important;
                border-radius: 10px !important;
                background: #fff !important;
                box-shadow: 0 1px 4px rgba(0,0,0,0.05) !important;
                white-space: normal !important;
                left: 0 !important;
            }
            .orders-table tbody tr.selected {
                border-color: #2d7bd5 !important;
                box-shadow: 0 0 0 2px rgba(45,123,213,0.2) !important;
            }
            /* 清除固定列 sticky / 所有单元格：列转行显示 */
            .orders-table td {
                position: static !important;
                display: flex !important;
                justify-content: space-between !important;
                align-items: flex-start !important;
                padding: 6px 0 !important;
                border-bottom: 1px dashed #eef0f2 !important;
                background: transparent !important;
                left: auto !important;
                white-space: normal !important;
                word-break: break-word !important;
                font-size: 14px !important;
                line-height: 1.4 !important;
                overflow: visible !important;
                text-overflow: clip !important;
                width: 100% !important;
                min-width: 100% !important;
                max-width: 100% !important;
                z-index: 1 !important;
            }
            .orders-table td:last-child { border-bottom: none !important; }

            /* 单元格左边：字段 label（英文/中文自适应） */
            .orders-table td::before {
                content: attr(data-label);
                display: inline-block;
                font-weight: 600;
                color: #526375;
                flex: 0 0 100px;
                min-width: 100px;
                margin-right: 8px;
                text-align: left;
                font-size: 13px;
            }
            .orders-table td > * { flex: 1; text-align: right; }

            /* 展开按钮列：卡片右上角折叠/展开（48×48 大触摸区） */
            .orders-table td.col-expander {
                position: absolute !important;
                top: 0; right: 0;
                width: 48px !important;
                height: 48px !important;
                padding: 0 !important;
                margin: 0 !important;
                border: none !important;
                background: transparent !important;
                justify-content: center !important;
                align-items: center !important;
                flex: none !important;
            }
            .orders-table td.col-expander::before { display: none !important; content: none !important; }
            .orders-table td.col-expander .inv-arrow {
                min-width: 108px !important;
                height: 32px !important;
                padding: 0 14px !important;
                font-size: 13.5px !important;
            }

            /* 手机端：抽屉内卡片网格保持紧凑 */
            .inv-card-grid { grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)) !important; }

            /* 取消固定 sticky 包装器的横向滚动，改用纵向卡片 */
            .table-outer-wrapper { overflow-x: visible !important; }
            .table-inner-wrapper { max-height: none !important; }
        }

        /* 手机横屏 + 小平板：紧凑卡片网格，约 110px 列 */
        @@media (max-width: 768px) and (orientation: landscape) {
            .orders-table tbody tr { padding: 10px 12px 8px 52px; margin-bottom: 10px; }
            .orders-table td { padding: 4px 0 !important; }
            .inv-card-grid { grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)) !important; }
        }

        /* ========== 平板 769–1024px：表格保留，但所有列宽度收缩 + 横滑 ========== */
        @@media (min-width: 769px) and (max-width: 1024px) {
            .orders-table { min-width: 1260px; }  /* 14 列收缩版 + 108px 「▼ 库存信息」按钮列 */
            /* 固定列整体缩 15~20% */
            .col-fix-1 { width: 72px !important; min-width: 72px !important; max-width: 72px !important; }
            .col-fix-2 { width: 52px !important; min-width: 52px !important; max-width: 52px !important; left: 72px !important; }
            .col-fix-3 { width: 176px !important; min-width: 160px !important; max-width: 200px !important; left: 124px !important; padding: 8px 4px !important; }
            .col-fix-4 { width: 88px !important; min-width: 80px !important; max-width: 96px !important; left: 300px !important; padding: 8px 4px !important; }
            /* 窄列：65px → 52px（排除展开列 / Part / PO） */
            .orders-table th:not([class^="col-fix"]):not(.col-expander):not(.col-part):not(.col-po),
            .orders-table td:not([class^="col-fix"]):not(.col-expander):not(.col-part):not(.col-po) {
                width: 52px !important; min-width: 44px !important; max-width: 60px !important;
                padding: 8px 4px !important; font-size: 13px !important;
            }
            /* PO 列 110px → 88px */
            .orders-table th.col-po, .orders-table td.col-po {
                width: 88px !important; min-width: 78px !important; max-width: 96px !important;
                padding: 8px 4px !important; font-size: 13px !important;
            }
            /* Part 列 180px → 140px */
            .orders-table th.col-part, .orders-table td.col-part {
                width: 140px !important; min-width: 120px !important; max-width: 180px !important;
                padding: 8px 4px !important; font-size: 13px !important;
            }
            /* 右侧「▼ 库存信息」按钮列 124px → 108px */
            .orders-table th.col-expander, .orders-table td.col-expander {
                width: 108px !important; min-width: 108px !important; max-width: 108px !important;
                padding: 8px 4px !important;
            }
            .orders-table td.col-expander .inv-arrow {
                min-width: 94px !important; height: 28px !important;
                padding: 0 10px !important; font-size: 12px !important;
            }
            .orders-table td { font-size: 13px !important; padding: 8px 6px !important; }
            .table-header th { font-size: 12px !important; padding: 8px 4px !important; }
            .inv-card-grid { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); }
        }

        /* PC 大屏幕：卡片更宽（相对紧凑版再放宽） */
        @@media (min-width: 1440px) {
            .inv-card-grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); }
        }

        /* ========== 底部Toast提示样式 ========== */
        .status-toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0,0,0,0.85);
            color: white;
            padding: 12px 24px;
            border-radius: 40px;
            font-size: 15px;
            z-index: 10000;
            max-width: 90%;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            animation: fadeInUp 0.3s ease;
            font-weight: 500;
        }

        .status-toast.success { background: #28a745; }
        .status-toast.error   { background: #dc3545; }
        .status-toast.warning { background: #ffc107; color: #333; }
        .status-toast.info    { background: #17a2b8; }

        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateX(-50%) translateY(20px); }
            to   { opacity: 1; transform: translateX(-50%) translateY(0); }
        }

        /* 隐藏原来的状态消息区域 */
        .status-message { display: none; }

        /* ========== 提交发货失败提示条（常驻显示，直到下次提交/重置） ==========
           后端返回的具体错误（如 Epicor「无效仓库和库位」、「库位 01/3-1153 无可用库存」）
           必须让操作员看得见：模态弹窗会被后续扫码动作关闭、底部 toast 仅 2 秒，
           因此这里再提供一个不会自动消失的醒目提示条。 */
        .submit-error-banner {
            display: none;
            margin: 0 0 12px;
            padding: 10px 14px;
            border: 1px solid #f5c6cb;
            border-left: 5px solid #dc3545;
            border-radius: 6px;
            background: #fdecea;
            color: #a71d2a;
            font-size: 14px;
            font-weight: 500;
            line-height: 1.5;
            text-align: left;
            word-break: break-word;
            /* 注意：这里不能复用 fadeInUp —— 它的 translateX(-50%) 是配合固定定位的底部 toast
               （position:fixed + left:50%）设计的；用在文档流内的提示条上，会让它先向左偏移
               半个自身宽度再弹回，出现肉眼可见的横向抖动。故单独定义一个只做纵向位移的动画。 */
            animation: bannerSlideIn 0.25s ease;
        }

        @@keyframes bannerSlideIn {
            from { opacity: 0; transform: translateY(-6px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .submit-error-banner i { margin-right: 6px; }
        .submit-error-banner .error-detail { font-weight: 600; }
    </style>

</head>
<body>
    <div class="container">
        <!-- 页面标题 -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fas fa-truck"></i> @GetText("Outbound", "Title")
            </h1>
            <div class="page-subtitle">
                @GetText("Outbound", "Subtitle")
            </div>
        </div>

        <div id="statusMessage" class="status-message"></div>

        <div class="form-container">
            <form id="outboundForm" method="post" asp-action="ShipOrder">
                @Html.AntiForgeryToken()

                <!-- 提交发货失败提示条：常驻展示后端返回的真实失败原因
                     （Epicor 业务错误 / 库存与订单校验失败 / 接口调用失败等） -->
                <div id="submitErrorBanner" class="submit-error-banner" role="alert" aria-live="assertive"></div>

                <div class="button-group">
                    <button type="submit" class="btn btn-primary" id="submitBtn">
                        <i class="fas fa-check-circle"></i> @GetText("Outbound", "SubmitButton")
                    </button>
                    <button type="button" class="btn btn-secondary" id="resetBtn">
                        <i class="fas fa-redo-alt"></i> @GetText("Outbound", "ResetButton")
                    </button>
                    <button type="button" class="btn btn-danger" id="cancelBtn">
                        <i class="fas fa-times-circle"></i> @GetText("Outbound", "CancelButton")
                    </button>
                </div>

                <!-- Pack ID 行 -->
                <div class="pack-id-row">
                    <button type="button" class="btn btn-pack" id="generatePackBtn">
                        <i class="fas fa-box"></i> Pack ID
                    </button>
                    <input type="text" class="input-field pack-id-input" id="packId" name="packId" placeholder="Pack ID" value="@lastPackId" autocomplete="off">
                </div>
                <div class="error-message" id="packIdError"></div>

                <div class="manual-checkbox-container">
                    <label>
                        <input type="checkbox" id="manualOrderCheckbox"> @GetText("Outbound", "ManualSelectOrder")
                    </label>
                </div>

                <div class="customer-search" style="display: none;">
                    <div class="input-group">
                        <input type="text" id="customerCodeInput" class="input-field" placeholder="@GetText("Outbound", "CustomerCode")" />
                        <input type="text" id="customerNameInput" class="input-field" placeholder="@GetText("Outbound", "CustomerName")" />
                        <input type="text" id="orderNumInput" class="input-field" placeholder="@GetText("Outbound", "Order")" />
                        <input type="text" id="poNumInput" class="input-field" placeholder="@GetText("Outbound", "PO")" />
                        <button type="button" id="searchOrdersBtn" class="btn btn-primary">
                            <i class="fas fa-search"></i> @GetText("Outbound", "SearchButton")
                        </button>
                    </div>
                </div>

                <div class="orders-table-container" style="display: none;">
                    <h3>@GetText("Outbound", "OrderShipmentList")</h3>

                    <div class="table-outer-wrapper">
                        <div class="table-inner-wrapper" id="ordersTableWrapper">
                            <table id="ordersTable" class="orders-table">
                                <thead class="table-header">
                                    <tr>
                                        <th class="col-fix-1 sortable" data-sort-key="select">@GetText("Outbound", "Select")</th>
                                        <th class="col-fix-2 sortable" data-sort-key="customerCode">@GetText("Outbound", "CustomerCode")</th>
                                        <th class="col-fix-3 sortable" data-sort-key="customerName">@GetText("Outbound", "CustomerName")</th>
                                        <th class="col-fix-4 sortable" data-sort-key="reqDate">@GetText("Outbound", "ReqDate")</th>
                                        <th class="sortable col-po" data-sort-key="po">@GetText("Outbound", "PO")</th>
                                        <th class="sortable" data-sort-key="order">@GetText("Outbound", "Order")</th>
                                        <th>@GetText("Outbound", "Line")</th>
                                        <th>@GetText("Outbound", "Release")</th>
                                        <th class="col-part">@GetText("Outbound", "Part")</th>
                                        <th class="col-part">@GetText("Outbound", "PartDescription")</th>
                                        <th>@GetText("Outbound", "RequiredQty")</th>
                                        <th>@GetText("Outbound", "OnHandQty")</th>
                                        <th>@GetText("Outbound", "Comments")</th>
                                        <th class="col-expander" style="width:124px !important; min-width:124px !important; max-width:124px !important;" title="@GetText("Outbound", "DetailInventory")">@GetText("Outbound", "DetailInventoryAction")</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- 库存信息抽屉：桌面端右侧滑出，手机端底部弹层 -->
                <div class="inv-drawer-overlay" id="invDrawerOverlay" aria-hidden="true"></div>
                <div class="inv-drawer" id="invDrawerPanel" role="dialog" aria-modal="true" aria-labelledby="invDrawerTitle">
                    <div class="inv-drawer-header">
                        <div>
                            <div class="inv-drawer-title" id="invDrawerTitle">@GetText("Outbound", "DetailInventory")</div>
                            <div class="inv-drawer-subtitle" id="invDrawerSubtitle"></div>
                        </div>
                        <button type="button" class="inv-drawer-close" id="invDrawerClose" aria-label="Close">&times;</button>
                    </div>
                    <div class="inv-drawer-body" id="invDrawerBody">
                        <div class="inv-drawer-loading" id="invDrawerLoading">@GetText("Outbound", "InvLoading")</div>
                        <div class="inv-drawer-empty" id="invDrawerEmpty" style="display:none;"></div>
                        <div id="invDrawerContent"></div>
                    </div>
                </div>

                <!-- 订单信息区域 - 三个字段同一行 -->
                <div class="form-item full-width">
                    <div style="display: flex; gap: 10px;">
                        <div style="flex: 1;">
                            <label>@GetText("Outbound", "SalesOrderNo") <span class="required">*</span></label>
                            <input type="text" class="input-field scan-input" id="salesOrderNo" name="SalesOrderNo" placeholder="@GetText("Outbound", "SalesOrderPlaceholder")" autocomplete="off" autofocus>
                            <div class="error-message" id="salesOrderError"></div>
                        </div>
                        <div style="flex: 1;">
                            <label>@GetText("Outbound", "SalesOrderLineNo") <span class="required">*</span></label>
                            <input type="text" class="input-field" id="salesOrderLineNo" name="OrderLine" autocomplete="off">
                            <div class="error-message" id="salesOrderLineError"></div>
                        </div>
                        <div style="flex: 1;">
                            <label>@GetText("Outbound", "OrderRelNum") <span class="required">*</span></label>
                            <input type="text" class="input-field" id="orderRelNum" name="OrderRelNum" autocomplete="off">
                            <div class="error-message" id="orderRelNumError"></div>
                        </div>
                    </div>
                    <div class="input-hint">
                        <i class="fas fa-keyboard"></i> @GetText("Outbound", "OrderScanPromptMessage")
                    </div>
                </div>



                <div class="form-grid">
                    <div class="form-item">
                        <label>
                            @GetText("Outbound", "MaterialCode") <span class="required">*</span>
                        </label>
                        <div class="input-group">
                            <input type="text"
                                   class="input-field scan-input"
                                   id="materialCode"
                                   name="MaterialCode"
                                   placeholder="@GetText("Outbound", "MaterialPlaceholder")"
                                   autocomplete="off">
                        </div>
                        <div class="input-hint">
                            <i class="fas fa-keyboard"></i> @GetText("Outbound", "MatScanPromptMessage")
                        </div>
                        <div class="error-message" id="materialCodeError"></div>
                    </div>

                    <div class="form-item">
                        <label>
                            @GetText("Outbound", "Quantity") <span class="required">*</span>
                        </label>
                        <input type="number"
                               class="input-field"
                               id="quantity"
                               name="Quantity"
                               min="0.01"
                               step="0.01"
                               placeholder="@GetText("Outbound", "QuantityPlaceholder")"
                               autocomplete="off">
                        <div class="error-message" id="quantityError"></div>
                        @*出货数量信息（红色单行显示）：计划出货 / 已发货数量 / 未出货 / 库存数
                          整行文案取自语言资源 OrderQtyInfoFormat（中英文），data-format 供 JS 填充数量
                          注意：div 与 span 必须紧邻无空白，且不可用 white-space:pre——否则缩进空白会被渲染成左侧大段缩进*@
                        <div id="orderQtyInfoDisplay" data-format="@GetText("Outbound", "OrderQtyInfoFormat")" style="display:none; color:#e53935; font-weight:bold; margin-top:4px; font-size:0.95em; text-align:left;"><span id="dispOrderQtyInfoLine"></span></div>
                    </div>

                    <div class="form-item">
                        <label>@GetText("Outbound", "Unit")</label>
                        <input type="text" class="input-field" id="unit" name="Unit" autocomplete="off">
                    </div>

                    <div class="form-item">
                        <label>@GetText("Outbound", "WarehouseCode")</label>
                        <input type="text" class="input-field" id="warehouseCode" name="WarehouseCode" autocomplete="off">
                    </div>

                    <div class="form-item">
                        <label>@GetText("Outbound", "Location")</label>
                        <input type="text" class="input-field" id="location" name="Location" autocomplete="off">
                    </div>

                    <div class="form-item">
                        <label>@GetText("Outbound", "BatchNo") <span class="required">*</span></label>
                        <input type="text" class="input-field" id="batchNo" name="BatchNo" autocomplete="off">
                        <div class="error-message" id="batchNoError"></div>
                        <div id="lotRadioList" class="lot-radio-container" style="display:none;"></div>
                    </div>

                    <div id="operator-section" class="form-item">
                        <label>@GetText("Outbound", "Operator")</label>
                        <input type="text" class="input-field readonly" id="operator" name="Operator" value="@userId" readonly>
                    </div>
                </div>

                <div class="form-item full-width">
                    <label>@GetText("Outbound", "Remarks")</label>
                    <textarea class="input-field" id="remarks" name="Remarks" rows="2"></textarea>
                </div>
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/Scancode-parser.js" asp-append-version="true"></script>
    <!-- SweetAlert2 JS -->
    <script src="~/js/sweetalert.js"></script>

    <script>
        var localTexts = {
            salesOrderRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "SalesOrderRequired"))),
            salesOrderLineRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "SalesOrderLineRequired"))),
            orderRelNumRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "OrderRelNumRequired"))),
            materialCodeRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "MaterialCodeRequired"))),
            quantityRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "QuantityRequired"))),
            batchNoRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "BatchNoRequired"))),
            lotDateLabel: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "LotDateLabel"))),
            packIdRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "PackIdRequired"))),
            confirmCancel: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "ConfirmCancel"))),
            submitting: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "Submitting"))),
            submitSuccess: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "SubmitSuccess"))),
            submitFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "SubmitFailed"))),
            networkError: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "NetworkError"))),
            orderBarcodeParseSuccess: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "OrderBarcodeParseSuccess"))),
            materialBarcodeParseSuccess: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "MaterialBarcodeParseSuccess"))),
            pleaseEnterOrderLine: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "PleaseEnterOrderLine"))),
            orderValidationPassed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "OrderValidationPassed"))),
            orderValidationFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "OrderValidationFailed"))),
            inventoryValidationPassed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "InventoryValidationPassed"))),
            inventoryValidationFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "InventoryValidationFailed"))),
            orderAndLineRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "OrderAndLineRequired"))),
            orderAndLineRequiredForInventory: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "OrderAndLineRequiredForInventory"))),
            materialCodeRequiredMsg: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "MaterialCodeRequiredMsg"))),
            formReset: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "FormReset"))),
            pleaseEnterCustomerInfo: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "PleaseEnterCustomerInfo"))),
            searching: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "Searching"))),
            searchSuccess: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "SearchSuccess"))),
            searchFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "SearchFailed"))),
            noData: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "NoData"))),
            parserReady: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "ParserReady"))),
            parserInitFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "ParserInitFailed"))),
            generatingPackId: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "GeneratingPackId"))),
            generatePackIdSuccess: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "GeneratePackIdSuccess"))),
            generatePackIdFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "GeneratePackIdFailed"))),
            confirmButton: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Common", "Confirm"))),
            cancelButtonText: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Common", "Cancel"))),
            okButton: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Common", "OK"))),
            commonError: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "CommonError"))),
            invLoading: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "InvLoading"))),
            invEmpty: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Outbound", "InvEmpty"))),
