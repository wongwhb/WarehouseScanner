        /** 轻量 HTML 转义：动态文本拼入 innerHTML 前统一处理，避免特殊字符破坏 DOM */
        function __htmlEscape(v) {
            if (v === null || v === undefined) return '';
            v = String(v);
            return v.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }
        /** 生成"进行中 Promise 去重"的缓存 key */
        function __pKey(prefix, parts) {
            return prefix + ':' + parts.map(function (s) { return s == null ? '' : String(s); }).join('|');
        }
        /** 进行中 Promise 去重复用（不改变业务逻辑，只是避免同一参数并发重复打接口）
         *  —— 相同 key 的调用，如果上一次 Promise 还未 settle（未 resolve/reject），直接返回上一次 Promise。
         *  —— 完成后自动从 __inFlight 清除，下一轮会再次请求（保证结果新鲜度）。
         */
        function __useInFlight(key, factory) {
            if (__inFlight[key]) return __inFlight[key];
            var p = Promise.resolve().then(function () { return factory(); });
            __inFlight[key] = p;
            var cleanup = function () { delete __inFlight[key]; };
            p.then(cleanup, cleanup);
            return p;
        }
        /** CSRF 头统一读取（避免每次 AJAX 重复拼接两个 header，且只写一个 X-CSRF-TOKEN 即可） */
