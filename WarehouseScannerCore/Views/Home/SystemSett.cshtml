@{
    var userId = ViewData["UserId"] as string;
    var userRole = ViewData["UserRole"] as string;
    var siteName = ViewData["SiteName"] as string;
    var loginTime = ViewData["LoginTime"] as string;

    // 从Cookie中获取当前语言设置
    var language = Context.Request.Cookies["Language"];
    var culture = !string.IsNullOrEmpty(language) ?
        new System.Globalization.CultureInfo(language) :
        System.Globalization.CultureInfo.CurrentUICulture;

    // 加载语言资源文件
    var languageResources = ViewData["LanguageResources"] as Dictionary<string, Dictionary<string, string>>;

    ViewData["Title"] = GetText("Config", "Title");

    // 定义辅助函数获取文本
    string GetText(string section, string key)
    {
        if (languageResources != null &&
            languageResources.TryGetValue(section, out var sectionResources) &&
            sectionResources.TryGetValue(key, out var value))
        {
            return value;
        }

        // 如果找不到资源，返回默认值
        return GetDefaultText(section, key, culture.Name);
    }

    // 提供默认文本
    string GetDefaultText(string section, string key, string cultureCode)
    {
        // 根据文化和section提供默认文本
        if (cultureCode == "zh-CN")
        {
            var zhCnTexts = new Dictionary<string, Dictionary<string, string>>
            {
                ["Home"] = new Dictionary<string, string>
                {
                    ["Title"] = "首页",
                    ["AppTitle"] = "GCM仓库管理系统",
                    ["WelcomeBack"] = "欢迎回来",
                    ["CurrentStation"] = "当前站点",
                    ["SystemFunctions"] = "系统功能",
                    ["UserInformation"] = "用户信息",
                    ["UserId"] = "用户ID",
                    ["UserRole"] = "用户角色",
                    ["CurrentSite"] = "当前工厂",
                    ["LoginTime"] = "登录时间",
                    ["LogoutButton"] = "退出登录",
                    ["MaterialIssuanceScan"] = "发料扫码",
                    ["MaterialIssuanceDesc"] = "物料发放与扫码确认",
                    ["OutboundScan"] = "出库扫码",
                    ["OutboundScanDesc"] = "挑选发货物料",
                    ["InboundScan"] = "入库扫码",
                    ["InboundScanDesc"] = "供应商收货扫码登记",
                    ["StockTransfer"] = "库存转移扫码",
                    ["StockTransferDesc"] = "库位调整与转移操作",
                    ["InventoryScan"] = "盘点扫码",
                    ["InventoryScanDesc"] = "盘点调整",
                    ["SystemSettings"] = "系统设置",
                    ["SystemSettingsDesc"] = "参数配置与管理",
                    ["SessionExpiredTitle"] = "会话已过期",
                    ["SessionExpiredMessage"] = "由于长时间无操作或安全原因，您的会话已过期。",
                    ["SessionReloginMessage"] = "请重新登录以继续使用系统。",
                    ["ReloginButton"] = "重新登录",
                    ["AuthRequired"] = "请先登录或重新登录"
                },
                ["Common"] = new Dictionary<string, string>
                {
                    ["AppName"] = "GCM仓库扫码系统"
                },
                ["Login"] = new Dictionary<string, string>
                {
                    ["Chinese"] = "中文",
                    ["English"] = "英文"
                },
                ["Config"] = new Dictionary<string, string>
                {
                    ["Title"] = "系统配置管理",
                    ["ConfigFunctions"] = "配置功能",
                    ["SiteManagement"] = "站点管理",
                    ["SiteManagementDesc"] = "管理系统中的各个站点信息",
                    ["MenuPermission"] = "菜单权限配置",
                    ["MenuPermissionDesc"] = "配置用户菜单访问权限",
                    ["DatabaseConfig"] = "数据库连接配置",
                    ["DatabaseConfigDesc"] = "配置和管理数据库连接",
                    ["BackToHome"] = "返回首页"
                }
            };

            if (zhCnTexts.TryGetValue(section, out var sectionDict) &&
                sectionDict.TryGetValue(key, out var value))
            {
                return value;
            }
        }
        else
        {
            var enUsTexts = new Dictionary<string, Dictionary<string, string>>
            {
                ["Home"] = new Dictionary<string, string>
                {
                    ["Title"] = "Home",
                    ["AppTitle"] = "GCM Warehouse Management System",
                    ["WelcomeBack"] = "Welcome back",
                    ["CurrentStation"] = "Current Site",
                    ["SystemFunctions"] = "System Functions",
                    ["UserInformation"] = "User Information",
                    ["UserId"] = "User ID",
                    ["UserRole"] = "User Role",
                    ["CurrentSite"] = "Current Factory",
                    ["LoginTime"] = "Login Time",
                    ["LogoutButton"] = "Logout",
                    ["MaterialIssuanceScan"] = "Material Issuance Scanning",
                    ["MaterialIssuanceDesc"] = "Material Issuance to Work Orders",
                    ["OutboundScan"] = "Outbound Scanning",
                    ["OutboundScanDesc"] = "Pick and Ship Materials",
                    ["InboundScan"] = "Inbound Scanning",
                    ["InboundScanDesc"] = "Supplier Receipt Scanning Registration",
                    ["StockTransfer"] = "Stock Transfer Scanning",
                    ["StockTransferDesc"] = "Location Adjustment and Transfer Operations",
                    ["InventoryScan"] = "Inventory Counting Scan",
                    ["InventoryScanDesc"] = "Inventory Adjustment",
                    ["SystemSettings"] = "System Settings",
                    ["SystemSettingsDesc"] = "Parameter Configuration and Management",
                    ["SessionExpiredTitle"] = "Session Expired",
                    ["SessionExpiredMessage"] = "Your session has expired due to inactivity or security reasons.",
                    ["SessionReloginMessage"] = "Please log in again to continue using the system.",
                    ["ReloginButton"] = "Re-login",
                    ["AuthRequired"] = "Please login or re-login first"
                },
                ["Common"] = new Dictionary<string, string>
                {
                    ["AppName"] = "GCM Warehouse Scanning System"
                },
                ["Login"] = new Dictionary<string, string>
                {
                    ["Chinese"] = "Chinese",
                    ["English"] = "English"
                },
                ["Config"] = new Dictionary<string, string>
                {
                    ["Title"] = "System Configuration Management",
                    ["ConfigFunctions"] = "Configuration Functions",
                    ["SiteManagement"] = "Site Management",
                    ["SiteManagementDesc"] = "Manage site information in the system",
                    ["MenuPermission"] = "Menu Permission Configuration",
                    ["MenuPermissionDesc"] = "Configure user menu access permissions",
                    ["DatabaseConfig"] = "Database Connection Configuration",
                    ["DatabaseConfigDesc"] = "Configure and manage database connections",
                    ["BackToHome"] = "Back to Home"
                }
            };

            if (enUsTexts.TryGetValue(section, out var sectionDict) &&
                sectionDict.TryGetValue(key, out var value))
            {
                return value;
            }
        }

        // 最后返回占位符
        return $"[{section}.{key}]";
    }
}

<!DOCTYPE html>
<html lang="@culture.Name">
<head>
    <meta charset="utf-8">
    <!-- 针对PAD的viewport优化 -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=3.0, user-scalable=yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

    <title>@GetText("Config", "Title") - @GetText("Home", "AppTitle")</title>

    <!-- 防止缓存 -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">

    <!-- 引入Font Awesome -->
    <link rel="stylesheet" href="~/css/fontawesome/all.min.css" asp-append-version="true">

    <!-- 引入公共的Session管理CSS -->
    <link rel="stylesheet" href="~/css/session-manager.css" asp-append-version="true">

    <style>
        /* PAD优化样式 - 与Index.cshtml保持一致 */
        :root {
            --primary-color: #667eea;
            --secondary-color: #764ba2;
            --success-color: #4CAF50;
            --warning-color: #FF9800;
            --info-color: #2196F3;
            --purple-color: #9C27B0;
            --gray-color: #607D8B;
            --teal-color: #009688;
            --orange-color: #FF5722;
        }

        * {
            -webkit-tap-highlight-color: transparent;
            -webkit-touch-callout: none;
        }

        html {
            font-size: 16px;
            -webkit-text-size-adjust: 100%;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            min-height: 100vh;
            padding: 15px;
            margin: 0;
            overflow-x: hidden;
            touch-action: manipulation; /* 改善触摸响应 */
        }

        /* 容器优化 */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 10px;
        }

        /* 头部优化 */
        .header {
            background: rgba(255, 255, 255, 0.98);
            color: #333;
            padding: 20px 25px;
            margin-bottom: 25px;
            border-radius: 16px;
            box-shadow: 0 6px 25px rgba(0, 0, 0, 0.15);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: nowrap; /* PAD上不换行 */
            gap: 20px;
            min-height: 80px;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 20px;
            flex: 1;
            min-width: 0; /* 允许缩小 */
        }

            .header-left h1 {
                margin: 0;
                display: flex;
                align-items: center;
                gap: 12px;
                font-size: 1.5rem;
                color: #2c3e50;
                white-space: nowrap;
            }

        .header-right {
            display: flex;
            align-items: center;
            gap: 20px;
            flex-shrink: 0;
        }

        .welcome-info {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            color: white;
            padding: 15px 25px;
            border-radius: 12px;
            font-size: 0.95rem;
            min-width: 280px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

            .welcome-info strong {
                display: block;
                font-size: 1.1rem;
                margin-bottom: 5px;
                font-weight: 600;
            }

            .welcome-info span {
                opacity: 0.9;
                font-size: 0.9rem;
            }

        /* 功能区域优化 */
        .function-area {
            background: rgba(255, 255, 255, 0.98);
            padding: 30px;
            border-radius: 16px;
            margin-bottom: 25px;
            box-shadow: 0 6px 25px rgba(0, 0, 0, 0.15);
        }

            .function-area h2 {
                color: #2c3e50;
                margin-bottom: 30px;
                display: flex;
                align-items: center;
                gap: 12px;
                padding-bottom: 18px;
                border-bottom: 3px solid #f0f0f0;
                font-size: 1.4rem;
            }

        /* 单列按钮容器 */
        .single-column-buttons {
            display: flex;
            flex-direction: column;
            gap: 25px;
            width: 100%;
            align-items: center;
        }

        /* 配置按钮样式 - 保持与Index.cshtml的按钮一致 */
        .config-btn {
            background: white;
            border: 2px solid #e0e0e0;
            border-radius: 14px;
            padding: 25px 20px;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: #333;
            text-decoration: none;
            width: 100%;
            max-width: 600px;
            min-height: 180px;
            -webkit-user-select: none;
            user-select: none;
            touch-action: manipulation;
            position: relative;
            overflow: hidden;
        }

            /* 按钮点击效果 */
            .config-btn:active {
                transform: translateY(2px) scale(0.98);
                transition: transform 0.1s;
            }

            .config-btn:hover {
                transform: translateY(-5px);
                box-shadow: 0 12px 30px rgba(0, 0, 0, 0.2);
                border-color: var(--primary-color);
                background: linear-gradient(135deg, #f8f9ff 0%, #f5f7ff 100%);
            }

        /* 触摸设备优化 */
        @@media (hover: none) {
            .config-btn:hover {
                transform: none;
                box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
            }
        }

        .config-icon {
            font-size: 2.5rem;
            margin-bottom: 20px;
            transition: transform 0.3s ease;
            height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .config-btn:hover .config-icon {
            transform: scale(1.15);
        }

        .config-title {
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 8px;
            color: #2c3e50;
            line-height: 1.3;
        }

        .config-desc {
            font-size: 0.85rem;
            color: #666;
            line-height: 1.4;
            opacity: 0.85;
            max-width: 90%;
        }

        /* 按钮颜色系统 - 为配置功能设置新的颜色 */
        .btn-site {
            border-color: var(--purple-color);
        }

            .btn-site .config-icon {
                color: var(--purple-color);
            }

        .btn-permission {
            border-color: var(--teal-color);
        }

            .btn-permission .config-icon {
                color: var(--teal-color);
            }

        .btn-database {
            border-color: var(--orange-color);
        }

            .btn-database .config-icon {
                color: var(--orange-color);
            }

        /* 用户信息区域 */
        .user-info {
            background: rgba(255, 255, 255, 0.98);
            padding: 30px;
            border-radius: 16px;
            margin-bottom: 25px;
            box-shadow: 0 6px 25px rgba(0, 0, 0, 0.15);
        }

            .user-info h2 {
                color: #2c3e50;
                margin-bottom: 25px;
                display: flex;
                align-items: center;
                gap: 12px;
                font-size: 1.4rem;
            }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
            gap: 20px;
            margin: 25px 0;
        }

        .info-card {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            padding: 20px;
            border-radius: 12px;
            border-left: 5px solid var(--primary-color);
            transition: transform 0.2s ease;
            min-height: 80px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .info-card:hover {
                transform: translateY(-3px);
            }

            .info-card strong {
                display: block;
                color: #333;
                margin-bottom: 8px;
                font-size: 0.95rem;
                font-weight: 600;
            }

            .info-card span {
                color: #555;
                font-size: 1rem;
                font-weight: 500;
                word-break: break-word;
            }

        .login-time {
            font-family: 'Courier New', monospace;
            background: #2c3e50;
            color: white;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 0.9rem;
            font-weight: 500;
            display: inline-block;
        }

        /* 安全提示 */
        .security-notice {
            background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
            border: 1px solid #ffd166;
            border-radius: 12px;
            padding: 20px;
            margin: 25px 0;
            font-size: 0.95rem;
            color: #856404;
            display: flex;
            align-items: flex-start;
            gap: 15px;
        }

            .security-notice i {
                color: #ff9800;
                font-size: 1.2rem;
                margin-top: 2px;
                flex-shrink: 0;
            }

        /* 返回按钮优化 - 与Index.cshtml的登出按钮保持一致 */
        .btn-back {
            padding: 12px 24px;
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            color: white;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            font-size: 1rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
            min-width: 120px;
            justify-content: center;
            margin-top: 20px;
        }

            .btn-back:hover {
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
            }

            .btn-back:active {
                transform: translateY(1px);
            }

        /* 响应式设计优化 */
        @@media (max-width: 1024px) {
            /* PAD横屏 */
            .config-btn {
                max-width: 500px;
            }

            .header {
                flex-wrap: wrap;
            }

            .welcome-info {
                min-width: 200px;
            }
        }

        @@media (max-width: 768px) {
            /* PAD竖屏 */
            .header {
                flex-direction: column;
                text-align: center;
                padding: 20px;
            }

            .header-left, .header-right {
                width: 100%;
                justify-content: center;
                flex-wrap: wrap;
            }

            .welcome-info {
                min-width: 100%;
            }

            .info-grid {
                grid-template-columns: 1fr;
            }

            .security-notice {
                flex-direction: column;
                text-align: center;
                gap: 10px;
            }

            .config-btn {
                max-width: 100%;
            }
        }

        @@media (max-width: 480px) {
            /* 手机 */
            body {
                padding: 10px;
            }

            .container {
                padding: 0 5px;
            }

            .function-area, .user-info {
                padding: 20px;
            }

            .config-btn {
                padding: 20px 15px;
                min-height: 160px;
            }

            .config-icon {
                font-size: 2rem;
                margin-bottom: 15px;
                height: 50px;
            }
        }

        /* 横向模式优化 */
        @@media (orientation: landscape) and (max-height: 600px) {
            .header {
                padding: 15px 20px;
                min-height: 70px;
            }

            .config-btn {
                padding: 20px 15px;
                min-height: 160px;
            }

            .config-icon {
                font-size: 2rem;
                margin-bottom: 15px;
                height: 50px;
            }
        }

        /* 高分辨率屏幕优化 */
        @@media (min-resolution: 2dppx) {
            .config-btn {
                border-width: 1.5px;
            }

            .info-card {
                border-left-width: 3px;
            }
        }

        /* 黑暗模式支持 */
        @@media (prefers-color-scheme: dark) {
            .function-area,
            .user-info,
            .header {
                background: rgba(30, 30, 40, 0.95);
                color: #f0f0f0;
            }

                .function-area h2,
                .user-info h2,
                .header-left h1,
                .config-title {
                    color: #f0f0f0;
                }

            .config-desc {
                color: #b0b0b0;
            }

            .info-card {
                background: linear-gradient(135deg, #2d3748 0%, #4a5568 100%);
            }

                .info-card strong {
                    color: #f0f0f0;
                }

                .info-card span {
                    color: #d0d0d0;
                }
        }

        /* 打印样式 */
        @@media print {
            body {
                background: white;
            }

            .config-btn {
                border: 1px solid #ccc;
                break-inside: avoid;
            }
        }
    </style>
</head>
<body>
    <!-- 公共组件：认证消息提示 -->
    <div id="authMessage" class="auth-message">
        <i class="fas fa-exclamation-triangle"></i>
        <span id="authMessageText"></span>
    </div>

    <!-- 公共组件：Session过期模态框 -->
    <div id="sessionExpiredModal" class="session-expired-modal">
        <div class="session-modal-content">
            <h3><i class="fas fa-user-clock"></i> <span id="sessionExpiredTitle">@GetText("Home", "SessionExpiredTitle")</span></h3>
            <p id="sessionExpiredMessage">@GetText("Home", "SessionExpiredMessage")</p>
            <p id="sessionReloginMessage">@GetText("Home", "SessionReloginMessage")</p>
            <button id="reloginBtn">@GetText("Home", "ReloginButton")</button>
        </div>
    </div>

    <!-- 页面特定内容 -->
    <div class="container">
        <!-- 顶部导航栏 -->
        <div class="header">
            <div class="header-left">
                <h1><i class="fas fa-sliders-h"></i> @GetText("Config", "Title")</h1>

               
            </div>
            <div class="header-right">
                <!-- 返回首页按钮 -->
                <button id="backHomeBtn" class="btn-back">
                    <i class="fas fa-arrow-left"></i> @GetText("Config", "BackToHome")
                </button>
            </div>
        </div>

        <!-- 配置功能区域 -->
        <div class="function-area">
            <h2><i class="fas fa-cogs"></i> @GetText("Config", "ConfigFunctions")</h2>
            <div class="single-column-buttons">
                <!-- 站点管理按钮 -->
                <button class="config-btn btn-site" id="btnSiteManagement">
                    <div class="config-icon">
                        <i class="fas fa-building"></i>
                    </div>
                    <div class="config-title">@GetText("Config", "SiteManagement")</div>
                    <div class="config-desc">@GetText("Config", "SiteManagementDesc")</div>
                </button>

                <!-- 菜单权限配置按钮 -->
                <button class="config-btn btn-permission" id="btnMenuPermission">
                    <div class="config-icon">
                        <i class="fas fa-list-alt"></i>
                    </div>
                    <div class="config-title">@GetText("Config", "MenuPermission")</div>
                    <div class="config-desc">@GetText("Config", "MenuPermissionDesc")</div>
                </button>

                <!-- 语言配置按钮 -->
                <button class="config-btn btn-permission" id="btnLanguage">
                    <div class="config-icon">
                        <i class="fas fa-list-alt"></i>
                    </div>
                    <div class="config-title">@GetText("Config", "LanguageConfig")</div>
                    <div class="config-desc">@GetText("Config", "LanguageConfigDesc")</div>
                </button>

                <!-- 数据库连接配置按钮 -->
                <button class="config-btn btn-database" id="btnDatabaseConfig">
                    <div class="config-icon">
                        <i class="fas fa-database"></i>
                    </div>
                    <div class="config-title">@GetText("Config", "DatabaseConfig")</div>
                    <div class="config-desc">@GetText("Config", "DatabaseConfigDesc")</div>
                </button>
            </div>
        </div>

     

    <!-- 引入公共的Session管理器 -->
    <script src="~/js/sweetalert.js" asp-append-version="true"></script>
    <script src="~/js/session-manager.js" asp-append-version="true"></script>

    <!-- 页面特定的JavaScript -->
    <script>
        // 统一恢复所有配置按钮到初始状态（解决 bfcache/返回页面时按钮仍显示"加载中..."的问题）
        function restoreConfigButtons(buttons) {
            if (!buttons) return;
            buttons.forEach(btn => {
                if (btn.dataset.originalContent) {
                    btn.innerHTML = btn.dataset.originalContent;
                }
                btn.classList.remove('touch-active');
                btn.style.pointerEvents = 'auto';
                btn.style.opacity = '';
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            // 获取当前语言
            const currentLanguage = '@culture.Name';
            const configButtons = Array.from(document.querySelectorAll('.config-btn'));

            // 配置按钮处理：在绑定点击事件前先保存原始内容
            configButtons.forEach(btn => {
                btn.dataset.originalContent = btn.innerHTML;
                btn.style.pointerEvents = 'auto';

                // 添加触摸设备优化
                btn.addEventListener('touchstart', function(e) {
                    this.classList.add('touch-active');
                }, { passive: true });

                btn.addEventListener('touchend', function(e) {
                    this.classList.remove('touch-active');
                }, { passive: true });

                btn.addEventListener('touchcancel', function(e) {
                    this.classList.remove('touch-active');
                }, { passive: true });

                // 点击事件处理
                btn.addEventListener('click', async function(e) {
                    e.preventDefault();
                    e.stopPropagation();

                    const btnId = this.id;
                    const btnTitleEl = this.querySelector('.config-title');
                    const btnText = btnTitleEl ? btnTitleEl.textContent : '';

                    // 检查Session状态
                    try {
                        if (window.SessionManager && typeof window.SessionManager.manualCheckSession === 'function') {
                            const isAuthenticated = await window.SessionManager.manualCheckSession();

                            if (!isAuthenticated) {
                                const message = @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Home", "AuthRequired")));
                                if (window.SessionManager.showAuthMessage) {
                                    window.SessionManager.showAuthMessage(message);
                                } else {
                                    Swal.fire({ icon: 'warning', text: message, timer: 3000, timerProgressBar: true });
                                }
                                return;
                            }
                        }
                    } catch (error) {
                        console.error('检查Session时出错:', error);
                    }

                    // 根据按钮ID执行相应功能
                    const routeMap = {
                        'btnSiteManagement': '/Factory/Index',
                        'btnMenuPermission': '/UserMenuPermission/Index',
                        'btnLanguage': '/Language/Index',
                        'btnDatabaseConfig': '/Config/Index'
                    };

                    const route = routeMap[btnId];
                    if (route) {
                        // 显示加载提示
                        const loadingText = '<div class="config-icon"><i class="fas fa-spinner fa-spin"></i></div><div class="config-title">' + @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Common", "Loading"))) + '</div>';

                        this.dataset.previousPointerEvents = this.style.pointerEvents || '';
                        this.innerHTML = loadingText;
                        this.style.pointerEvents = 'none';

                        setTimeout(() => { window.location.href = route; }, 500);
                    } else {
                        const message = @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Config", "FeatureUnderDevelopment")));
                        Swal.fire({ icon: 'warning', text: message, timer: 3000, timerProgressBar: true });
                    }
                });
            });

            // 返回首页按钮处理
            document.getElementById('backHomeBtn').addEventListener('click', function() {
                window.location.href = '/Home/Index';
            });

            // 键盘快捷键支持
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    e.preventDefault();
                    window.location.href = '/Home/Index';
                }
                if (e.altKey && e.key === '1') {
                    document.getElementById('btnSiteManagement').click();
                }
                if (e.altKey && e.key === '2') {
                    document.getElementById('btnMenuPermission').click();
                }
                if (e.altKey && e.key === '3') {
                    document.getElementById('btnDatabaseConfig').click();
                }
                if (e.key === 'F5') {
                    e.preventDefault();
                    location.reload();
                }
            });

            // 防止双击缩放
            let lastTap = 0;
            document.addEventListener('touchend', function(e) {
                const currentTime = new Date().getTime();
                const tapLength = currentTime - lastTap;
                if (tapLength < 500 && tapLength > 0) {
                    e.preventDefault();
                }
                lastTap = currentTime;
            }, false);

            // 绑定多事件一次性恢复按钮状态，避免 bfcache 或返回页面时按钮仍显示"加载中..."
            ['pageshow', 'popstate', 'visibilitychange', 'focus'].forEach(evt => {
                window.addEventListener(evt, () => restoreConfigButtons(configButtons));
            });

            // 初始与延时兜底
            restoreConfigButtons(configButtons);
            setTimeout(() => restoreConfigButtons(configButtons), 300);
        });

        // 全局错误处理：确保按钮可恢复
        window.addEventListener('error', function () {
            const buttons = document.querySelectorAll('.config-btn');
            restoreConfigButtons(buttons);
        });
    </script>
</body>
</html>