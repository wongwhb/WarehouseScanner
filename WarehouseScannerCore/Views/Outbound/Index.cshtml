        function sortTable(sortKey) {
            if (!currentOrderData || currentOrderData.length === 0) return;

            if (currentSortKey === sortKey) {
                currentSortOrder = currentSortOrder === 'asc' ? 'desc' : 'asc';
            } else {
                currentSortKey = sortKey;
                currentSortOrder = 'asc';
            }

            updateSortHeaderStyle();

            // —— 用 slice() 浅拷贝即可，无需 JSON.parse(JSON.stringify) 深拷贝。
            //    currentOrderData 元素为普通对象，sort 比较不修改对象属性，浅拷贝足以隔离原数组顺序。
            var sortedData = currentOrderData.slice();
            sortedData.sort(function (a, b) {
                var valA, valB;
                switch (sortKey) {
                    case 'reqDate':
                        valA = a.customerReqDate || '';
                        valB = b.customerReqDate || '';
                        break;
                    case 'customerCode':
                        valA = a.custNum || '';
                        valB = b.custNum || '';
                        break;
                    case 'customerName':
                        valA = a.custName || '';
                        valB = b.custName || '';
                        break;
                    case 'po':
                        valA = a.po || '';
                        valB = b.po || '';
                        break;
                    case 'order':
                        valA = a.order || '';
                        valB = b.order || '';
                        break;
                    default:
                        return 0;
                }

                if (sortKey === 'reqDate') {
                    var dateA = parseDate(valA);
                    var dateB = parseDate(valB);
                    if (dateA && dateB) {
                        return currentSortOrder === 'asc' ? dateA - dateB : dateB - dateA;
                    }
                }

                var strA = String(valA).toLowerCase();
                var strB = String(valB).toLowerCase();
                if (currentSortOrder === 'asc') {
                    return strA.localeCompare(strB);
                } else {
                    return strB.localeCompare(strA);
                }
            });

            // 关键点：render 使用数组下标作为 data-index，后续行点击、勾选都通过 __getOrderByIndex 回查 currentOrderData。
            // 因此排序后必须把 currentOrderData 也更新为排序后的数组，否则会出现"点了 A 行，回填的却是 B 行"的错位。
            currentOrderData = sortedData;
            renderOrdersTableBody(currentOrderData);
            $('#ordersTableWrapper').scrollTop(0);
        }

        function parseDate(dateStr) {
            if (!dateStr) return null;
            var date = new Date(dateStr);
            if (!isNaN(date.getTime())) return date;
            var parts = dateStr.split(/[-/]/);
            if (parts.length === 3) {
                if (parts[0].length === 4) {
                    return new Date(parts[0], parts[1] - 1, parts[2]);
                } else {
                    return new Date(parts[2], parts[0] - 1, parts[1]);
                }
            }
            return null;
        }

        function updateSortHeaderStyle() {
            $('#ordersTable thead th.sortable').removeClass('sort-asc sort-desc');
            if (currentSortKey) {
                var $th = $('#ordersTable thead th[data-sort-key="' + currentSortKey + '"]');
                if (currentSortOrder === 'asc') {
                    $th.addClass('sort-asc');
                } else {
                    $th.addClass('sort-desc');
                }
            }
        }

        // ============= 扫码发货公共辅助 =============
        // trySplitPoRel 由 BarcodeParser.splitPoRel 静态方法提供（双页复用），本页直接调用。

        /**
         * 从原始扫码字符串判断属于哪种条码：
         * - "PART:" + "PO:" → PART+PO 模式（PO 值拆三段 → PONum/OrderLine/OrderRelNum）
         * 返回 { mode: 'po'|'poInvalid'|'none', payload:{...} }
         */
        function buildShippingSchedulePayload(rawInput, parsed) {
            var d = (parsed && parsed.data) ? parsed.data : {};
            var raw = (rawInput || '').toString();

            // 键检测改用 BarcodeParser 键组常量构造（消除第三份手写键清单，与解析器单一事实来源）
            var hasPartKey  = BarcodeParser.buildKeyPattern(BarcodeParser.PART_KEY_ALIASES).test(raw);
            var hasPoKey    = BarcodeParser.buildKeyPattern(BarcodeParser.PO_KEY_ALIASES).test(raw);

            var hasMaterial    = !!d.materialCode;
            var hasWorkOrderNo = !!d.workOrderNo;

            // 判定顺序：PART+PO → none
            if (hasPartKey && hasPoKey && hasMaterial && hasWorkOrderNo) {
                var split = BarcodeParser.splitPoRel(d.workOrderNo);
                if (split.ok) {
                    return {
                        mode: 'po',
                        payload: {
                            PartNum: d.materialCode || '',
                            PONum: split.poNum,
                            OrderLine: split.orderLine,
                            OrderRelNum: split.orderRelNum
                        }
                    };
                }
                // B4：PART+PO 条码但 PO 值不是"号-行-批"三段格式 → 明确失败，
                // 不静默降级到非条码路径（否则用户扫码后无任何反馈）。
                return { mode: 'poInvalid', payload: {} };
            }

            return { mode: 'none', payload: {} };
        }

        /** 把 QueryShippingSchedule 的成功响应回填到对应栏位 */
        function applyShippingScheduleResponse(resp) {
            if (!resp || !resp.success) return;
            $('#salesOrderNo').val(resp.orderNum || '');
            $('#salesOrderLineNo').val(resp.orderLine || '');
            $('#orderRelNum').val(resp.orderRelNum || '');

            // 批次号/库位填充逻辑：
            // 1) 库存仅一条 → 自动填充批号/仓库/库位/单位；
            // 2) 库存多条   → 不自动填充（清空批号/库位），全部以单选框显示，必须手工选择；
            // 3) 无库存列表 → 回退为工单号，仓库/库位/单位用后端默认值
            var lots = resp.lotList || [];
            if (lots.length === 1) {
                $('#batchNo').val(lots[0].lotNum || '');
                if (lots[0].warehouseCode) $('#warehouseCode').val(lots[0].warehouseCode);
                if (lots[0].binNum) $('#location').val(lots[0].binNum);
                if (lots[0].unit) $('#unit').val(lots[0].unit);
                $('#lotRadioList').empty().hide();
            } else if (lots.length > 1) {
                $('#batchNo').val('');
                $('#location').val('');
                renderLotRadioButtons(lots);
            } else {
                $('#batchNo').val(resp.jobNum || '');
                if (resp.unit) $('#unit').val(resp.unit);
                if (resp.warehouseCode) $('#warehouseCode').val(resp.warehouseCode);
                if (resp.binNum) $('#location').val(resp.binNum);
                $('#lotRadioList').empty().hide();
            }
            // 单位默认取后端返回值（多条库存选中批号后会被覆盖更新），避免扫码校验时单位为空
            if (resp.unit) $('#unit').val(resp.unit);
            // 记录计划出货数量与已发货数量，供后续校验与显示使用
            currentPlanShipQty = parseFloat(resp.planShipQty) || 0;
            currentShippedQty = parseFloat(resp.shippedQty) || 0;
            currentStockQty = 0;  // 新发货计划意味着旧库存数失效，避免与下一单的计划/已发货混显
        }

        /** 统一封装 QueryShippingSchedule AJAX 调用 + 成功回填 + 失败清空订单字段
         *  —— 相同 payload（JSON 排序后拼接为 key）的进行中请求复用，避免重复触发 Epicor。
         */
        async function queryShippingSchedule(payload) {
            try {
                // 将 payload 序列化为稳定字符串作为 key（对象键顺序不固定时 JSON.stringify 差异很小，此处按用户实际参数基本固定，不会错）
                var key = 'qss:' + JSON.stringify(payload);
                var resp = await __useInFlight(key, function () {
                    return $.ajax({
                        url: '/Outbound/QueryShippingSchedule',
                        type: 'POST',
                        contentType: 'application/json',
                        headers: __csrfHeader(),
                        data: JSON.stringify(payload)
                    });
                });
                if (resp && resp.success) {
                    applyShippingScheduleResponse(resp);
                    return true;
                }
                if (resp && handleSessionIfExpired(resp.message)) return false;
                showMessage(resp?.message || localTexts.shippingScheduleNotFoundSimple, 'warning');
                // 未找到发货计划 → 清空所有输入框（保留 packId），聚焦工单号/订单号输入框
                if (resp && resp.code === 'ShippingScheduleNotFound') {
                    clearAllFieldsExceptPackId();
                    $('#salesOrderNo').focus().select();
                } else {
                    // 其他失败：清空物料编号与发货数量
                    if (resp && resp.code === 'NoAvailableInventory') {
                        $('#materialCode, #quantity').val('');
                    }
                    $('#salesOrderNo, #salesOrderLineNo, #orderRelNum').val('');
                }
                return false;
            } catch (xhr) {
                if (isSessionFailureXhr(xhr)) {
                    handleSessionIfExpired(localTexts.sessionExpiredText);
                } else {
                    showMessage(localTexts.queryShippingScheduleFailed, 'error');
                }
                $('#salesOrderNo, #salesOrderLineNo, #orderRelNum').val('');
                return false;
            }
        }

        /** 将日期字符串格式化为 mm/dd/yyyy（避免 UTC 时区偏移） */
        function formatLotDate(dateStr) {
            if (!dateStr) return '';
            // 匹配 yyyy-MM-dd 或 yyyy/MM/dd 格式，直接重组避免 new Date 时区问题
            var m = dateStr.match(/(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/);
            if (m) {
                return m[2].padStart(2, '0') + '/' + m[3].padStart(2, '0') + '/' + m[1];
            }
            // 回退：尝试 Date 对象解析
            var d = new Date(dateStr);
            if (!isNaN(d.getTime())) {
                return String(d.getMonth() + 1).padStart(2, '0') + '/' +
                    String(d.getDate()).padStart(2, '0') + '/' + d.getFullYear();
            }
            return dateStr;
        }

        /** 渲染批号单选框（多条库存时不自动填充，全部列出供手工选择；格式：批号(库位;日期：mm/dd/yyyy)） */
        function renderLotRadioButtons(lotList) {
            var $container = $('#lotRadioList');
            $container.empty();

            if (!lotList || lotList.length <= 1) {
                $container.hide();
                return;
            }

            // 全部批号以单选框显示（格式：批号(库位;日期：mm/dd/yyyy)）
            for (var i = 0; i < lotList.length; i++) {
                var lot = lotList[i];
                var formattedDate = formatLotDate(lot.firstRefDate);
                var displayText = lot.lotNum + '(' + (lot.binNum || '') +
                    (formattedDate ? ';' + localTexts.lotDateLabel + formattedDate : '') + ')';
                var $label = $('<label class="lot-radio-label">' +
                    '<input type="radio" name="lotSelect" value="' + i + '"> ' +
                    '<span>' + displayText + '</span></label>');
                $container.append($label);
            }
            $container.show();

            // 选中某个批号时同步回填批号/仓库/库位/单位（格式：批号(库位;日期：mm/dd/yyyy)）
            $container.find('input[name="lotSelect"]').on('change', function () {
                $container.find('.lot-radio-label').removeClass('checked');
                $(this).closest('.lot-radio-label').addClass('checked');
                var idx = parseInt($(this).val());
                var lot = lotList[idx];
                if (lot) {
                    // 点击批号：把该库存行的 仓库代码 / 库位 / 批次号 解析到对应文本框
                    $('#batchNo').val(lot.lotNum || '');
                    $('#warehouseCode').val(lot.warehouseCode || '');
                    $('#location').val(lot.binNum || '');
                    if (lot.unit) $('#unit').val(lot.unit);
                }
                // 按所选批号（物料+仓库+库位+批次）查询库存并刷新"库存数"显示
                validateInventory();
            });
        }

        /** 物料校验失败后的统一兜底：调 validateInventory → 按结果跳焦点或清空 */
        async function focusAfterMaterialValidation() {
            var valid = await validateInventory();
            if (valid) {
                var batchNo = $('#batchNo').val().trim();
                setTimeout(function() {
                    (batchNo ? $('#quantity') : $('#batchNo')).focus().select();
                }, 100);
            } else {
                clearMaterialFields();
                hideOrderQtyInfo();  // 重置计划出货/已发货/库存数，避免下次扫码使用旧值
                $('#materialCode').focus();
            }
        }

        async function handleSalesOrderEnter() {
            var inputVal = $('#salesOrderNo').val().trim();
            if (!inputVal) {
                showMessage(localTexts.salesOrderRequired, 'warning');
                $('#salesOrderNo').focus();
                return;
            }

            if (barcodeParser) {
                try {
                    var result = barcodeParser.parse(inputVal);
                    var d = result.data || {};
                    var hasSalesOrder = !!d.salesOrder;
                    var hasOrderLine = !!d.orderLine;

                    // 需求 ①：扫码阶段只填物料编号 & 数量；单位与批次号不解析回填
                    if (result.success) {
                        if (d.materialCode)  $('#materialCode').val(d.materialCode);
                        if (d.quantity)      $('#quantity').val(d.quantity);
                        if (d.warehouseCode) $('#warehouseCode').val(d.warehouseCode);
                        if (d.binNum)        $('#location').val(d.binNum);
                    }

                    // === PART+PO 条码 → 查发货计划 ===
                    if (result.success && (d.workOrderNo || d.materialCode)) {
                        var build = buildShippingSchedulePayload(inputVal, result);
                        // B4：PART+PO 条码但 PO 值不是"号-行-批"三段格式 → 明确提示并终止降级链
                        if (build.mode === 'poInvalid') {
                            showToast(localTexts.poBarcodeFormatHint, 'warning');
                            return;
                        }
                        if (build.mode === 'po') {
                            $('#salesOrderNo').val(d.workOrderNo || '');
                            showToast(localTexts.queryingShippingSchedule, 'info');
                            var ok = await queryShippingSchedule(build.payload);
                            if (ok) {
                                var valid = await validateOrder();
                                // validateOrder 返回 false 时不隐藏信息行：超量场景已弹窗并保留显示（未出货: 0），
                                // 其余失败场景（订单无效/接口异常/缺单号）validateOrder 内部已自行 hideOrderQtyInfo
                                if (valid) {
                                    // 订单验证通过后，最后一步：料号库存验证（校验仓库/库位/批次库存是否充足）
                                    var invValid = await validateInventory();
                                    if (invValid) {
                                        setTimeout(function() { $('#warehouseCode').focus().select(); }, 100);
                                    } else {
                                        clearMaterialFields();
                                        hideOrderQtyInfo();
                                        $('#materialCode').focus();
                                    }
                                }
                            } else {
                                $('#salesOrderNo').focus();
                            }
                            return;
                        }
                    }

                    // === 销售订单条码 ===
                    if (result.success && (result.type === 'order' || (hasSalesOrder && hasOrderLine))) {
                        $('#salesOrderNo').val(d.salesOrder || '');
                        $('#salesOrderLineNo').val(d.orderLine || '');
                        if (d.orderRelNum) $('#orderRelNum').val(d.orderRelNum);
                        var valid2 = await validateOrder();
                        if (valid2) {
                            $('#materialCode').focus().select();
                        } else {
                            $('#salesOrderNo, #salesOrderLineNo, #orderRelNum').val('');
                            $('#salesOrderNo').focus();
                        }
                        return;
                    }
                } catch (e) { }
            }

            // 非条码格式，跳转到行号字段
            $('#salesOrderLineNo').focus().select();
        }

        async function handleMaterialCodeEnter() {
            var inputVal = $('#materialCode').val().trim();
            if (!inputVal) {
                showMessage(localTexts.materialCodeRequired, 'warning');
                $('#materialCode').focus();
                return;
            }

            if (barcodeParser) {
                try {
                    var result = barcodeParser.parse(inputVal);
                    if (result.success && (result.type === 'material' || result.data.materialCode)) {
                        var data = result.data;
                        var hasWorkOrder = !!data.workOrderNo;
                        var hasMaterial = !!data.materialCode;
                        var hasSalesOrder = !!$('#salesOrderNo').val().trim();

                        // 需求 ①：扫码阶段只填物料编号 & 数量；单位与批次号不解析回填
                        $('#materialCode').val(data.materialCode || '');
                        $('#quantity').val(data.quantity || '');
                        $('#warehouseCode').val(data.warehouseCode || '');
                        $('#location').val(data.binNum || '');

                        // PART+PO 条码且销售订单未填 → 查发货计划
                        if (hasWorkOrder && hasMaterial && !hasSalesOrder) {
                            var build = buildShippingSchedulePayload(inputVal, result);
                            // B4：PART+PO 条码但 PO 值不是"号-行-批"三段格式 → 明确提示并终止降级链
                            if (build.mode === 'poInvalid') {
                                showToast(localTexts.poBarcodeFormatHint, 'warning');
                                return;
                            }
                            if (build.mode === 'po') {
                                $('#salesOrderNo').val(data.workOrderNo || '');
                                showToast(localTexts.queryingShippingSchedule, 'info');
                                var ok = await queryShippingSchedule(build.payload);
                                if (ok) {
                                    var valid = await validateOrder();
                                    // validateOrder 返回 false 时不隐藏信息行：超量场景已弹窗并保留显示（未出货: 0），
                                    // 其余失败场景（订单无效/接口异常/缺单号）validateOrder 内部已自行 hideOrderQtyInfo
                                    if (valid) {
                                        // 订单验证通过后，最后一步：料号库存验证（校验仓库/库位/批次库存是否充足）
                                        var invValid = await validateInventory();
                                        if (invValid) {
                                            setTimeout(function() { $('#warehouseCode').focus().select(); }, 100);
                                        } else {
                                            clearMaterialFields();
                                            hideOrderQtyInfo();  // 重置计划/包装数量，避免下次扫码使用旧值
                                            $('#materialCode').focus();
                                        }
                                    }
                                } else {
                                    // 查询失败 → 走库存校验兜底
                                    await focusAfterMaterialValidation();
                                }
                                return;
                            }
                        }

                        // 条码不含仓库/库位信息时（如 PartNum:xxx;Qty:1;UOM:PCS;LotNum:xxx），
                        // 填充全部字段（含单位/批次），跳过库存校验，聚焦仓库字段供用户手动录入
                        if (!data.warehouseCode && !data.binNum) {
                            if (data.unit) $('#unit').val(data.unit);
                            if (data.lotNum) $('#batchNo').val(data.lotNum);
                            setTimeout(function() { $('#warehouseCode').focus().select(); }, 100);
                            return;
                        }

                        // 普通物料条码 → 直接库存校验
                        await focusAfterMaterialValidation();
                        return;
                    }
                } catch (e) { }
            }

            // 非条码 → 直接库存校验
            await focusAfterMaterialValidation();
        }

        // 隐藏并清空出货数量信息（红色单行显示）
        function hideOrderQtyInfo() {
            $('#dispOrderQtyInfoLine').text('');
            currentPlanShipQty = 0;
            currentShippedQty = 0;
            currentStockQty = 0;
            $('#orderQtyInfoDisplay').hide();
        }

        /** 数量格式化：去掉浮点尾巴（如 6.0000000001 → 6），最多保留 2 位小数 */
        function fmtQty(v) {
            var n = parseFloat(v) || 0;
            return (Math.round(n * 100) / 100).toString();
        }

        /**
         * 生成出货数量信息整行文案：模板取自语言资源 OrderQtyInfoFormat（中英文）
         * 占位符：{0}=计划出货 {1}=已发货数量 {2}=未出货 {3}=库存数
         */
        function formatOrderQtyInfoLine(planShipQty, shippedQty, unshippedQty, stockQty) {
            var fmt = $('#orderQtyInfoDisplay').data('format') || '';
            if (!fmt) return '';

            return fmt.replace('{0}', fmtQty(planShipQty)).replace('{1}', fmtQty(shippedQty))
                .replace('{2}', fmtQty(unshippedQty)).replace('{3}', fmtQty(stockQty));
        }

        // 刷新出货数量信息显示：计划出货数量 / 已发货数量 / 未出货数量 / 库存数
        // 扫码数量 = 前端发货数量(输入框)（DB 累计 ScanQty 已随本地 ShippingSchedule 表路径一并移除，恒为 0）
        // 未出货数量 = 计划出货数量 - 已发货数量 - 扫码数量（小于 0 时取 0）
        // 库存数 = 所选批号的库存数（ValidateInventory 返回）
        function refreshOrderQtyInfo() {
            var planShipQty = parseFloat(currentPlanShipQty) || 0;
            var shippedQty = parseFloat(currentShippedQty) || 0;
            var stockQty = parseFloat(currentStockQty) || 0;
            var inputQty = parseFloat($('#quantity').val()) || 0;
            var totalScanQty = inputQty;
            var diff = planShipQty - shippedQty - totalScanQty;
            var unshippedQty = diff > 0 ? diff : 0;
            $('#dispOrderQtyInfoLine').text(formatOrderQtyInfoLine(planShipQty, shippedQty, unshippedQty, stockQty));
            $('#orderQtyInfoDisplay').show();
        }

        async function validateOrder() {
            var orderNo = $('#salesOrderNo').val().trim();
            var orderLine = $('#salesOrderLineNo').val().trim();
            var orderRelNum = $('#orderRelNum').val().trim();

            if (!orderNo || !orderLine) {
                hideOrderQtyInfo();
                showMessage(localTexts.orderAndLineRequired, 'error');
                return false;
            }

            if (!orderRelNum) {
                showMessage(localTexts.orderRelNumRequired, 'warning');
                $('#orderRelNum').focus();
                return false;
            }

            try {
                // —— 相同 (订单号,行号,发货行号) 正在进行中的验证，复用同一次 Promise（用户点击 checkbox + 跳转 focus 触发 2 次 validateOrder 的常见场景合并）
                var key = __pKey('vo', [orderNo, orderLine, orderRelNum]);
                var response = await __useInFlight(key, function () {
                    return $.ajax({
                        url: '/Outbound/ValidateOrder',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            orderNum: orderNo,
                            orderLine: parseInt(orderLine),
                            orderRelNum: parseInt(orderRelNum)
                        }),
                        headers: __csrfHeader()
                    });
                });
                if (response.success) {
                    // 红色单行显示统一由 refreshOrderQtyInfo 渲染，避免在此重复一套相同计算
                    refreshOrderQtyInfo();

                    // 验证：扫码数量超过「计划出货 − 已发货数量」（即未出货数量）时提示，
                    // 与显示行的"未出货"口径保持一致
                    // 不清空表单，仅将发货数量重置为 0，保留其他输入供用户调整后重新提交
                    var planShipQty = parseFloat(currentPlanShipQty) || 0;
                    var shippedQty = parseFloat(currentShippedQty) || 0;
                    var inputQty = parseFloat($('#quantity').val()) || 0;
                    var allowedQty = planShipQty - shippedQty;
                    if (planShipQty > 0 && inputQty > allowedQty) {
                        showMessage(localTexts.quantityExceedsUnshippedQty.replace('{0}', fmtQty(inputQty)).replace('{1}', fmtQty(allowedQty > 0 ? allowedQty : 0)), 'error');
                        // 上面 response.success 时已用扫码数量渲染过信息行（未出货已被钳到 0），
                        // 这里别再调 refreshOrderQtyInfo()：数量重置为 0 后再刷会把未出货刷回正数，与提示矛盾
                        $('#quantity').val(0);
                        $('#quantity').focus().select();
                        return false;
                    }
                    return true;
                } else {
                    hideOrderQtyInfo();
                    if (handleSessionIfExpired(response.message)) return false;
                    showMessage(response.message || localTexts.orderValidationFailed, 'error');
                    return false;
                }
            } catch (error) {
                hideOrderQtyInfo();
                if (isSessionFailureXhr(error)) {
                    handleSessionIfExpired(localTexts.sessionExpiredText);
                } else {
                    showMessage(localTexts.networkError, 'error');
                }
                return false;
            }
        }

        async function validateInventory() {
            var orderNo = $('#salesOrderNo').val().trim();
            var orderLine = $('#salesOrderLineNo').val().trim();
            var orderRelNum = $('#orderRelNum').val().trim();
            var partNum = $('#materialCode').val().trim();
            var unit = $('#unit').val().trim();
            var whseCode = $('#warehouseCode').val().trim();
            var binNum = $('#location').val().trim();
            var lotNum = $('#batchNo').val().trim();
            var quantity = parseFloat($('#quantity').val()) || 0;

            if (!orderNo || !orderLine) {
                showMessage(localTexts.orderAndLineRequiredForInventory, 'error');
                return false;
            }
            if (!orderRelNum) {
                showMessage(localTexts.orderRelNumRequired, 'warning');
                $('#orderRelNum').focus();
                return false;
            }
            if (!partNum) {
                showMessage(localTexts.materialCodeRequiredMsg, 'error');
                return false;
            }
            try {
                // —— 相同参数的库存校验进行中 Promise 去重
                var key = __pKey('vi', [orderNo, orderLine, orderRelNum, partNum, unit, whseCode, binNum, lotNum, quantity]);
                var response = await __useInFlight(key, function () {
                    return $.ajax({
                        url: '/Outbound/ValidateInventory',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            orderNum: orderNo,
                            orderLine: parseInt(orderLine),
                            orderRelNum: parseInt(orderRelNum),
                            partNum: partNum,
                            Unit: unit,
                            whseCode: whseCode,
                            binNum: binNum,
                            lotNumber: lotNum
                        }),
                        headers: __csrfHeader()
                    });
                });
                if (response.success) {
                    // showMessage(response.message || localTexts.inventoryValidationPassed, 'success');
                    // 记录所选批号的库存数，并刷新"计划出货/已发货数量/未出货/库存数"显示
                    currentStockQty = parseFloat(response.availableQty) || 0;
                    refreshOrderQtyInfo();
                    return true;
                } else {
                    if (handleSessionIfExpired(response.message)) return false;
                    showMessage(response.message || localTexts.inventoryValidationFailed, 'error');
                    return false;
                }
            } catch (error) {
                // AJAX 网络错误（含 session 完全失效导致 302/401，或防伪令牌失效导致的 400）
                if (isSessionFailureXhr(error)) {
                    handleSessionIfExpired(localTexts.sessionExpiredText);
                } else {
                    showMessage(localTexts.networkError, 'error');
                }
                return false;
            }
        }

        function clearMaterialFields() {
            $('#materialCode, #quantity, #unit, #warehouseCode, #location, #batchNo').val('');
            $('#lotRadioList').empty().hide();
        }

        /**
         * 清空前端页面所有输入值，仅保留 packId
         * 同时清空错误提示、重置计划/已扫数量状态、隐藏出货数量信息
         */
        function clearAllFieldsExceptPackId() {
            $('#salesOrderNo, #salesOrderLineNo, #orderRelNum, ' +
            '#materialCode, #quantity, #unit, #warehouseCode, #location, #batchNo').val('');
            $('#salesOrderError, #salesOrderLineError, #orderRelNumError, ' +
            '#materialCodeError, #quantityError, #batchNoError').html('');
            $('#lotRadioList').empty().hide();
            hideOrderQtyInfo();
        }

        function validateForm() {
            var packId = $('#packId').val().trim();
            var salesOrder = $('#salesOrderNo').val().trim();
            var orderLine = $('#salesOrderLineNo').val().trim();
            var orderRelNum = $('#orderRelNum').val().trim();
            var materialCode = $('#materialCode').val().trim();
            var quantity = parseFloat($('#quantity').val());
            var batchNo = $('#batchNo').val().trim();

            // Pack ID 必填验证
            if (!packId) {
                $('#packIdError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.packIdRequired);
                $('#packId').focus();
                return false;
            }
            $('#packIdError').html('');

            if (!salesOrder) {
                $('#salesOrderError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.salesOrderRequired);
                return false;
            }
            $('#salesOrderError').html('');

            if (!orderLine) {
                $('#salesOrderLineError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.salesOrderLineRequired);
                return false;
            }
            $('#salesOrderLineError').html('');

            if (!orderRelNum) {
                $('#orderRelNumError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.orderRelNumRequired);
                return false;
            }
            $('#orderRelNumError').html('');

            if (!materialCode) {
                $('#materialCodeError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.materialCodeRequired);
                return false;
            }
            $('#materialCodeError').html('');

            if (!quantity || quantity <= 0) {
                $('#quantityError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.quantityRequired);
                return false;
            }
            $('#quantityError').html('');

            // 未出货数量 = 计划出货数量 - 已发货数量 - 已扫码数量（与红色显示行的未出货口径一致）
            // 已扫码数量已随本地 ShippingSchedule 表路径移除，恒为 0
            var planShipQty = parseFloat(currentPlanShipQty) || 0;
            var shippedQty = parseFloat(currentShippedQty) || 0;
            var unshippedQty = planShipQty - shippedQty;

            // 当未出货数量为 0（或小于 0）时，提示该订单已全部发货完成
            if (planShipQty > 0 && unshippedQty <= 0) {
                showSubmitError(localTexts.orderFullyShipped.replace('{0}', materialCode));
                return false;
            }

            // 扫码数量不能超过未出货数量（计划出货数量 - 已发货数量）
            // 不清空表单，仅将发货数量重置为 0，保留其他输入供用户调整后重新提交
            if (planShipQty > 0 && quantity > unshippedQty) {
                $('#quantityError').html('<i class="fas fa-exclamation-circle"></i> ' +
                    localTexts.quantityExceedsUnshippedQty.replace('{0}', fmtQty(quantity)).replace('{1}', fmtQty(unshippedQty)));
                $('#quantity').val(0);
                $('#quantity').focus().select();
                return false;
            }

            // 批号字段验证
            if (!batchNo) {
                $('#batchNoError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.batchNoRequired);
                return false;
            }
            $('#batchNoError').html('');

            return true;
        }

        function submitForm() {
            if (!validateForm()) return;

            // 本次是新的一次提交：清掉上一次的常驻错误提示，避免旧错误误导操作员
            clearSubmitError();

            var formData = $('#outboundForm').serialize();
            showToast(localTexts.submitting, 'info');

            $('#submitBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> ' + localTexts.submitting);

            $.ajax({
                url: $('#outboundForm').attr('action'),
                type: 'POST',
                data: formData,
                headers: { 'X-CSRF-TOKEN': $('input[name="__RequestVerificationToken"]').val(), 'X-Request-ID': getRequestId() },
                success: function (response) {
                    if (response.success) {
                        resetRequestId();
                        clearSubmitError();
                        if (response.data && response.data.quantityReduced) {
                            // 发货数量超过库存数量，已由后端自动调整为库存数量：弹出提示框告知操作员
                            Swal.fire({
                                icon: 'warning',
                                title: response.message || localTexts.submitSuccess,
                                confirmButtonText: localTexts.okButton
                            });
                        } else {
                            showToast(response.message || localTexts.submitSuccess, 'success');
                        }
                        // 清除物料相关字段
                        $('#materialCode, #quantity, #unit, #warehouseCode, #batchNo, #location, #remarks').val('');
                        $('#lotRadioList').empty().hide();
                        // 清除订单信息字段（销售订单号、行号、发货批次号）
                        $('#salesOrderNo, #salesOrderLineNo, #orderRelNum').val('');
                        // 清除出货数量信息（计划出货/扫码/未出货），提交发货后应清空
                        hideOrderQtyInfo();
                        $('.error-message').html('');
                        $('#salesOrderNo').focus();
                    } else {
                        // 后端业务失败：把后端产生的错误信息原样展示到页面
                        // （如 Epicor「无效仓库和库位」、「库位 01/3-1153 无可用库存」、「物料不匹配」等）
                        showSubmitError(response.message || localTexts.submitFailed);
                    }
                    resetSubmitButton();
                },
                error: function (xhr) {
                    // HTTP 层失败（500 / 400 / 会话失效等）：尽可能取出后端返回的错误文案
                    var errorMsg = extractServerError(xhr) || localTexts.submitFailed;
                    if (handleSessionIfExpired(errorMsg)) { resetSubmitButton(); return; }
                    // 会话/登录态失效（401/302，或防伪令牌失效时中间件返回的 errorCode）：
                    // 统一跳登录页，不要把 "HTTP 400" 这类技术性状态码当业务错误丢给操作员
                    if (isSessionFailureXhr(xhr)) {
                        redirectToLoginWithNotice(localTexts.sessionExpiredText);
                        resetSubmitButton();
                        return;
                    }
                    showSubmitError(errorMsg);
                    resetSubmitButton();
                }
            });
        }

        function resetSubmitButton() {
            setTimeout(function() {
                $('#submitBtn').prop('disabled', false).html('<i class="fas fa-check-circle"></i> @GetText("Outbound", "SubmitButton")');
            }, 1000);
        }

        function resetForm() {
            var savedPackId = $('#packId').val();
            $('#outboundForm')[0].reset();
            $('#packId').val(savedPackId);
            $('.error-message').html('');
            clearSubmitError();
            $('#salesOrderNo, #salesOrderLineNo, #orderRelNum').val('');
            // 重置时同步清空批号信息（批号输入框 + 批号单选列表，单选列表为动态 DOM，form.reset() 不会清除）
            $('#batchNo').val('');
            $('#lotRadioList').empty().hide();
            hideOrderQtyInfo();
            // 注意：不清除 Pack ID，保留最后一次的值
            $('#salesOrderNo').focus();
            showMessage(localTexts.formReset, 'info');
        }

        function searchOrders(custID, custName, orderNum, poNum) {
            // —— 防抖：回车 + 点击双重触发合并为一次；同时取消上次未完成的 AJAX，避免返回乱序覆盖
            if (__searchDebounceTimer) { clearTimeout(__searchDebounceTimer); __searchDebounceTimer = null; }
            __searchDebounceTimer = setTimeout(function () {
                if (__searchXhr) { try { __searchXhr.abort(); } catch (e) { /* ignore */ } __searchXhr = null; }

                showToast(localTexts.searching, 'info');
                __searchXhr = $.ajax({
                    url: '/Outbound/SearchOrders',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ CustID: custID || '', CustName: custName || '', OrderNum: orderNum || '', PONum: poNum || '' }),
                    headers: { 'X-CSRF-TOKEN': $('input[name="__RequestVerificationToken"]').val() },
                    success: function (response) {
                        __searchXhr = null;
                        if (response.success) {
                            currentOrderData = response.data || [];
                            renderOrdersTableBody(currentOrderData);
                            currentSortKey = null;
                            currentSortOrder = null;
                            updateSortHeaderStyle();
                            $('.orders-table-container').show();
                            showToast(localTexts.searchSuccess, 'success');
                        } else {
                            showMessage(response.message || localTexts.searchFailed, 'error');
                            $('.orders-table-container').hide();
                        }
                    },
                    error: function (xhr, status) {
                        __searchXhr = null;
                        if (status === 'abort') return; // 主动取消：不提示
                        showMessage(localTexts.searchFailed, 'error');
                        $('.orders-table-container').hide();
                    }
                });
            }, 250);
        }

        // 库存查询缓存：partNum -> { items: [...], ts: 写入时间戳 } / { loading: true, ts: ... }
        // 增加 30s TTL：与后端 QueryInventoryDetailBatch 缓存保持一致，避免用户长时间停留在页面看到过旧库存。
        var __outInvCache = {};
        var __outInvCacheTtlMs = 30 * 1000;

        /** 读取库存缓存；过期或不存在返回 null；loading 状态返回字符串 'loading'（保持与原逻辑兼容） */
        function __getInvCache(pn) {
            var e = __outInvCache[pn];
            if (!e) return null;
            if (Date.now() - e.ts > __outInvCacheTtlMs) {
                delete __outInvCache[pn];
                return null;
            }
            return e.loading ? 'loading' : e.items;
        }
        /** 写入库存缓存 */
        function __setInvCache(pn, items) {
            __outInvCache[pn] = { items: items, ts: Date.now() };
        }
        /** 标记正在加载 */
        function __setInvLoading(pn) {
            __outInvCache[pn] = { loading: true, ts: Date.now() };
        }
        /** 清除库存缓存 */
        function __clearInvCache(pn) {
            delete __outInvCache[pn];
        }

        /** 渲染销售发货订单列表
         *  —— 单段 HTML 字符串拼接 + 一次 innerHTML，避免 $.each 内每次 $.append 导致的 O(N) 次重排。
         *  —— 事件绑定统一提升到 document 级事件委托（见 $(document).ready），本函数不随每次 render 做 off/on。
         *  —— 动态字段使用 __htmlEscape() 防止特殊字符破坏 DOM，且保持排序/勾选交互数据通过 data-index 从 currentOrderData 读取。
         */
        function renderOrdersTableBody(data) {
            var tbody = document.querySelector('#ordersTable tbody');
            if (!tbody) return;

            if (!data || data.length === 0) {
                tbody.innerHTML = '<tr><td colspan="14" style="text-align:center; padding: 20px;">' + __htmlEscape(localTexts.noData) + '</td></tr>';
                return;
            }

            // 取本地文本默认值一次，避免循环内重复访问对象
            var tCustCode  = __htmlEscape(localTexts.customerCode    || '');
            var tCustName  = __htmlEscape(localTexts.customerName    || '');
            var tReqDate   = __htmlEscape(localTexts.reqDate         || '');
            var tPo        = __htmlEscape(localTexts.po              || '');
            var tOrder     = __htmlEscape(localTexts.order           || '');
            var tLine      = __htmlEscape(localTexts.line            || '');
            var tRelease   = __htmlEscape(localTexts.release         || '');
            var tPart      = __htmlEscape(localTexts.part            || '');
            var tPartDesc  = __htmlEscape(localTexts.partDescription || '');
            var tReqQty    = __htmlEscape(localTexts.requiredQty     || '');
            var tOnHand    = __htmlEscape(localTexts.onHandQty       || '');
            var tComments  = __htmlEscape(localTexts.comments        || '');
            var tInvTitle  = __htmlEscape(localTexts.detailInventory || 'Detail Inventory');
            var tInvAction = __htmlEscape(localTexts.detailInventoryAction || 'Stock Info');
            var tInvEmpty  = __htmlEscape(localTexts.invEmpty        || '-');

            var rowsHtml = [];
            rowsHtml.reserveHint = data.length; // 逻辑提示：每行只生成 1 个 tr（抽屉方案不预渲染隐藏展开行）

            for (var i = 0; i < data.length; i++) {
                var it = data[i];
                var idx = String(i);
                rowsHtml.push(
                    '<tr data-index="', idx, '">',
                      '<td class="col-fix-1"><input type="checkbox" class="order-select"></td>',
                      '<td class="col-fix-2" data-label="', tCustCode, '">', __htmlEscape(it.custNum || ''), '</td>',
                      '<td class="col-fix-3" data-label="', tCustName, '">', __htmlEscape(it.custName || ''), '</td>',
                      '<td class="col-fix-4" data-label="', tReqDate,  '">', __htmlEscape(it.customerReqDate || ''), '</td>',
                      '<td class="col-po"    data-label="', tPo,       '">', __htmlEscape(it.po || ''), '</td>',
                      '<td data-label="', tOrder,   '">', __htmlEscape(it.order || ''), '</td>',
                      '<td data-label="', tLine,    '">', __htmlEscape(it.line  || ''), '</td>',
                      '<td data-label="', tRelease, '">', __htmlEscape(it.rel   || ''), '</td>',
                      '<td class="col-part" data-label="', tPart,     '">', __htmlEscape(it.part || ''), '</td>',
                      '<td class="col-part" data-label="', tPartDesc, '">', __htmlEscape(it.partDescription || ''), '</td>',
                      '<td data-label="', tReqQty,  '">', __htmlEscape(it.ourReqQty != null ? it.ourReqQty : 0), '</td>',
                      '<td data-label="', tOnHand,  '">', __htmlEscape(it.onHandQty != null ? it.onHandQty : 0), '</td>',
                      '<td data-label="', tComments,'">', __htmlEscape(it.comments || ''), '</td>',
                      '<td class="col-expander">',
                        '<span class="inv-arrow" role="button" tabindex="0" title="', tInvTitle, '" data-part="', __htmlEscape(it.part || ''), '">',
                          '<span class="arr">▼</span>', tInvAction,
                        '</span>',
                      '</td>',
                    '</tr>'
                );
            }

            // —— 性能关键点：一次 innerHTML，浏览器做 1 次 DOM 重建 + 1 次 reflow（而不是 2N 次）
            tbody.innerHTML = rowsHtml.join('');
            void rowsHtml.reserveHint; // 消除未使用变量提示
            void tInvEmpty; // 保留本地文本变量（后续可扩展空占位）
        }

        /** 根据 data-index 从 currentOrderData 取对应行对象（事件委托统一入口） */
        function __getOrderByIndex(index) {
            var i = parseInt(index, 10);
            if (isNaN(i) || i < 0 || !currentOrderData || i >= currentOrderData.length) return null;
            return currentOrderData[i];
        }

        /** 解析 order/line/rel：优先从当前行的 data-index 对应的 currentOrderData 读取（避免 DOM data-attr 转义问题） */
        function __extractOrderRelFromRow($tr) {
            var d = __getOrderByIndex($tr.data('index'));
            if (d) return { order: d.order || '', line: d.line || '', rel: d.rel || '' };
            return { order: '', line: '', rel: '' };
        }

        /** 订单选中/取消选中逻辑（原 render 中的 .order-select change 事件，现由文档级委托调用） */
        function __handleOrderSelectChange($checkbox, runValidate) {
            var $row = $checkbox.closest('tr');
            if ($checkbox.prop('checked')) {
                $('#ordersTable tbody tr').removeClass('selected');
                $row.addClass('selected');
                // 保证其它 checkbox 状态一致（单选约束）
                $('#ordersTable .order-select').not($checkbox).prop('checked', false);
                var data = __extractOrderRelFromRow($row);
                $('#salesOrderNo').val(data.order || '');
                $('#salesOrderLineNo').val(data.line  || '');
                $('#orderRelNum').val(data.rel       || '');
                if (runValidate) {
                    validateOrder().then(function (valid) { if (valid) $('#materialCode').focus().select(); });
                } else {
                    $('#materialCode').focus().select();
                }
            } else {
                $row.removeClass('selected');
            }
        }

        /** 整行点击：区分"点击 Stock Info 按钮/列" vs "点击其它区域选中订单" */
        function __handleOrderRowClick(tr, evt) {
            var $tr = $(tr);
            var $t  = $(evt.target);
            if ($t.closest('.col-expander, .inv-arrow').length > 0) {
                evt.stopPropagation();
                // 点击展开列任意位置都打开库存抽屉（兼容按钮和列空白区点击）
                var item = __getOrderByIndex($tr.data('index'));
                __openInventoryDrawer(item ? item.part : null, $tr);
                return false;
            }
            if (evt.target && evt.target.type === 'checkbox') return true; // checkbox 自身处理
            var $cb = $tr.find('input.order-select');
            // 翻转 + 触发 change 逻辑（不 dispatch DOM event，避免再次冒泡到文档）
            var next = !$cb.prop('checked');
            $cb.prop('checked', next);
            __handleOrderSelectChange($cb, true);
            return false;
        }

            // 当前打开的库存抽屉对应的 partNum 和触发行（用于关闭时清除高亮）
            var __currentDrawerPart = null;
            var __currentDrawerRow  = null;

            /** 打开库存抽屉 / 手机底部弹层
             * 业务逻辑：根据 partNum 显示 Warehouse/Bin/Lot/Qty 卡片；
             * 优先读 30s TTL 前端缓存，未命中再调 QueryInventoryDetailBatch（后端本身也有 30s 缓存）。
             */
            function __openInventoryDrawer(pn, $tr) {
                __currentDrawerPart = pn;
                __currentDrawerRow  = $tr && $tr.length ? $tr : null;
                __highlightDrawerRow(true);

                $('#invDrawerTitle').text(localTexts.detailInventory || 'Stock Info');
                if (pn) {
                    $('#invDrawerSubtitle').text((localTexts.part || 'Part') + ': ' + pn).show();
                } else {
                    $('#invDrawerSubtitle').hide();
                }
                $('#invDrawerContent').empty();
                $('#invDrawerEmpty').hide();
                $('#invDrawerLoading').show();
                __toggleDrawerPanel(true);

                if (!pn) {
                    __showDrawerEmpty(localTexts.invEmpty || '-');
                    return;
                }

                var cached = __getInvCache(pn);
                if (Array.isArray(cached)) {
                    __fillDrawerContent(cached);
                } else if (cached === 'loading') {
                    // 已有进行中的请求，其回调会按 __currentDrawerPart === pn 自动刷新当前抽屉
                } else {
                    __loadInventoryForDrawer(pn);
                }
            }

            /** 关闭抽屉并清除行高亮 */
            function __closeInventoryDrawer() {
                __toggleDrawerPanel(false);
                __highlightDrawerRow(false);
                __currentDrawerPart = null;
                __currentDrawerRow  = null;
            }

            function __toggleDrawerPanel(open) {
                if (open) {
                    $('#invDrawerOverlay, #invDrawerPanel').addClass('open');
                    $('body').addClass('inv-drawer-open');
                } else {
                    $('#invDrawerOverlay, #invDrawerPanel').removeClass('open');
                    $('body').removeClass('inv-drawer-open');
                }
            }

            function __highlightDrawerRow(active) {
                if (__currentDrawerRow && __currentDrawerRow.length) {
                    if (active) {
                        $('#ordersTable tbody tr').removeClass('inv-row-active');
                        __currentDrawerRow.addClass('inv-row-active').find('.inv-arrow .arr').text('▲');
                    } else {
                        __currentDrawerRow.removeClass('inv-row-active').find('.inv-arrow .arr').text('▼');
                    }
                }
            }

            /** 从后端拉取库存并填入抽屉（并发去重与后端缓存共用同一机制） */
            function __loadInventoryForDrawer(pn) {
                __setInvLoading(pn);
                __useInFlight('inv:' + pn, function () {
                    return $.ajax({
                        url: '/Outbound/QueryInventoryDetailBatch',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ PartNums: [pn] }),
                        headers: __csrfHeader()
                    }).then(
                        function (res) {
                            var items = (res && res.success && res.results && res.results[pn]) ? res.results[pn] : [];
                            __setInvCache(pn, items);
                            if (__currentDrawerPart === pn) __fillDrawerContent(items);
                        },
                        function () {
                            __clearInvCache(pn);
                            if (__currentDrawerPart === pn) __showDrawerEmpty(localTexts.invFailed || localTexts.invEmpty || '-');
                        }
                    );
                });
            }

            function __fillDrawerContent(items) {
                $('#invDrawerLoading').hide();
                if (!items || items.length === 0) {
                    __showDrawerEmpty(localTexts.invEmpty || '-');
                } else {
                    $('#invDrawerEmpty').hide();
                    $('#invDrawerContent').html(renderInvCardsHtml(items));
                }
            }

            function __showDrawerEmpty(msg) {
                $('#invDrawerLoading').hide();
                $('#invDrawerEmpty').text(msg || '-').show();
                $('#invDrawerContent').empty();
            }

            /** 组装 Warehouse/Bin/Lot/Qty 卡片网格 HTML */
            function renderInvCardsHtml(items) {
                if (!items || items.length === 0) {
                    return '<div class="inv-empty-hint">' + (localTexts.invEmpty || '-') + '</div>';
                }
                var tplWhse = localTexts.invWhse || 'Warehouse';
                var tplBin  = localTexts.invBin  || 'Bin';
                var tplLot  = localTexts.invLot  || 'Lot';
                var tplQty  = localTexts.invQty  || 'Qty';
                var cards = '';
                for (var i = 0; i < items.length; i++) {
                    var it = items[i];
                    // —— 后端优化后字段采用短名以减少序列化带宽（wh/bin/lot/qty/u），同时兼容旧字段（whseCode/binNum/lotNumber/qtyOnHand/ium）。
                    var unit = (it.u != null ? it.u : it.ium) ? (' ' + (it.u != null ? it.u : it.ium)) : '';
                    var lot  = (it.lot != null ? it.lot : it.lotNumber) || '-';
                    var wh   = (it.wh  != null ? it.wh  : it.whseCode) || '-';
                    var bin  = (it.bin != null ? it.bin : it.binNum)   || '-';
                    var qty  = (it.qty != null ? it.qty : it.qtyOnHand);
                    qty = qty != null ? qty : 0;
                    cards += '<div class="inv-card">'
                          +   '<div class="inv-card-row"><span class="lbl">' + tplWhse + '</span><span class="val">' + __htmlEscape(wh) + '</span></div>'
                          +   '<div class="inv-card-row"><span class="lbl">' + tplBin  + '</span><span class="val">' + __htmlEscape(bin) + '</span></div>'
                          +   '<div class="inv-card-row"><span class="lbl">' + tplLot  + '</span><span class="val">' + __htmlEscape(lot) + '</span></div>'
                          +   '<div class="inv-card-row"><span class="lbl">' + tplQty  + '</span><span class="qty">' + qty + __htmlEscape(unit) + '</span></div>'
                          + '</div>';
                }
                return '<div class="inv-card-grid">' + cards + '</div>';
            }

    </script>
</body>
</html>
