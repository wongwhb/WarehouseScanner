        /**
         * 判定后端文案是否属于「会话/登录态失效」（此时应提示并跳回登录页）。
         * 后端有两类文案，必须都识别，否则只会显示提示而不跳转，操作员需手动重新登录：
         *   1. 会话过期（UnauthorizedAccessException / Outbound.SessionExpired）→「登录已过期，请重新登录」
         *   2. 防伪令牌失效（AntiforgeryValidationException，GlobalExceptionMiddleware）
         *      →「登录状态已变更，请重新登录」
         * 参数 message：后端返回的错误文案
         * 返回：true=属于会话/登录态失效
         */
        function isSessionExpiredText(message) {
            if (!message) return false;
            var text = String(message);
            var markers = [localTexts.sessionExpiredText, localTexts.sessionChangedText];
            for (var i = 0; i < markers.length; i++) {
                if (markers[i] && text.indexOf(markers[i]) >= 0) return true;
            }
            return false;
        }

        /**
         * 判定 AJAX 失败是否属于「会话/登录态失效」（不依赖文案，界面语言无关）。
         * 依据：
         *   - HTTP 401 / 302：会话失效；
         *   - 响应体 errorCode 为 SessionExpired / SessionChanged（GlobalExceptionMiddleware 写入）。
         * 注意：不能用「HTTP 400 且响应体为空」来推断。中间件已保证防伪校验失败的请求一定带回
         *       errorCode，而"其它原因的空 400"（例如某个 Action 直接 return BadRequest()）会被
         *       中间件补上普通 JSON 提示，若仍按空 400 推断，会把操作员误踢回登录页。
         * 参数 xhr：jQuery 的 jqXHR 对象
         * 返回：true=应跳转登录页
         */
        function isSessionFailureXhr(xhr) {
            if (!xhr) return false;
            if (xhr.status === 401 || xhr.status === 302) return true;

            var body = xhr.responseJSON;
            if (body && (body.errorCode === 'SessionExpired' || body.errorCode === 'SessionChanged')) return true;

            return false;
        }

        /** 会话/登录态失效的展示与跳转：提示 + 1.5s 后回登录页 */
        function redirectToLoginWithNotice(message) {
            var text = message || localTexts.sessionExpiredText;
            __closeSwalIfVisible();
            showToast(text, 'error');
            setTimeout(function () {
                window.location.href = '/Account/Login';
            }, 1500);
        }

        /** 检测后端返回是否为会话过期，若是则提示并跳转登录页 */
        function handleSessionIfExpired(message) {
            if (!isSessionExpiredText(message)) return false;
            redirectToLoginWithNotice(message);
            return true;
        }

