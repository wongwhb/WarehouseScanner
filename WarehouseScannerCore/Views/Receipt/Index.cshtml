@{
    var getText = ViewBag.GetText as Func<string, string, string>;
    var currentCulture = ViewBag.CurrentCulture as string ?? "zh-CN";
    var userId = ViewBag.UserId as string;

    string GetText(string section, string key)
    {
        return getText?.Invoke(section, key) ?? $"[{section}.{key}]";
    }
}

<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>@GetText("Receipt", "Title")</title>

    <link rel="stylesheet" href="~/css/fontawesome/all.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/shared-scanner.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/sweetalert2.css">

    <style>
        @@media (max-width: 768px) {
            .page-header {
                display: none !important;
            }
        }

        @@media (min-width: 769px) {
            .page-header {
                display: block !important;
            }
        }

        .status-toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0,0,0,0.85);
            color: white;
            padding: 12px 24px;
            border-radius: 40px;
            font-size: 15px;
            z-index: 10000;
            max-width: 90%;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            animation: fadeInUp 0.3s ease;
            font-weight: 500;
        }

            .status-toast.success {
                background: #28a745;
            }

            .status-toast.warning {
                background: #ffc107;
                color: #333;
            }

            .status-toast.info {
                background: #17a2b8;
            }

            .status-toast.error {
                background: #dc3545;
            }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateX(-50%) translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }
        }

        .status-message {
            display: none;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="page-header">
            <h1 class="page-title">
                <i class="fas fa-box-in"></i> @GetText("Receipt", "Title")
            </h1>
            <div class="page-subtitle">
                @GetText("Receipt", "Subtitle")
            </div>
        </div>

        <div id="statusMessage" class="status-message"></div>

        <div class="form-container">
            <form id="receiptForm" method="post">
                @Html.AntiForgeryToken()

                <div class="button-group">
                    <button type="button" class="btn btn-primary" id="submitBtn">
                        <i class="fas fa-check-circle"></i> @GetText("Receipt", "SubmitButton")
                    </button>
                    <button type="button" class="btn btn-secondary" id="resetBtn">
                        <i class="fas fa-redo-alt"></i> @GetText("Receipt", "ResetButton")
                    </button>
                    <button type="button" class="btn btn-danger" id="cancelBtn">
                        <i class="fas fa-times-circle"></i> @GetText("Receipt", "CancelButton")
                    </button>
                </div>

                <div class="form-grid">
                    <div class="form-item">
                        <label>
                            @GetText("Receipt", "WorkOrderNo") <span class="required">*</span>
                        </label>
                        <div class="input-group">
                            <input type="text"
                                   class="input-field scan-input"
                                   id="workOrderNo"
                                   name="WorkOrderNo"
                                   placeholder="@GetText("Receipt", "WorkOrderPlaceholder")"
                                   autocomplete="off"
                                   autofocus>
                        </div>
                        <div class="input-hint">
                            <i class="fas fa-keyboard"></i> @GetText("Receipt", "JobScanPromptMessage")
                        </div>
                        <div class="error-message" id="workOrderError"></div>
                    </div>

                    <div class="form-item">
                        <label>@GetText("Receipt", "AssemblySeq")<span class="required">*</span></label>
                        <input type="text"
                               class="input-field"
                               id="assemblySeq"
                               name="AssemblySeq"
                               placeholder="@GetText("Receipt", "AssemblySeqPlaceholder")"
                               autocomplete="off">
                        <div class="error-message" id="assemblySeqError"></div>
                    </div>

                    <div class="form-item">
                        <label>
                            @GetText("Receipt", "MaterialCode") <span class="required">*</span>
                        </label>
                        <div class="input-group">
                            <input type="text"
                                   class="input-field scan-input"
                                   id="materialCode"
                                   name="MaterialCode"
                                   placeholder="@GetText("Receipt", "MaterialPlaceholder")"
                                   autocomplete="off">
                        </div>
                        <div class="input-hint">
                            <i class="fas fa-keyboard"></i> @GetText("Receipt", "MatScanPromptMessage")
                        </div>
                        <div class="error-message" id="materialCodeError"></div>
                    </div>

                    <div class="form-item">
                        <label>
                            @GetText("Receipt", "Quantity") <span class="required">*</span>
                        </label>
                        <input type="number"
                               class="input-field"
                               id="quantity"
                               name="Quantity"
                               min="0.000001"
                               step="0.000001"
                               placeholder="@GetText("Receipt", "QuantityPlaceholder")"
                               autocomplete="off">
                        <div class="error-message" id="quantityError"></div>
                        @*入库数量信息（红色单行显示）：工单数量 / 已收货数量 / 未收货数量 / 库存数量
                          整行文案取自语言资源 JobQtyInfoFormat（中英文），data-format 供 JS 填充数量
                          注意：div 与 span 必须紧邻无空白，且不可用 white-space:pre——否则缩进空白会被渲染成左侧大段缩进*@
                        <div id="jobQtyInfoDisplay" data-format="@GetText("Receipt", "JobQtyInfoFormat")" style="display:none; color:#dc3545; font-weight:bold; margin-top:4px; font-size:0.95em; text-align:left;"><span id="dispJobQtyInfoLine"></span></div>
                    </div>

                    <div class="form-item">
                        <label>@GetText("Receipt", "Unit")</label>
                        <input type="text"
                               class="input-field"
                               id="unit"
                               name="Unit"
                               autocomplete="off">
                    </div>

                    <div class="form-item">
                        <label>@GetText("Receipt", "WarehouseCode")</label>
                        <input type="text"
                               class="input-field"
                               id="warehouseCode"
                               name="WarehouseCode"
                               value="01"
                               autocomplete="off">
                    </div>

                    <div class="form-item">
                        <label>@GetText("Receipt", "Location")</label>
                        <input type="text"
                               class="input-field"
                               id="location"
                               name="Location"
                               placeholder="@GetText("Receipt", "LocationPlaceholder")"
                               autocomplete="off">
                    </div>

                    <div class="form-item">
                        <label>@GetText("Receipt", "BatchNo")</label>
                        <input type="text"
                               class="input-field"
                               id="batchNo"
                               name="BatchNo"
                               placeholder="@GetText("Receipt", "BatchNoPlaceholder")"
                               autocomplete="off">
                    </div>

                    <div id="operator-section" class="form-item">
                        <label>@GetText("Receipt", "Operator")</label>
                        <input type="text"
                               class="input-field readonly"
                               id="operator"
                               value="@userId"
                               readonly>
                    </div>
                </div>

                <div class="form-item full-width">
                    <label>@GetText("Receipt", "Remarks")</label>
                    <textarea class="input-field"
                              id="remarks"
                              name="Remarks"
                              rows="2"
                              placeholder="@GetText("Receipt", "RemarksPlaceholder")"
                              autocomplete="off"></textarea>
                </div>
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/Scancode-parser.js" asp-append-version="true"></script>
    <script src="~/js/sweetalert.js"></script>

    <script>
        var localTexts = {
            workOrderRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "WorkOrderRequired"))),
            materialCodeRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "MaterialCodeRequired"))),
            quantityRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "QuantityRequired"))),
            confirmCancel: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "ConfirmCancel"))),
            submitting: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "Submitting"))),
            submitSuccess: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "SubmitSuccess"))),
            submitFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "SubmitFailed"))),
            networkError: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "NetworkError"))),
            assemblySeqRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "AssemblySeqRequired"))),
            barcodeParseSuccess: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "BarcodeParseSuccess"))),
            barcodeParseFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "BarcodeParseFailed"))),
            parserReady: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "ParserReady"))),
            parserInitFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "ParserInitFailed"))),
            jobBarcodeParseSuccess: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "JobBarcodeParseSuccess"))),
            materialBarcodeParseSuccess: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "MaterialBarcodeParseSuccess"))),
            formReset: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "FormReset"))),
            confirmButton: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Common", "Confirm"))),
            cancelButtonText: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Common", "Cancel"))),
            okButton: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Common", "OK"))),
            commonError: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "CommonError"))),
            jobValidated: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "JobValidated"))),
            jobValidationFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "JobValidationFailed"))),
            materialValidated: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "MaterialValidated"))),
            materialValidationFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "MaterialValidationFailed"))),
            shippingScheduleNotFoundSimple: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "ShippingScheduleNotFoundSimple"))),
            queryShippingScheduleFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "QueryShippingScheduleFailed"))),
            queryingShippingSchedule: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "QueryingShippingSchedule"))),
            poBarcodeFormatHint: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "PoBarcodeFormatHint"))),
            queryingAssemblySeq: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "QueryingAssemblySeq"))),
            assemblySeqNotFoundSimple: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "AssemblySeqNotFoundSimple"))),
            queryAssemblySeqFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "QueryAssemblySeqFailed"))),
            validatingJob: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receipt", "ValidatingJob")))
        };

        let barcodeParser = null;
        let isProcessing = false;
        let toastTimer = null;
        let jobValidated = false;
        let materialValidated = false;
        let jobInfoData = null;

        // HTML 转义：动态消息（服务端响应/解析结果）插入 DOM 前统一转义，防止注入（与 CountView 同一实现）
        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str).replace(/&/g, '&amp;')
                              .replace(/</g, '&lt;')
                              .replace(/>/g, '&gt;')
                              .replace(/"/g, '&quot;')
                              .replace(/'/g, '&#039;');
        }

        function showToast(message, type) {
            if (toastTimer) {
                clearTimeout(toastTimer);
            }
            $('.status-toast').remove();

            var $toast = $('<div class="status-toast ' + type + '">' + escapeHtml(message) + '</div>');
            $('body').append($toast);

            toastTimer = setTimeout(function() {
                $toast.fadeOut(300, function() {
                    $(this).remove();
                });
                toastTimer = null;
            }, 2000);
        }

        function showMessage(message, type) {
            if (type === 'error') {
                Swal.fire({
                    icon: 'error',
                    title: localTexts.commonError,
                    text: message,
                    confirmButtonText: localTexts.okButton,
                    timer: 3000,
                    timerProgressBar: true
                });
            } else {
                showToast(message, type);
            }
        }

        /** 数量格式化：去掉浮点尾巴（如 6.0000000001 → 6），最多保留 2 位小数 */
        function fmtQty(v) {
            var n = Number(v);
            if (isNaN(n)) return '0';
            return (Math.round(n * 100) / 100).toString();
        }

        /**
         * 生成入库数量信息整行文案：模板取自语言资源 JobQtyInfoFormat（中英文）
         * 占位符：{0}=工单数量 {1}=已收货数量 {2}=未收货数量 {3}=库存数量
         */
        function formatJobQtyInfoLine(prodQty, receivedQty, unreceivedQty, stockQty) {
            var fmt = $('#jobQtyInfoDisplay').data('format') || '';
            if (!fmt) return '';
            return fmt.replace('{0}', fmtQty(prodQty))
                      .replace('{1}', fmtQty(receivedQty))
                      .replace('{2}', fmtQty(unreceivedQty))
                      .replace('{3}', fmtQty(stockQty));
        }

        function displayJobInfo(data) {
            if (!data) {
                $('#jobQtyInfoDisplay').hide();
                return;
            }

            if (data.prodQty !== undefined && data.prodQty !== null) {
                var prodQty = Number(data.prodQty) || 0;
                var receivedQty = Number(data.receivedQty) || 0;
                var unreceivedQty = Number(data.availableQty) || 0;
                var stockQty = Number(data.stockQty) || 0;
                $('#dispJobQtyInfoLine').text(formatJobQtyInfoLine(prodQty, receivedQty, unreceivedQty, stockQty));
                $('#jobQtyInfoDisplay').show();
            } else {
                $('#jobQtyInfoDisplay').hide();
            }

            // 注释：仓库默认为 01，不从物料获取
            //if (data.warehouseCode) {
            //    $('#warehouseCode').val(data.warehouseCode);
            //}
            if (data.binNum) {
                $('#location').val(data.binNum);
            }
            if (data.unit) {
                $('#unit').val(data.unit);
            }
        }

        $(document).ready(function () {
            $('#workOrderNo').val('');
            $('#assemblySeq').val('');
            // 仓库默认值 01 由 input 的 value="01" 提供，form.reset() 也会恢复该初始值

            initializeBarcodeParser();

            $('.scan-input').on('change', function () {
                $(this).addClass('scan-highlight');
                setTimeout(() => $(this).removeClass('scan-highlight'), 500);
            });

            $('#workOrderNo').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    handleWorkOrderEnter();
                }
            });

            $('#materialCode').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    handleMaterialCodeEnter();
                }
            });

            // 仓库代码 Enter 事件 - 集成 Scancode-parser.js 仓库条码解析
            bindWarehouseScan({
                warehouseInput: '#warehouseCode',
                locationInput: '#location',
                nextFocusInput: '#batchNo',
                fallbackTab: true
            });

            $('#quantity').on('blur', function () {
            });

            $('.input-field:not(#workOrderNo, #materialCode, #warehouseCode, .readonly, textarea)').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    var $inputs = $('.input-field:not(.readonly)');
                    var index = $inputs.index(e.target);
                    if (index >= 0 && index < $inputs.length - 1) {
                        $inputs.eq(index + 1).focus().select();
                    }
                }
            });

            $('#submitBtn').on('click', function () {
                submitForm();
            });

            $('#resetBtn').on('click', resetForm);

            $('#cancelBtn').on('click', function () {
                Swal.fire({
                    title: localTexts.confirmCancel,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: localTexts.confirmButton,
                    cancelButtonText: localTexts.cancelButtonText
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '/Home/Index';
                    }
                });
            });
        });

        function initializeBarcodeParser() {
            try {
                if (typeof window.BarcodeParser !== 'undefined') {
                    barcodeParser = new window.BarcodeParser();
                } else {
                    throw new Error(localTexts.parserInitFailed);
                }
            } catch (error) {
            }
        }

        // trySplitPoRel 与 isPartPoBarcode 由 BarcodeParser 静态方法提供（双页复用），
        //        本页直接调用，不维护本地拷贝。

        /** 调用 Receipt/QueryShippingSchedule 并回填字段 */
        async function queryReceiptShippingSchedule(poNum, orderLine, orderRelNum, partNum) {
            try {
                var resp = await $.ajax({
                    url: '/Receipt/QueryShippingSchedule',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: { 'X-CSRF-TOKEN': $('input[name="__RequestVerificationToken"]').val() },
                    data: JSON.stringify({ PONum: poNum, OrderLine: orderLine, OrderRelNum: orderRelNum, PartNum: partNum })
                });
                if (resp && resp.success) {
                    // 需求 ②：工单号回写至 workOrderNo + batchNo
                    $('#workOrderNo').val(resp.jobNum || '');
                    $('#batchNo').val(resp.jobNum || '');
                    // 装配序号：后端 GetAssemblySeqFromMfgAsync 返回 null 表示未找到，有值(含0)则回填
                    if (resp.assemblySeq !== null && resp.assemblySeq !== undefined) {
                        $('#assemblySeq').val(resp.assemblySeq);
                    }
                    if (resp.unit) $('#unit').val(resp.unit);
                    // 注释：仓库默认为 01，不从物料获取
                    //if (resp.warehouseCode) $('#warehouseCode').val(resp.warehouseCode);
                    if (resp.binNum) $('#location').val(resp.binNum);
                    return true;
                }
                showMessage(resp?.message || localTexts.shippingScheduleNotFoundSimple, 'warning');
                // 未找到发货计划 → 清空所有输入值（仓库保留默认 01），聚焦工单号
                if (resp && resp.code === 'ShippingScheduleNotFound') {
                    $('#workOrderNo, #assemblySeq, #materialCode, #quantity, #unit, #location, #batchNo').val('');
                    $('.error-message').html('');
                    $('#jobQtyInfoDisplay').hide();
                    jobValidated = false;
                    jobInfoData = null;
                    $('#workOrderNo').focus().select();
                }
                return false;
            } catch (xhr) {
                showMessage(localTexts.queryShippingScheduleFailed, 'error');
                return false;
            }
        }

        async function handleWorkOrderEnter() {
            if (isProcessing) return;
            isProcessing = true;

            try {
                let barcode = $('#workOrderNo').val().trim();

                if (!barcode) {
                    showMessage(localTexts.workOrderRequired, 'warning');
                    $('#workOrderNo').focus();
                    return;
                }

                if (barcodeParser) {
                    try {
                        const result = barcodeParser.parse(barcode);
                        const d = result.data || {};
                        const hasWorkOrder = !!d.workOrderNo;
                        const hasMaterial = !!d.materialCode;

                        // ========== PART+PO 条码 → 查发货计划获取工单号 ==========
                        if (result.success && BarcodeParser.isPartPoBarcode(barcode) && hasMaterial && hasWorkOrder) {
                            var split = BarcodeParser.splitPoRel(d.workOrderNo);
                            if (split.ok) {
                                // 需求 ①：只填物料编号 & 数量；单位与批次号不解析回填
                                $('#materialCode').val(d.materialCode);
                                if (d.quantity) $('#quantity').val(d.quantity);

                                showToast(localTexts.queryingShippingSchedule, 'info');
                                var ok = await queryReceiptShippingSchedule(
                                    split.poNum, split.orderLine, split.orderRelNum, d.materialCode
                                );
                                if (ok) {
                                    validateJob();
                                } else {
                                    $('#workOrderNo').focus();
                                }
                                return;
                            } else {
                                // B4：PART+PO 条码但 PO 值不是"号-行-批"三段格式 → 明确提示并终止，
                                // 不落入下方工单条码分支把 PO 值误当工单号填入（避免"工单不存在"的误导报错）。
                                showMessage(localTexts.poBarcodeFormatHint, 'warning');
                                $('#workOrderNo').focus().select();
                                return;
                            }
                        }

                        // ========== 工单条码 → 回填字段 + 查装配序号 ==========
                        if (result.success && hasWorkOrder) {
                            $('#workOrderNo').val(d.workOrderNo);
                            if (d.assemblySeq) $('#assemblySeq').val(d.assemblySeq);
                            if (hasMaterial) $('#materialCode').val(d.materialCode);
                            if (d.quantity) $('#quantity').val(d.quantity);
                            if (d.unit) $('#unit').val(d.unit);
                            // 注释：仓库默认为 01，不从物料获取
                            //if (d.warehouseCode) $('#warehouseCode').val(d.warehouseCode);
                            if (d.binNum) $('#location').val(d.binNum);

                            // 批次号：优先使用条码中的 CTN/lotNum，没有则用工单号兜底
                            $('#batchNo').val(d.lotNum || d.workOrderNo);

                            if (!$('#assemblySeq').val().trim() && hasMaterial) {
                                showToast(localTexts.queryingAssemblySeq, 'info');
                                try {
                                    const resp = await $.ajax({
                                        url: '/Receipt/GetAssemblySeq',
                                        type: 'POST',
                                        contentType: 'application/json',
                                        headers: { 'X-CSRF-TOKEN': $('input[name="__RequestVerificationToken"]').val() },
                                        data: JSON.stringify({ JobNum: d.workOrderNo, PartNum: d.materialCode })
                                    });
                                    if (resp && resp.success) {
                                        $('#assemblySeq').val(resp.assemblySeq);
                                        validateJob();
                                    } else {
                                        showToast(resp?.message || localTexts.assemblySeqNotFoundSimple, 'warning');
                                        // 装配序号未找到 / 物料不存在 → 清空所有输入值（仓库保留默认 01）
                                        if (resp && (resp.code === 'AssemblySeqNotFound' || resp.code === 'PartNotFound')) {
                                            $('#workOrderNo, #assemblySeq, #materialCode, #quantity, #unit, #location, #batchNo').val('');
                                            $('.error-message').html('');
                                            $('#jobQtyInfoDisplay').hide();
                                            jobValidated = false;
                                            jobInfoData = null;
                                            $('#workOrderNo').focus().select();
                                        } else {
                                            $('#assemblySeq').focus().select();
                                        }
                                    }
                                } catch (xhr) {
                                    showToast(localTexts.queryAssemblySeqFailed, 'warning');
                                    $('#assemblySeq').focus().select();
                                }
                                return;
                            }

                            if ($('#assemblySeq').val().trim()) {
                                validateJob();
                            } else {
                                showToast(localTexts.assemblySeqRequired, 'info');
                                $('#assemblySeq').focus().select();
                            }
                            return;
                        }
                    } catch (e) { }
                }

                const assemblySeq = $('#assemblySeq').val().trim();
                if (!assemblySeq) {
                    showMessage(localTexts.assemblySeqRequired, 'error');
                    $('#assemblySeq').focus().select();
                    return;
                }
                validateJob();
            } finally {
                isProcessing = false;
            }
        }

        function validateJob() {
            var workOrderNo = $('#workOrderNo').val().trim();
            var assemblySeq = parseInt($('#assemblySeq').val()) || 0;
            var scanQty = parseFloat($('#quantity').val()) || 0;
            var materialCode = $('#materialCode').val().trim();

            if (!workOrderNo) {
                showMessage(localTexts.workOrderRequired, 'warning');
                $('#workOrderNo').focus();
                return;
            }

            if (!assemblySeq && assemblySeq !== 0) {
                showMessage(localTexts.assemblySeqRequired, 'warning');
                $('#assemblySeq').focus().select();
                return;
            }

            showToast(localTexts.validatingJob, 'info');

            var requestPayload = {
                WorkOrderNo: workOrderNo,
                AssemblySeq: assemblySeq,
                ScanQty: scanQty,
                MaterialCode: materialCode
            };

            $.ajax({
                url: '/Receipt/ValidateJob',
                type: 'POST',
                contentType: 'application/json',
                headers: { 'X-CSRF-TOKEN': $('input[name="__RequestVerificationToken"]').val() },
                data: JSON.stringify(requestPayload),
                success: function (response) {
                    if (response.success) {
                        jobValidated = true;
                        jobInfoData = response.data;
                        displayJobInfo(response.data);
                        showToast(response.message || localTexts.jobValidated, 'success');
                        if (response.warningMessage) {
                            // 超收提示：验证照常通过、不阻断入库，仅以警告样式提示
                            showMessage(response.warningMessage, 'warning');
                        }
                        setTimeout(() => $('#materialCode').focus().select(), 100);
                    } else {
                        // 部分校验失败（如物料/仓库/库位不存在）时，后端仍返回 data（含仓库/库位/单位）。
                        // 调用 displayJobInfo 回填仓库/库位/单位，仅将收货数量重置为 0，焦点跳到数量。
                        // 注：超收不进入此分支 —— 超收仅提示（warningMessage）且验证通过，允许入库。
                        if (response.data) {
                            jobValidated = false;
                            jobInfoData = response.data;
                            displayJobInfo(response.data);
                            $('#quantity').val(0);
                            showMessage(response.message || localTexts.jobValidationFailed, 'error');
                            setTimeout(() => $('#quantity').focus().select(), 100);
                        } else {
                            jobValidated = false;
                            jobInfoData = null;
                            displayJobInfo(null);
                            clearFormAfterValidationFail();
                            showMessage(response.message || localTexts.jobValidationFailed, 'error');
                        }
                    }
                },
                error: function (xhr, status, error) {
                    jobValidated = false;
                    jobInfoData = null;
                    displayJobInfo(null);
                    clearFormAfterValidationFail();
                    showMessage(localTexts.networkError, 'error');
                }
            });
        }

        async function handleMaterialCodeEnter() {
            if (isProcessing) return;
            isProcessing = true;

            try {
                let barcode = $('#materialCode').val().trim();
                if (!barcode) {
                    showMessage(localTexts.materialCodeRequired, 'warning');
                    $('#materialCode').focus();
                    return;
                }

                if (barcodeParser) {
                    try {
                        const result = barcodeParser.parse(barcode);
                        if (result.success && (result.type === 'material' || result.data.materialCode)) {
                            const data = result.data;
                            const hasWorkOrder = !!data.workOrderNo;
                            const hasMaterial = !!data.materialCode;
                            const workOrderEmpty = !$('#workOrderNo').val().trim();

                            // ========== PART+PO 条码且工单号未填 → 查发货计划 ==========
                            if (hasWorkOrder && hasMaterial && workOrderEmpty && BarcodeParser.isPartPoBarcode(barcode)) {
                                var split = BarcodeParser.splitPoRel(data.workOrderNo);
                                if (split.ok) {
                                    // 需求 ①：只填物料编号 & 数量；单位与批次号不解析回填
                                    $('#materialCode').val(data.materialCode);
                                    if (data.quantity) $('#quantity').val(data.quantity);

                                    showToast(localTexts.queryingShippingSchedule, 'info');
                                    var ok = await queryReceiptShippingSchedule(
                                        split.poNum, split.orderLine, split.orderRelNum, data.materialCode
                                    );
                                    if (ok) {
                                        validateJob();
                                    } else {
                                        $('#materialCode').focus();
                                    }
                                    return;
                                }
                            }

                            // ========== 普通物料条码 → 回填 + 查装配序号 ==========
                            $('#materialCode').val(data.materialCode);
                            if (data.quantity) $('#quantity').val(data.quantity);
                            if (data.unit) $('#unit').val(data.unit);
                            // 注释：仓库默认为 01，不从物料获取
                            //if (data.warehouseCode) $('#warehouseCode').val(data.warehouseCode);
                            if (data.binNum) $('#location').val(data.binNum);
                            if (data.lotNum) $('#batchNo').val(data.lotNum);

                            if (hasWorkOrder && hasMaterial && workOrderEmpty) {
                                const jobNum = data.workOrderNo;
                                const partNum = data.materialCode;

                                $('#workOrderNo').val(jobNum);
                                if (!$('#batchNo').val()) {
                                    $('#batchNo').val(jobNum);
                                }

                                if (!$('#assemblySeq').val().trim()) {
                                    showToast(localTexts.queryingAssemblySeq, 'info');
                                    try {
                                        const resp = await $.ajax({
                                            url: '/Receipt/GetAssemblySeq',
                                            type: 'POST',
                                            contentType: 'application/json',
                                            headers: { 'X-CSRF-TOKEN': $('input[name="__RequestVerificationToken"]').val() },
                                            data: JSON.stringify({ JobNum: jobNum, PartNum: partNum })
                                        });
                                        if (resp && resp.success) {
                                            $('#assemblySeq').val(resp.assemblySeq);
                                            validateJob();
                                        } else {
                                            showToast(resp?.message || localTexts.assemblySeqNotFoundSimple, 'warning');
                                            // 装配序号未找到 / 物料不存在 → 清空所有输入值（仓库保留默认 01）
                                            if (resp && (resp.code === 'AssemblySeqNotFound' || resp.code === 'PartNotFound')) {
                                                $('#workOrderNo, #assemblySeq, #materialCode, #quantity, #unit, #location, #batchNo').val('');
                                                $('.error-message').html('');
                                                $('#jobQtyInfoDisplay').hide();
                                                jobValidated = false;
                                                jobInfoData = null;
                                                $('#workOrderNo').focus().select();
                                            } else {
                                                $('#assemblySeq').focus().select();
                                            }
                                        }
                                    } catch (xhr) {
                                        showToast(localTexts.queryAssemblySeqFailed, 'warning');
                                        $('#assemblySeq').focus().select();
                                    }
                                    return;
                                }

                                if ($('#assemblySeq').val().trim()) {
                                    validateJob();
                                } else {
                                    showToast(localTexts.assemblySeqRequired, 'info');
                                    $('#assemblySeq').focus().select();
                                }
                                return;
                            }

                            setTimeout(() => $('#quantity').focus().select(), 100);
                            return;
                        }
                    } catch (e) { }
                }

                setTimeout(() => $('#quantity').focus().select(), 100);
            } finally {
                isProcessing = false;
            }
        }

        // 一次提交尝试内固定 ID：失败/超时重试复用同一 ID（服务端据此拦截重复过账），成功后重置。
        var pendingRequestId = null;
        function getRequestId() {
            if (!pendingRequestId) {
                var uuid = (window.crypto && typeof crypto.randomUUID === 'function')
                    ? crypto.randomUUID()
                    : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
                        var r = Math.random() * 16 | 0;
                        var v = c === 'x' ? r : (r & 0x3 | 0x8);
                        return v.toString(16);
                    });
                pendingRequestId = 'receipt_' + uuid;
            }
            return pendingRequestId;
        }
        function resetRequestId() { pendingRequestId = null; }

        function submitForm() {
            if (!validateForm()) return;

            var workOrderNo = $('#workOrderNo').val().trim();
            var assemblySeq = parseInt($('#assemblySeq').val()) || 0;
            var materialCode = $('#materialCode').val().trim();
            var quantity = parseFloat($('#quantity').val()) || 0;
            var unit = $('#unit').val().trim();
            var warehouseCode = $('#warehouseCode').val().trim();
            var location = $('#location').val().trim();
            var batchNo = $('#batchNo').val().trim();

            var requestId = getRequestId();

            showToast(localTexts.submitting, 'info');
            var originalSubmitHtml = $('#submitBtn').html();
            $('#submitBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> ' + localTexts.submitting);

            var formData = new FormData();
            formData.append('WorkOrderNo', workOrderNo);
            formData.append('AssemblySeq', assemblySeq);
            formData.append('MaterialCode', materialCode);
            formData.append('Quantity', quantity);
            if (unit) formData.append('Unit', unit);
            if (warehouseCode) formData.append('WarehouseCode', warehouseCode);
            if (location) formData.append('Location', location);
            if (batchNo) formData.append('BatchNo', batchNo);

            $.ajax({
                url: '/Receipt/ReceiveMfgPart',
                type: 'POST',
                headers: {
                    'X-CSRF-TOKEN': $('input[name="__RequestVerificationToken"]').val(),
                    'X-Request-ID': requestId
                },
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    $('#submitBtn').prop('disabled', false).html(originalSubmitHtml);

                    if (response.success) {
                        // 入库成功
                        resetRequestId();
                        var successMsg = response.message;
                        // 如果有业务警告（如超收提示），追加到成功消息中展示
                        var warningMsg = response.warningMessage || (response.data && response.data.warningMessage);
                        if (warningMsg) {
                            successMsg = successMsg + '\n\n' + warningMsg;
                        }
                        Swal.fire({
                            icon: 'success',
                            title: localTexts.submitSuccess,
                            text: successMsg,
                            confirmButtonText: localTexts.okButton,
                            timer: 3000,
                            timerProgressBar: true
                        });
                        resetAfterSuccess();
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: localTexts.submitFailed,
                            text: response.message,
                            confirmButtonText: localTexts.okButton
                        });
                    }
                },
                error: function (xhr, status, error) {
                    $('#submitBtn').prop('disabled', false).html(originalSubmitHtml);
                    showMessage(localTexts.networkError, 'error');
                }
            });
        }

        function validateForm() {
            let valid = true;

            const workOrder = $('#workOrderNo').val().trim();
            if (!workOrder) {
                $('#workOrderError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.workOrderRequired);
                valid = false;
            } else {
                $('#workOrderError').html('');
            }

            const assemblySeq = $('#assemblySeq').val().trim();
            if (!assemblySeq) {
                $('#assemblySeqError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.assemblySeqRequired);
                valid = false;
            } else {
                $('#assemblySeqError').html('');
            }

            const materialCode = $('#materialCode').val().trim();
            if (!materialCode) {
                $('#materialCodeError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.materialCodeRequired);
                valid = false;
            } else {
                $('#materialCodeError').html('');
            }

            const quantity = parseFloat($('#quantity').val());
            if (!quantity || quantity <= 0) {
                $('#quantityError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.quantityRequired);
                valid = false;
            } else {
                $('#quantityError').html('');
            }

            return valid;
        }

        function resetAfterSuccess() {
            $('#receiptForm')[0].reset();
            $('.error-message').html('');
            $('#jobQtyInfoDisplay').hide();
            jobValidated = false;
            materialValidated = false;
            jobInfoData = null;
            $('#workOrderNo').focus();
        }

        function resetForm() {
            $('#receiptForm')[0].reset();
            $('.error-message').html('');
            $('#workOrderNo, #assemblySeq').val('');
            $('#jobQtyInfoDisplay').hide();
            jobValidated = false;
            materialValidated = false;
            jobInfoData = null;
            $('#workOrderNo').focus();
            showMessage(localTexts.formReset, 'info');
        }

        function clearFormAfterValidationFail() {
            $('#receiptForm')[0].reset();
            $('.error-message').html('');
            $('#jobQtyInfoDisplay').hide();
            jobValidated = false;
            materialValidated = false;
            jobInfoData = null;
            $('#workOrderNo').focus();
        }
    </script>
</body>
</html>