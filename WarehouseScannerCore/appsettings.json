{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Epicor": {
    "BaseUrl": "https://your-epicor-instance.com",
    "TokenUrl": "https://your-epicor-instance.com/api/token",
    "Company": "GCMDG",
    "TokenExpiryMinutes": 480,
    "TokenRefreshAheadMinutes": 5,
    "DefaultTimeoutSeconds": 30,
    "MaxRetries": 1
  },
  "Security": {
    "RateLimiting": {
      "EnableRateLimiting": true,
      "LoginRequestsPerMinute": 10,
      "ApiRequestsPerMinute": 120,
      "QueryRequestsPerMinute": 240,
      "IpWhitelist": []
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  // 反向代理支持：默认 false —— 不信任客户端可伪造的 X-Forwarded-* / X-Real-IP 头。
  // 仅在应用前方存在受信反向代理（Nginx/IIS ARR 等）时设为 true，否则限流与登录日志可能被伪造 IP 绕过/污染。
  "ReverseProxy": {
    "Enabled": false
  },
  // 部署拓扑约束：BusinessLockProvider（业务锁）、限流计数器、Epicor 会话缓存均为进程内状态。
  // 即使配置 Redis 实现 Session 共享，业务锁也无法跨实例生效 —— 当前仅支持单实例部署。
  "Redis": {
    "ConnectionString": null,
    "InstanceName": "WarehouseScanner"
  },
  "_SecretsNote": "Sensitive values (ConnectionStrings, ApiKey, LicenseId, Encryption keys) are injected via environment variables, Kubernetes Secrets, or Azure Key Vault. Never commit them to source control. See README for deployment configuration.",
  // SECURITY: AES 加密密钥禁止写入本文件。生产环境必须通过环境变量 AES_ENCRYPTION_KEY / AES_ENCRYPTION_IV 注入，
  // 缺失时应用会在启动阶段 fail-fast（见 Program.cs 的 EnsureKeyMaterialOrThrow）。
  // 本地开发可在 appsettings.Development.json 中配置，但该值仅限开发使用。
  "AllowedHosts": "*"
}