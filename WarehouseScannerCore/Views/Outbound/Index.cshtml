        function showToast(message, type, duration) {
            if (toastTimer) {
                clearTimeout(toastTimer);
            }
            $('.status-toast').remove();

            var $toast = $('<div class="status-toast ' + type + '">' + escapeHtml(message) + '</div>');
            $('body').append($toast);

            toastTimer = setTimeout(function() {
