@{
    var getText = ViewBag.GetText as Func<string, string, string>;
    var currentCulture = ViewBag.CurrentCulture as string ?? "zh-CN";
    var userId = ViewBag.UserId as string;

    string GetText(string section, string key)
    {
        return getText?.Invoke(section, key) ?? $"[{section}.{key}]";
    }
}

<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>@GetText("Receivin", "Title")</title>

    <link rel="stylesheet" href="~/css/fontawesome/all.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/shared-scanner.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/sweetalert2.css">

    <style>
        @@media (max-width: 768px) {
            .page-header { display: none !important; }
        }
        @@media (min-width: 769px) {
            .page-header { display: block !important; }
        }

        .status-toast {
            position: fixed; bottom: 30px; left: 50%;
            transform: translateX(-50%);
            background: rgba(0,0,0,0.85); color: white;
            padding: 12px 24px; border-radius: 40px;
            font-size: 15px; z-index: 10000;
            max-width: 90%; text-align: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            animation: fadeInUp 0.3s ease; font-weight: 500;
        }
        .status-toast.success { background: #28a745; }
        .status-toast.warning { background: #ffc107; color: #333; }
        .status-toast.info { background: #17a2b8; }
        .status-toast.error { background: #dc3545; }

        @@keyframes fadeInUp {
            from { opacity: 0; transform: translateX(-50%) translateY(20px); }
            to { opacity: 1; transform: translateX(-50%) translateY(0); }
        }

        .status-message { display: none; }

        .po-items-list { margin-top: 10px; }
        .po-item-card {
            border: 1px solid #dee2e6; border-radius: 6px;
            padding: 10px; margin-bottom: 8px; cursor: pointer;
            transition: all 0.2s ease; background: #fff;
        }
        .po-item-card:hover { border-color: #007bff; box-shadow: 0 2px 8px rgba(0,123,255,0.15); }
        .po-item-card.selected { border-color: #007bff; background: #e7f1ff; }
        .po-item-card .item-part { font-weight: 600; color: #212529; }
        .po-item-card .item-desc { color: #6c757d; font-size: 12px; margin: 3px 0; }
        .po-item-card .item-qty { font-size: 12px; color: #495057; }
        .po-item-card .item-qty span { font-weight: 600; color: #007bff; }
        .po-item-card.item-closed { opacity: 0.6; background: #f8f9fa; cursor: not-allowed; }
        .po-item-card.item-closed:hover { border-color: #dee2e6; box-shadow: none; }
    </style>
</head>
<body>
    <div class="container">
        <div class="page-header">
            <h1 class="page-title">
                <i class="fas fa-truck-loading"></i> @GetText("Receivin", "Title")
            </h1>
            <div class="page-subtitle">@GetText("Receivin", "Subtitle")</div>
        </div>

        <div id="statusMessage" class="status-message"></div>

        <div class="form-container">
            <form id="receivinForm" method="post">
                @Html.AntiForgeryToken()

                <div class="button-group">
                    <button type="button" class="btn btn-primary" id="submitBtn">
                        <i class="fas fa-check-circle"></i> @GetText("Receivin", "SubmitButton")
                    </button>
                    <button type="button" class="btn btn-secondary" id="resetBtn">
                        <i class="fas fa-redo-alt"></i> @GetText("Receivin", "ResetButton")
                    </button>
                    <button type="button" class="btn btn-danger" id="cancelBtn">
                        <i class="fas fa-times-circle"></i> @GetText("Receivin", "CancelButton")
                    </button>
                </div>

                <div class="form-grid">
                    <div class="form-item">
                        <label>@GetText("Receivin", "PONo") <span class="required">*</span></label>
                        <div class="input-group">
                            <input type="text"
                                   class="input-field scan-input"
                                   id="poNo"
                                   name="PONo"
                                   placeholder="@GetText("Receivin", "PONoPlaceholder")"
                                   autocomplete="off"
                                   autofocus>
                        </div>
                        <div class="input-hint">
                            <i class="fas fa-barcode"></i> @GetText("Receivin", "POScanPrompt")
                        </div>
                        <div class="error-message" id="poNoError"></div>
                    </div>
                    <div class="form-item">
                        <label>@GetText("Receivin", "POLineNo")</label>
                        <input type="number"
                               class="input-field"
                               id="poLineNo"
                               name="POLineNo"
                               min="1"
                               step="1"
                               placeholder="@GetText("Receivin", "POLineNoPlaceholder")"
                               autocomplete="off">
                        <div class="input-hint">
                            <i class="fas fa-list-ol"></i> @GetText("Receivin", "POLineNoPrompt")
                        </div>
                        <div class="error-message" id="poLineNoError"></div>
                    </div>
                    <div class="form-item">
                        <label>@GetText("Receivin", "PackSlip") <span class="required">*</span></label>
                        <input type="text"
                               class="input-field scan-input"
                               id="packSlip"
                               name="PackSlip"
                               placeholder="@GetText("Receivin", "PackSlipPlaceholder")"
                               autocomplete="off">
                        <div class="input-hint">
                            <i class="fas fa-barcode"></i> @GetText("Receivin", "PackSlipPrompt")
                        </div>
                        <div class="error-message" id="packSlipError"></div>
                    </div>

                    <div id="poItemsList" class="po-items-list" style="display:none;"></div>

                    <div class="form-item">
                        <label>@GetText("Receivin", "MaterialCode") <span class="required">*</span></label>
                        <div class="input-group">
                            <input type="text"
                                   class="input-field scan-input"
                                   id="materialCode"
                                   name="MaterialCode"
                                   placeholder="@GetText("Receivin", "MaterialPlaceholder")"
                                   autocomplete="off">
                        </div>
                        <div class="input-hint">
                            <i class="fas fa-barcode"></i> @GetText("Receivin", "MatScanPrompt")
                        </div>
                        <div class="error-message" id="materialCodeError"></div>
                    </div>

                    <div class="form-item">
                        <label>@GetText("Receivin", "Quantity") <span class="required">*</span></label>
                        <input type="number"
                               class="input-field"
                               id="quantity"
                               name="Quantity"
                               min="0.000001"
                               step="0.000001"
                               placeholder="@GetText("Receivin", "QuantityPlaceholder")"
                               autocomplete="off">
                        <div class="input-hint" id="unreceivedQtyDisplay" style="display:none;color:#dc3545;font-weight:bold;">
                            @GetText("Receivin", "OrderQty"): <span id="orderQtyValue">0</span>
                            @GetText("Receivin", "ReceivedQty"): <span id="receivedQtyValue">0</span>
                            @GetText("Receivin", "UnreceivedQty"): <span id="unreceivedQtyValue">0</span>
                        </div>
                        <div class="error-message" id="quantityError"></div>
                    </div>

                    <div class="form-item">
                        <label>@GetText("Receivin", "Unit") <span class="required">*</span></label>
                        <input type="text"
                               class="input-field"
                               id="unit"
                               name="Unit"
                               autocomplete="off">
                        <div class="error-message" id="unitError"></div>
                    </div>

                    <div class="form-item">
                        <label>@GetText("Receivin", "WarehouseCode") <span class="required">*</span></label>
                        <input type="text"
                               class="input-field"
                               id="warehouseCode"
                               name="WarehouseCode"
                               placeholder="@GetText("Receivin", "WarehousePlaceholder")"
                               autocomplete="off">
                        <div class="error-message" id="warehouseCodeError"></div>
                    </div>

                    <div class="form-item">
                        <label>@GetText("Receivin", "Location") <span class="required">*</span></label>
                        <input type="text"
                               class="input-field"
                               id="location"
                               name="Location"
                               placeholder="@GetText("Receivin", "LocationPlaceholder")"
                               autocomplete="off">
                        <div class="error-message" id="locationError"></div>
                    </div>

                    <div class="form-item">
                        <label>@GetText("Receivin", "BatchNo") <span class="required">*</span></label>
                        <input type="text"
                               class="input-field"
                               id="batchNo"
                               name="BatchNo"
                               placeholder="@GetText("Receivin", "BatchNoPlaceholder")"
                               autocomplete="off">
                        <div class="error-message" id="batchNoError"></div>
                    </div>

                    <div id="operator-section" class="form-item">
                        <label>@GetText("Receivin", "Operator")</label>
                        <input type="text"
                               class="input-field readonly"
                               id="operator"
                               value="@userId"
                               readonly>
                    </div>
                </div>

                <div class="form-item full-width">
                    <label>@GetText("Receivin", "Remarks")</label>
                    <textarea class="input-field"
                              id="remarks"
                              name="Remarks"
                              rows="2"
                              placeholder="@GetText("Receivin", "RemarksPlaceholder")"
                              autocomplete="off"></textarea>
                </div>
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/sweetalert.js"></script>
    <script src="~/js/Scancode-parser.js" asp-append-version="true"></script>

    <script>
        var localTexts = {
            poNoRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "PONoRequired"))),
            packSlipRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "PackSlipRequired"))),
            poLineNoInvalid: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "POLineNoInvalid"))),
            materialCodeRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "MaterialCodeRequired"))),
            quantityRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "QuantityRequired"))),
            unitRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "UnitRequired"))),
            confirmCancel: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "ConfirmCancel"))),
            submitting: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "Submitting"))),
            submitSuccess: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "SubmitSuccess"))),
            submitFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "SubmitFailed"))),
            networkError: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "NetworkError"))),
            formReset: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "FormReset"))),
            commonError: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "CommonError"))),
            confirmButton: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "ConfirmButton"))),
            cancelButtonText: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "CancelButtonText"))),
            okButton: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "OKButton"))),
            poValidated: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "POValidated"))),
            poValidationFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "POValidationFailed"))),
            itemSelected: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "ItemSelected"))),
            warehouseCodeRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "WarehouseCodeRequired"))),
            locationRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "LocationRequired"))),
            batchNoRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "BatchNoRequired"))),
            // JS 内引用的文本键（避免脚本里 GetText 与 localTexts 混用）
            scanParsed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "ScanParsed"))),
            validatingPO: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "ValidatingPO"))),
            submitButton: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Receivin", "SubmitButton")))
        };

        var isProcessing = false;
        var toastTimer = null;
        var poValidated = false;
        var poInfoData = null;
        var selectedPOLine = 0;

        // HTML 转义：动态消息（服务端响应/解析结果）插入 DOM 前统一转义，防止注入（与 CountView 同一实现）
        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str).replace(/&/g, '&amp;')
                              .replace(/</g, '&lt;')
                              .replace(/>/g, '&gt;')
                              .replace(/"/g, '&quot;')
                              .replace(/'/g, '&#039;');
        }

        function showToast(message, type) {
            if (toastTimer) { clearTimeout(toastTimer); }
            $('.status-toast').remove();
            var $toast = $('<div class="status-toast ' + type + '">' + escapeHtml(message) + '</div>');
            $('body').append($toast);
            toastTimer = setTimeout(function() {
                $toast.fadeOut(300, function() { $(this).remove(); });
                toastTimer = null;
            }, 2000);
        }

        function showMessage(message, type) {
            if (type === 'error') {
                Swal.fire({
                    icon: 'error', title: localTexts.commonError, text: message,
                    confirmButtonText: localTexts.okButton, timer: 3000, timerProgressBar: true
                });
            } else {
                showToast(message, type);
            }
        }

        function displayPOInfo(data) {
            if (!data) {
                $('#poItemsList').hide();
                $('#unreceivedQtyDisplay').hide();
                return;
            }

            if (data.availableQty !== undefined && data.availableQty !== null) {
                // 采购数量/已收数量与未收数量同源（ValidatePO 响应），一起渲染
                $('#orderQtyValue').text(data.relQty !== undefined && data.relQty !== null ? data.relQty : 0);
                $('#receivedQtyValue').text(data.receivedQty !== undefined && data.receivedQty !== null ? data.receivedQty : 0);
                $('#unreceivedQtyValue').text(data.availableQty);
                $('#unreceivedQtyDisplay').show();
            } else {
                $('#unreceivedQtyDisplay').hide();
            }

            $('#poItemsList').hide();
        }

        $(document).ready(function () {
            $('#poNo').val('');
            $('#packSlip').val('');

            $('.scan-input').on('change', function () {
                $(this).addClass('scan-highlight');
                setTimeout(() => $(this).removeClass('scan-highlight'), 500);
            });

            $('#poNo').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    handlePOEnter();
                }
            });

            $('#packSlip').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    handlePackSlipEnter();
                }
            });

            $('#poLineNo').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    handlePOLineNoEnter();
                }
            });

            $('#materialCode').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    handleMaterialCodeEnter();
                }
            });

            // 仓库代码 Enter 事件 - 集成 Scancode-parser.js 仓库条码解析
            bindWarehouseScan({
                warehouseInput: '#warehouseCode',
                locationInput: '#location',
                nextFocusInput: '#batchNo',
                fallbackTab: true,
                onParsed: function (data) {
                    // 组合条码回填其他字段（PO→poNo, Part→materialCode, Qty→quantity, UoM→unit, Lot→batchNo）
                    if (data.workOrderNo) $('#poNo').val(data.workOrderNo);
                    if (data.materialCode) $('#materialCode').val(data.materialCode);
                    if (data.quantity) $('#quantity').val(data.quantity);
                    if (data.unit) $('#unit').val(data.unit);
                    if (data.lotNum) $('#batchNo').val(data.lotNum);
                }
            });

            $('.input-field:not(#poNo, #packSlip, #poLineNo, #materialCode, #warehouseCode, .readonly, textarea)').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    var $inputs = $('.input-field:not(.readonly)');
                    var index = $inputs.index(e.target);
                    if (index >= 0 && index < $inputs.length - 1) {
                        $inputs.eq(index + 1).focus().select();
                    }
                }
            });

            $('#submitBtn').on('click', submitForm);
            $('#resetBtn').on('click', resetForm);
            $('#cancelBtn').on('click', function () {
                Swal.fire({
                    title: localTexts.confirmCancel,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: localTexts.confirmButton,
                    cancelButtonText: localTexts.cancelButtonText
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '/Home/Index';
                    }
                });
            });
        });

        function isCombinedScan(input) {
            return input && input.indexOf(':') >= 0 && input.indexOf(';') >= 0;
        }

        function parseCombinedScan(input) {
            var result = {
                poNo: '', poLineNo: '', packSlip: '',
                partNum: '', lotNum: '', qty: '', uom: '',
                warehouse: '', location: '', remarks: ''
            };

            var pairs = input.split(';');
            for (var i = 0; i < pairs.length; i++) {
                var pair = pairs[i].trim();
                if (!pair) continue;

                var colonIdx = pair.indexOf(':');
                if (colonIdx < 0) continue;

                var key = pair.substring(0, colonIdx).trim().toLowerCase();
                var value = pair.substring(colonIdx + 1).trim();

                switch (key) {
                    case 'po':
                    case 'pono':
                    case 'ponum':
                    case 'po no':
                    case 'order':
                        result.poNo = value;
                        break;
                    case 'poline':
                    case 'polineno':
                    case 'poline no':
                    case 'line':
                    case 'lineno':
                    case 'line no':
                    case 'po line':
                        result.poLineNo = value;
                        break;
                    case 'packingslip':
                    case 'packslip':
                    case 'packing':
                    case 'slip':
                    case 'packing slip':
                        result.packSlip = value;
                        break;
                    case 'partnum':
                    case 'part':
                    case 'material':
                    case 'materialcode':
                    case 'mat':
                        result.partNum = value;
                        break;
                    case 'lotnum':
                    case 'lot':
                    case 'batch':
                    case 'batchno':
                    case 'lot no':
                        result.lotNum = value;
                        break;
                    case 'qty':
                    case 'quantity':
                    case 'qtyty':
                        result.qty = value;
                        break;
                    case 'uom':
                    case 'unit':
                    case 'u o m':
                        result.uom = value;
                        break;
                    case 'warehouse':
                    case 'warehousecode':
                    case 'warehousedesc':
                    case 'washouse':
                    case 'wh':
                    case 'whcode':
                        result.warehouse = value;
                        break;
                    case 'location':
                    case 'bin':
                    case 'binno':
                    case 'binnum':
                    case 'locationcode':
                        result.location = value;
                        break;
                    case 'remarks':
                    case 'remark':
                    case 'note':
                    case 'notes':
                        result.remarks = value;
                        break;
                }
            }

            return result;
        }

        function applyParsedScan(parsed) {
            if (parsed.poNo) $('#poNo').val(parsed.poNo);
            if (parsed.poLineNo) $('#poLineNo').val(parsed.poLineNo);
            if (parsed.packSlip) $('#packSlip').val(parsed.packSlip);
            if (parsed.partNum) $('#materialCode').val(parsed.partNum);
            if (parsed.lotNum) $('#batchNo').val(parsed.lotNum);
            if (parsed.qty) $('#quantity').val(parsed.qty);
            if (parsed.uom) $('#unit').val(parsed.uom);
            if (parsed.warehouse) $('#warehouseCode').val(parsed.warehouse);
            if (parsed.location) $('#location').val(parsed.location);
            if (parsed.remarks) $('#remarks').val(parsed.remarks);
        }

        function handlePOEnter() {
            if (isProcessing) return;
            isProcessing = true;

            var rawInput = $('#poNo').val().trim();
            if (!rawInput) {
                isProcessing = false;
                showMessage(localTexts.poNoRequired, 'warning');
                $('#poNo').focus();
                return;
            }

            // Check if this is a combined scan string
            if (isCombinedScan(rawInput)) {
                var parsed = parseCombinedScan(rawInput);
                applyParsedScan(parsed);
                showToast(localTexts.scanParsed + '...', 'info');

                // If PO number was found, auto-validate it
                if (parsed.poNo) {
                    $('#poNo').val(parsed.poNo);
                    // F-3（组合扫码分支补齐）：组合条码可能未携带行号，此时若直接发起 ValidatePO，
                    //      后端会以 POLine=0 查询 BAQ 命中任意行、返回错误行数据，且直到提交才被拒绝。
                    //      与手动扫码分支保持一致，强制行号 > 0 再发起校验。
                    var combinedPoLine = parseInt($('#poLineNo').val()) || 0;
                    if (!combinedPoLine || combinedPoLine <= 0) {
                        isProcessing = false;
                        showMessage(localTexts.poLineNoInvalid, 'warning');
                        $('#poLineNo').focus().select();
                        return;
                    }
                    // Auto-trigger PO validation（校验成功后由该方法自行把焦点移到 packSlip/物料，此处不提前聚焦）
                    validatePOAfterCombinedScan(parsed);
                    return;
                }
                isProcessing = false;
                return;
            }

            var poNo = $('#poNo').val().trim();
            if (!poNo) {
                isProcessing = false;
                showMessage(localTexts.poNoRequired, 'warning');
                $('#poNo').focus();
                return;
            }

            // poLineNo=0 时 BAQ 会返回任意行，用户无感知：
            //      前端必须强制用户输入或选择行号，否则不发起 ValidatePO。
            var poLineNo = parseInt($('#poLineNo').val()) || 0;
            if (!poLineNo || poLineNo <= 0) {
                isProcessing = false;
                showMessage(localTexts.poLineNoInvalid, 'warning');
                $('#poLineNo').focus();
                return;
            }

            var partNum = $('#materialCode').val().trim();
            var quantity = parseFloat($('#quantity').val()) || 0;

            showToast(localTexts.validatingPO + '...', 'info');

            $.ajax({
                url: '/Receivin/ValidatePO',
                type: 'POST',
                contentType: 'application/json',
                headers: { 'X-CSRF-TOKEN': $('input[name="__RequestVerificationToken"]').val() },
                data: JSON.stringify({
                    PONum: poNo,
                    POLine: poLineNo,
                    PartNum: partNum,
                    Quantity: quantity,
                    Unit: $('#unit').val().trim(),
                    WarehouseCode: $('#warehouseCode').val().trim(),
                    Location: $('#location').val().trim()
                }),
                success: function (response) {
                    isProcessing = false;
                    if (response.success) {
                        poValidated = true;
                        poInfoData = response.data;
                        displayPOInfo(response.data);

                        // 自动填充后端返回的默认仓库和库位
                        if (response.data.warehouseCode) {
                            $('#warehouseCode').val(response.data.warehouseCode);
                        }
                        if (response.data.binNum) {
                            $('#location').val(response.data.binNum);
                        }

                        showToast(response.message || localTexts.poValidated, 'success');
                        // 超收提示：Epicor 允许超收，弹警告让操作员确认，确认后可直接提交收货
                        if (response.data && response.data.overReceipt) {
                            Swal.fire({ icon: 'warning', text: response.data.overReceiptWarning, confirmButtonText: localTexts.okButton });
                        }
                        setTimeout(() => $('#packSlip').focus().select(), 100);
                    } else {
                        poValidated = false;
                        poInfoData = null;
                        displayPOInfo(null);
                        // 单位不一致：不清空表单（保留已录入的 PO/物料/数量），
                        // 仅提示并将光标定位到单位框，供操作员核对后重扫
                        if (response.unitMismatch) {
                            showMessage(response.message || localTexts.poValidationFailed, 'error');
                            setTimeout(() => $('#unit').focus().select(), 100);
                        } else if (response.poNotFound) {
                            // PO 不存在或无待收货明细行：整单无效，清空所有录入框，便于重扫新 PO
                            showMessage(response.message || localTexts.poValidationFailed, 'error');
                            clearAllInputs();
                        } else {
                            // 非单位类业务校验失败：不清空表单，仅将收货数量重置为 0，
                            // 保留已录入的采购单号/物料/仓库等，供操作员调整后重新提交（防止已扫数据丢失）
                            $('#quantity').val(0);
                            showMessage(response.message || localTexts.poValidationFailed, 'error');
                            setTimeout(() => $('#quantity').focus().select(), 100);
                        }
                    }
                },
                error: function (xhr, status, error) {
                    isProcessing = false;
                    // 网络瞬断不应清空表单——用户已扫的 PO/物料/数量全没，需重新扫码。
                    //      仅提示重试，保留已填字段。
                    showMessage(localTexts.networkError, 'error');
                }
            });
        }

        function validatePOAfterCombinedScan(parsed) {
            var poNo = parsed.poNo;
            if (!poNo) return;

            showToast(localTexts.validatingPO + '...', 'info');

            // 行号以输入框为准（applyParsedScan 已把组合条码中的行号写入 #poLineNo），
            // 与手动分支共用同一取值口径，避免行号来源不一致导致漏校验。
            var poLineNo = parseInt($('#poLineNo').val()) || 0;
            var partNum = parsed.partNum || '';
            var quantity = parsed.qty ? parseFloat(parsed.qty) : 0;

            $.ajax({
                url: '/Receivin/ValidatePO',
                type: 'POST',
                contentType: 'application/json',
                headers: { 'X-CSRF-TOKEN': $('input[name="__RequestVerificationToken"]').val() },
                data: JSON.stringify({
                    PONum: poNo,
                    POLine: poLineNo,
                    PartNum: partNum,
                    Quantity: quantity,
                    Unit: $('#unit').val().trim(),
                    WarehouseCode: $('#warehouseCode').val().trim(),
                    Location: $('#location').val().trim()
                }),
                success: function (response) {
                    isProcessing = false;
                    if (response.success) {
                        poValidated = true;
                        poInfoData = response.data;
                        displayPOInfo(response.data);

                        // 自动填充后端返回的默认仓库和库位
                        if (response.data.warehouseCode) {
                            $('#warehouseCode').val(response.data.warehouseCode);
                        }
                        if (response.data.binNum) {
                            $('#location').val(response.data.binNum);
                        }

                        showToast(response.message || localTexts.poValidated, 'success');
                        // 超收提示：Epicor 允许超收，弹警告让操作员确认，确认后可直接提交收货
                        if (response.data && response.data.overReceipt) {
                            Swal.fire({ icon: 'warning', text: response.data.overReceiptWarning, confirmButtonText: localTexts.okButton });
                        }

                        // Auto-fill remaining fields from PO BAQ result if they were in the scan
                        if (parsed.poLineNo) {
                            $('#poLineNo').val(parsed.poLineNo);
                        }
                        if (parsed.partNum) $('#materialCode').val(parsed.partNum);
                        if (parsed.uom) $('#unit').val(parsed.uom);
                        if (parsed.warehouse) $('#warehouseCode').val(parsed.warehouse);
                        if (parsed.location) $('#location').val(parsed.location);
                        if (parsed.lotNum) $('#batchNo').val(parsed.lotNum);

                        // Auto-fill available qty from BAQ result (only if not scanned quantity)
                        // 允许超收后 availableQty 可能为 0 或负数（已收满/已超收），此时不自动填充，由操作员手输
                        if (!parsed.qty && response.data && response.data.availableQty > 0) {
                            $('#quantity').val(response.data.availableQty);
                        }

                        // 跳转顺序：已扫到 packSlip → 跳到 materialCode（packSlip 已填）；
                        //      未扫到 packSlip → 跳到 packSlip 让用户补填。
                        if (parsed.packSlip) {
                            setTimeout(function() { $('#materialCode').focus().select(); }, 100);
                        } else {
                            setTimeout(function() { $('#packSlip').focus().select(); }, 100);
                        }
                    } else {
                        poValidated = false;
                        poInfoData = null;
                        displayPOInfo(null);
                        // 单位不一致：不清空表单（保留已录入的 PO/物料/数量），
                        // 仅提示并将光标定位到单位框，供操作员核对后重扫
                        if (response.unitMismatch) {
                            showMessage(response.message || localTexts.poValidationFailed, 'error');
                            setTimeout(() => $('#unit').focus().select(), 100);
                        } else if (response.poNotFound) {
                            // PO 不存在或无待收货明细行：整单无效，清空所有录入框，便于重扫新 PO
                            showMessage(response.message || localTexts.poValidationFailed, 'error');
                            clearAllInputs();
                        } else {
                            // 非单位类业务校验失败：不清空表单，仅将收货数量重置为 0，
                            // 保留已录入的采购单号/物料/仓库等，供操作员调整后重新提交（防止已扫数据丢失）
                            $('#quantity').val(0);
                            showMessage(response.message || localTexts.poValidationFailed, 'error');
                            setTimeout(() => $('#quantity').focus().select(), 100);
                        }
                    }
                },
                error: function (xhr, status, error) {
                    isProcessing = false;
                    // 网络瞬断不清空表单，仅提示重试
                    showMessage(localTexts.networkError, 'error');
                }
            });
        }

        function handlePackSlipEnter() {
            if (isProcessing) return;
            isProcessing = true;

            try {
                var packSlip = $('#packSlip').val().trim();
                if (!packSlip) {
                    showMessage(localTexts.packSlipRequired, 'warning');
                    $('#packSlip').focus();
                    return;
                }
                setTimeout(() => $('#poLineNo').focus().select(), 100);
            } finally {
                isProcessing = false;
            }
        }

        function handlePOLineNoEnter() {
            if (isProcessing) return;
            isProcessing = true;

            try {
                var poLineNoVal = $('#poLineNo').val().trim();
                if (poLineNoVal) {
                    var lineNo = parseInt(poLineNoVal);
                    if (!lineNo || lineNo <= 0) {
                        $('#poLineNoError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.poLineNoInvalid);
                        setTimeout(() => $('#poLineNoError').html(''), 3000);
                    } else {
                        selectedPOLine = lineNo;
                    }
                }
                // 后端 ValidatePO 仅返回单行信息（无 items 数组），
                // 此处不从 items 列表回填，仅跳焦到 materialCode
                setTimeout(() => $('#materialCode').focus().select(), 100);
            } finally {
                isProcessing = false;
            }
        }

        function handleMaterialCodeEnter() {
            if (isProcessing) return;
            isProcessing = true;

            try {
                var materialCode = $('#materialCode').val().trim();
                if (!materialCode) {
                    showMessage(localTexts.materialCodeRequired, 'warning');
                    $('#materialCode').focus();
                    return;
                }
                setTimeout(() => $('#quantity').focus().select(), 100);
            } finally {
                isProcessing = false;
            }
        }

        // 一次提交尝试内固定 ID：失败/超时重试复用同一 ID（服务端据此拦截重复过账），成功后重置。
        var pendingRequestId = null;
        function getRequestId() {
            if (!pendingRequestId) {
                var uuid = (window.crypto && typeof crypto.randomUUID === 'function')
                    ? crypto.randomUUID()
                    : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
                        var r = Math.random() * 16 | 0;
                        var v = c === 'x' ? r : (r & 0x3 | 0x8);
                        return v.toString(16);
                    });
                pendingRequestId = 'poreceipt_' + uuid;
            }
            return pendingRequestId;
        }
        function resetRequestId() { pendingRequestId = null; }

        function submitForm() {
            if (isProcessing) return;
            if (!validateForm()) return;
            isProcessing = true;

            var poNo = $('#poNo').val().trim();
            var packSlip = $('#packSlip').val().trim();
            var poLineNo = parseInt($('#poLineNo').val()) || 0;
            var materialCode = $('#materialCode').val().trim();
            var quantity = parseFloat($('#quantity').val()) || 0;
            var unit = $('#unit').val().trim();
            var warehouseCode = $('#warehouseCode').val().trim();
            var location = $('#location').val().trim();
            var batchNo = $('#batchNo').val().trim();

            showToast(localTexts.submitting, 'info');
            var originalSubmitHtml = $('#submitBtn').html();
            $('#submitBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> ' + localTexts.submitting);

            // 每次提交尝试复用同一幂等标识：失败 / 网络重试不会造成重复收货，成功后重置
            var requestId = getRequestId();

            var requestData = {
                RequestId: requestId,
                PONum: poNo,
                PackSlip: packSlip,
                POLine: poLineNo || selectedPOLine,
                PartNum: materialCode,
                Quantity: quantity,
                Unit: unit,
                WarehouseCode: warehouseCode,
                Location: location,
                BatchNo: batchNo
            };

            $.ajax({
                url: '/Receivin/CompleteReceipt',
                type: 'POST',
                contentType: 'application/json',
                headers: {
                    'X-CSRF-TOKEN': $('input[name="__RequestVerificationToken"]').val(),
                    'X-Request-ID': requestId
                },
                data: JSON.stringify(requestData),
                success: function (response) {
                    isProcessing = false;
                    $('#submitBtn').prop('disabled', false).html(originalSubmitHtml);

                    if (response.success) {
                        resetRequestId();
                        // 超收等 BO 警告：收货已成功，成功提示确认后再补一条警告，确保操作员看到
                        if (response.warning) {
                            Swal.fire({
                                icon: 'success',
                                title: localTexts.submitSuccess,
                                text: response.message,
                                confirmButtonText: localTexts.okButton
                            }).then(function () {
                                Swal.fire({ icon: 'warning', text: response.warning, confirmButtonText: localTexts.okButton });
                            });
                        } else {
                            Swal.fire({
                                icon: 'success',
                                title: localTexts.submitSuccess,
                                text: response.message,
                                confirmButtonText: localTexts.okButton,
                                timer: 3000,
                                timerProgressBar: true
                            });
                        }
                        resetAfterSuccess();
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: localTexts.submitFailed,
                            text: response.message,
                            confirmButtonText: localTexts.okButton
                        });
                        // 提交时 PO 行已不存在或无待收货明细（如校验后 PO 被关闭）：清空所有录入框重新开始
                        if (response.poNotFound) {
                            clearAllInputs();
                        }
                    }
                },
                error: function (xhr, status, error) {
                    isProcessing = false;
                    $('#submitBtn').prop('disabled', false).html(originalSubmitHtml);
                    showMessage(localTexts.networkError, 'error');
                }
            });
        }

        function validateForm() {
            var valid = true;

            var poNo = $('#poNo').val().trim();
            if (!poNo) {
                $('#poNoError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.poNoRequired);
                valid = false;
            } else {
                $('#poNoError').html('');
            }

            // F-3（提交侧补齐）：后端 CompleteReceipt 要求 POLine >= 1，
            //      原 validateForm 未校验行号，操作员清空行号会直到提交时才被后端拒绝。
            var poLineNo = parseInt($('#poLineNo').val()) || 0;
            if (!poLineNo || poLineNo <= 0) {
                $('#poLineNoError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.poLineNoInvalid);
                valid = false;
            } else {
                $('#poLineNoError').html('');
            }

            var packSlip = $('#packSlip').val().trim();
            if (!packSlip) {
                $('#packSlipError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.packSlipRequired);
                valid = false;
            } else {
                $('#packSlipError').html('');
            }

            var materialCode = $('#materialCode').val().trim();
            if (!materialCode) {
                $('#materialCodeError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.materialCodeRequired);
                valid = false;
            } else {
                $('#materialCodeError').html('');
            }

            var quantity = parseFloat($('#quantity').val());
            if (!quantity || quantity <= 0) {
                $('#quantityError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.quantityRequired);
                valid = false;
            } else {
                $('#quantityError').html('');
            }

            var unit = $('#unit').val().trim();
            if (!unit) {
                $('#unitError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.unitRequired);
                valid = false;
            } else {
                $('#unitError').html('');
            }

            var warehouseCode = $('#warehouseCode').val().trim();
            if (!warehouseCode) {
                $('#warehouseCodeError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.warehouseCodeRequired);
                valid = false;
            } else {
                $('#warehouseCodeError').html('');
            }

            var location = $('#location').val().trim();
            if (!location) {
                $('#locationError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.locationRequired);
                valid = false;
            } else {
                $('#locationError').html('');
            }

            var batchNo = $('#batchNo').val().trim();
            if (!batchNo) {
                $('#batchNoError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.batchNoRequired);
                valid = false;
            } else {
                $('#batchNoError').html('');
            }

            return valid;
        }

        // 清空所有录入框并复位页面状态（收货成功后 / PO 不存在或无待收货明细行时复用）
        function clearAllInputs() {
            $('#receivinForm')[0].reset();
            $('.error-message').html('');
            $('#poItemsList').hide();
            $('#unreceivedQtyDisplay').hide();
            poValidated = false;
            poInfoData = null;
            selectedPOLine = 0;
            $('#poNo').focus().select();
        }

        function resetAfterSuccess() {
            clearAllInputs();
        }

        function resetForm() {
            $('#receivinForm')[0].reset();
            $('.error-message').html('');
            $('#poItemsList').hide();
            $('#unreceivedQtyDisplay').hide();
            poValidated = false;
            poInfoData = null;
            selectedPOLine = 0;
            $('#poNo').focus();
            showMessage(localTexts.formReset, 'info');
        }
    </script>
</body>
</html>
