        /**
         * 从 AJAX 失败响应中提取后端返回的错误文案。
         * 依次尝试：JSON 体 message → 纯文本响应体（HTML 会被剥离标签并截断）→ HTTP 状态码。
         * 参数 xhr：jQuery 的 jqXHR 对象
         * 返回：可直接展示给操作员的错误文案；无可用信息时返回空串
         */
        function extractServerError(xhr) {
            if (!xhr) return '';

            var data = xhr.responseJSON;
            if (data && data.message) return String(data.message);
            if (data && data.title) return String(data.title);

            var raw = xhr.responseText;
            if (raw) {
                var text = String(raw).replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
                if (text) return text.length > 300 ? text.substring(0, 300) + '...' : text;
            }

            if (xhr.status) {
                return 'HTTP ' + xhr.status + (xhr.statusText ? ' ' + xhr.statusText : '');
            }
            return '';
        }

