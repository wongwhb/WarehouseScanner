@model WarehouseScannerCore.ViewModels.IssueIndexViewModel
@{
    // 从ViewBag获取数据
    var getText = ViewBag.GetText as Func<string, string, string>;
    var currentCulture = ViewBag.CurrentCulture as string ?? "zh-CN";

    // 获取用户信息
    var userId = ViewBag.UserId as string;

    // 定义本地辅助函数
    string GetText(string section, string key)
    {
        return getText?.Invoke(section, key) ?? $"[{section}.{key}]";
    }
}

<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>@GetText("MaterialIssue", "Title")</title>

    <!-- 外部样式表 -->
    <link rel="stylesheet" href="~/css/fontawesome/all.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/shared-scanner.css" asp-append-version="true">
    <!-- SweetAlert2 CSS -->
    <link rel="stylesheet" href="~/css/sweetalert2.css">

    <!-- 页面特有样式 -->
    <style>
        #debugPanel {
            position: fixed;
            top: 10px;
            right: 10px;
            width: 300px;
            max-height: 400px;
            overflow: auto;
            background: rgba(0,0,0,0.8);
            color: #0f0;
            font-family: monospace;
            font-size: 12px;
            padding: 10px;
            border-radius: 5px;
            z-index: 9999;
            border: 1px solid #0f0;
        }

            #debugPanel h3 {
                margin: 0 0 10px;
                color: #fff;
            }

        #debugLog {
            margin-bottom: 10px;
        }

            #debugLog > div {
                border-bottom: 1px solid #333;
                padding: 4px 0;
            }

        /* 手机端隐藏页面标题的样式 */
        @@media (max-width: 768px) {
            .page-header {
                display: none !important;
            }
        }

        /* 非手机端显示页面标题的样式（默认显示，无需额外设置） */
        @@media (min-width: 769px) {
            .page-header {
                display: block !important;
            }
        }

        /* ========== 底部Toast提示样式 ========== */
        .status-toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0,0,0,0.85);
            color: white;
            padding: 12px 24px;
            border-radius: 40px;
            font-size: 15px;
            z-index: 10000;
            max-width: 90%;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            animation: fadeInUp 0.3s ease;
            font-weight: 500;
        }

            .status-toast.success {
                background: #28a745;
            }

            .status-toast.warning {
                background: #ffc107;
                color: #333;
            }

            .status-toast.info {
                background: #17a2b8;
            }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateX(-50%) translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }
        }

        /* 隐藏原来的状态消息区域 */
        .status-message {
            display: none;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- 页面标题 -->
        <div class="page-header">
            <h1 class="page-title">
                <i class="fas fa-box-open"></i> @GetText("MaterialIssue", "Title")
            </h1>
        </div>

        <!-- 状态消息 -->
        <div id="statusMessage" class="status-message"></div>

        <!-- 主表单区域 -->
        <div class="form-container">
            <form id="issueForm" method="post" asp-action="IssueMaterial">
                @Html.AntiForgeryToken()
                <!-- 按钮组 -->
                <div class="button-group">
                    <button type="submit" class="btn btn-primary" id="submitBtn">
                        <i class="fas fa-paper-plane"></i> @GetText("MaterialIssue", "SubmitButton")
                    </button>
                    <button type="button" class="btn btn-secondary" id="resetBtn">
                        <i class="fas fa-redo"></i> @GetText("MaterialIssue", "ResetButton")
                    </button>
                    <button type="button" class="btn btn-danger" id="cancelBtn">
                        <i class="fas fa-times-circle"></i> @GetText("MaterialIssue", "CancelButton")
                    </button>
                </div>

                <!-- 表单网格布局 -->
                <div class="form-grid">
                    <!-- 工单号 -->
                    <div class="form-item">
                        <label>
                            @GetText("MaterialIssue", "WorkOrderNo") <span class="required">*</span>
                        </label>
                        <div class="input-group">
                            <input type="text"
                                   class="input-field scan-input"
                                   id="workOrderNo"
                                   name="WorkOrderNo"
                                   placeholder="@GetText("MaterialIssue", "WorkOrderPlaceholder")"
                                   autocomplete="off"
                                   autocorrect="off"
                                   autocapitalize="none"
                                   inputmode="text"
                                   autofocus>
                        </div>
                        <div class="input-hint">
                            <i class="fas fa-keyboard"></i> @GetText("MaterialIssue", "JobScanPromptMessage")
                        </div>
                        <div class="parse-status" id="parseStatus"></div>
                        <div class="error-message" id="workOrderError"></div>
                    </div>

                    <!-- 装配序号 -->
                    <div class="form-item">
                        <label>@GetText("MaterialIssue", "AssemblySeq")<span class="required">*</span></label>
                        <input type="text"
                               class="input-field"
                               id="assemblySeq"
                               name="AssemblySeq"
                               placeholder="@GetText("MaterialIssue", "AssemblySeqPlaceholder")"
                               autocomplete="off"
                               autocorrect="off"
                               autocapitalize="none"
                               inputmode="text">
                        
                        <div class="error-message" id="assemblySeqError"></div>
                    </div>

                    <!-- 物料编号 -->
                    <div class="form-item">
                        <label>
                            @GetText("MaterialIssue", "MaterialCode") <span class="required">*</span>
                        </label>
                        <div class="input-group">
                            <input type="text"
                                   class="input-field scan-input"
                                   id="materialCode"
                                   name="MaterialCode"
                                   placeholder="@GetText("MaterialIssue", "MaterialPlaceholder")"
                                   autocomplete="off"
                                   autocorrect="off"
                                   autocapitalize="none"
                                   inputmode="text">
                        </div>
                        <div class="input-hint">
                            <i class="fas fa-keyboard"></i> @GetText("MaterialIssue", "MatScanPromptMessage")
                        </div>
                        <div class="error-message" id="materialCodeError"></div>
                    </div>

                    <!-- 数量 -->
                    <div class="form-item">
                        <label>
                            @GetText("MaterialIssue", "Quantity") <span class="required">*</span>
                        </label>
                        <input type="number"
                               class="input-field"
                               id="quantity"
                               name="Quantity"
                               min="0.000001"
                               step="0.000001"
                               placeholder="@GetText("MaterialIssue", "QuantityPlaceholder")"
                               autocomplete="off"
                               autocorrect="off"
                               autocapitalize="none"
                               inputmode="numeric">
                        <div id="qtyInfoDisplay" style="margin-top: 5px; font-size: 14px;">
                            @GetText("MaterialIssue", "IssueQty"): <span id="issueQtyValue" style="color: green; font-weight: bold;">--</span>
                            &nbsp;&nbsp;
                            @GetText("MaterialIssue", "IssuedQty"): <span id="issuedQtyValue" style="color: orange; font-weight: bold;">--</span>
                            &nbsp;&nbsp;
                            @GetText("MaterialIssue", "UnissuedQty"): <span id="unissuedQtyValue" style="color: red; font-weight: bold;">--</span>
                            &nbsp;&nbsp;
                            @GetText("MaterialIssue", "AvailableQty"): <span id="availableQtyValue" style="color: blue; font-weight: bold;">--</span>
                        </div>
                        <div class="error-message" id="quantityError"></div>
                    </div>
                    
                    <!-- 单位 -->
                    <div class="form-item">
                        <label>@GetText("MaterialIssue", "Unit")</label>
                        <input type="text"
                               class="input-field"
                               id="Unit"
                               name="Unit"
                               autocomplete="off"
                               autocorrect="off"
                               autocapitalize="none"
                               inputmode="text">
                    </div>

                    <!-- 仓库代码 -->
                    <div class="form-item">
                        <label>@GetText("MaterialIssue", "WarehouseCode")</label>
                        <input type="text"
                               class="input-field"
                               id="warehouseCode"
                               name="FromWarehouse"
                               autocomplete="off"
                               autocorrect="off"
                               autocapitalize="none"
                               inputmode="text">
                    </div>

                    <!-- 库位 -->
                    <div class="form-item">
                        <label>@GetText("MaterialIssue", "Location")</label>
                        <input type="text"
                               class="input-field"
                               id="location"
                               name="Location"
                               placeholder="@GetText("MaterialIssue", "LocationPlaceholder")"
                               autocomplete="off"
                               autocorrect="off"
                               autocapitalize="none"
                               inputmode="text">
                    </div>

                    <!-- 批次号 -->
                    <div class="form-item">
                        <label>@GetText("MaterialIssue", "BatchNo")</label>
                        <input type="text"
                               class="input-field"
                               id="batchNo"
                               name="BatchNo"
                               placeholder="@GetText("MaterialIssue", "BatchNoPlaceholder")"
                               autocomplete="off"
                               autocorrect="off"
                               autocapitalize="none"
                               inputmode="text">
                    </div>

                    <!-- 操作员 -->
                    <div id="operator-section" class="form-item">
                        <label>@GetText("MaterialIssue", "Operator")</label>
                        <input type="text"
                               class="input-field readonly"
                               id="operator"
                               value="@userId"
                               readonly>
                    </div>
                </div>

                <!-- 备注（全宽） -->
                <div class="form-item full-width">
                    <label>@GetText("MaterialIssue", "Remarks")</label>
                    <textarea class="input-field"
                              id="remarks"
                              name="Remarks"
                              rows="2"
                              placeholder="@GetText("MaterialIssue", "RemarksPlaceholder")"
                              autocomplete="off"
                              autocorrect="off"
                              autocapitalize="none"></textarea>
                </div>
            </form>
        </div>
    </div>

    <!-- JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/Scancode-parser.js" asp-append-version="true"></script>
    <!-- SweetAlert2 JS -->
    <script src="~/js/sweetalert.js"></script>

    <script>
        // 本地化文本配置
        var localTexts = {
            workOrderRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "WorkOrderRequired"))),
            materialCodeRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "MaterialCodeRequired"))),
            quantityRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "QuantityRequired"))),
            confirmCancel: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "ConfirmCancel"))),
            loadingOrder: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "LoadingOrder"))),
            loadOrderSuccess: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "LoadOrderSuccess"))),
            loadOrderFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "LoadOrderFailed"))),
            scanPrompt: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "ScanPromptMessage"))),
            submitting: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "Submitting"))),
            submitSuccess: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "SubmitSuccess"))),
            submitFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "SubmitFailed"))),
            networkError: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "NetworkError"))),
            assemblySeqRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "AssemblySeqRequired"))),
            // 新增的本地化文本
            barcodeParseSuccess: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "BarcodeParseSuccess"))),
            barcodeParseFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "BarcodeParseFailed"))),
            parserReady: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "ParserReady"))),
            parserInitFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "ParserInitFailed"))),
            jobBarcodeParseSuccess: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "JobBarcodeParseSuccess"))),
            materialBarcodeParseSuccess: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "MaterialBarcodeParseSuccess"))),
            pleaseEnterAssemblySeq: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "PleaseEnterAssemblySeq"))),
            jobValidationPassed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "JobValidationPassed"))),
            jobValidationFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "JobValidationFailed"))),
            inventoryValidationPassed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "InventoryValidationPassed"))),
            inventoryValidationFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "InventoryValidationFailed"))),
            jobAndAssemblyRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "JobAndAssemblyRequired"))),
            materialCodeRequiredMsg: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "MaterialCodeRequiredMsg"))),
            formReset: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "FormReset"))),
            processingPleaseWait: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "ProcessingPleaseWait"))),
            scanBarcodePrompt: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "ScanBarcodePrompt"))),
            confirmButton: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Common", "Confirm"))),
            cancelButtonText: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Common", "Cancel"))),
            okButton: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Common", "OK"))),
            commonError: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "CommonError"))),
            assemblySeqMustBeNumber: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("MaterialIssue", "AssemblySeqMustBeNumber")))
        };

        // 全局变量
        let barcodeParser = null;
        let isProcessing = false;
        let workOrderDebounceTimer = null;
        let materialCodeDebounceTimer = null;
        let toastTimer = null;

        // 检查是否为手机设备
        function isMobileDevice() {
            return window.innerWidth <= 768;
        }

        // HTML 转义：动态消息（服务端响应/解析结果）插入 DOM 前统一转义，防止注入（与 CountView 同一实现）
        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str).replace(/&/g, '&amp;')
                              .replace(/</g, '&lt;')
                              .replace(/>/g, '&gt;')
                              .replace(/"/g, '&quot;')
                              .replace(/'/g, '&#039;');
        }

        // 显示底部Toast提示（非错误消息使用）
        function showToast(message, type) {
            if (toastTimer) {
                clearTimeout(toastTimer);
            }
            $('.status-toast').remove();

            var $toast = $('<div class="status-toast ' + type + '">' + escapeHtml(message) + '</div>');
            $('body').append($toast);

            toastTimer = setTimeout(function() {
                $toast.fadeOut(300, function() {
                    $(this).remove();
                });
                toastTimer = null;
            }, 2000);
        }

        $(document).ready(function () {
            // 进入页面时清空工单号和装配序号
            $('#workOrderNo').val('');
            $('#assemblySeq').val('');

            // 初始化条码解析器
            initializeBarcodeParser();

            // 输入框扫描高亮效果
            $('.scan-input').on('change', function () {
                $(this).addClass('scan-highlight');
                setTimeout(() => $(this).removeClass('scan-highlight'), 500);
            });

            // 工单号文本框 Enter 事件（带防抖）
            $('#workOrderNo').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    debounceHandleWorkOrderEnter();
                }
            });

            // 物料代码文本框 Enter 事件（带防抖）
            $('#materialCode').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    debounceHandleMaterialCodeEnter();
                }
            });

            // 仓库代码 Enter 事件 - 集成 Scancode-parser.js 仓库条码解析
            bindWarehouseScan({
                warehouseInput: '#warehouseCode',
                locationInput: '#location',
                nextFocusInput: '#batchNo',
                fallbackTab: true
            });

            // 其他文本框 Enter 键切换字段
            $('.input-field:not(#workOrderNo, #materialCode, #warehouseCode, .readonly, textarea)').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    var $inputs = $('.input-field:not(.readonly)');
                    var index = $inputs.index(e.target);
                    if (index >= 0 && index < $inputs.length - 1) {
                        $inputs.eq(index + 1).focus().select();
                    }
                }
            });

            // 键盘快捷键支持
            $(document).on('keydown', function (e) {
                if (e.key === 'F1') {
                    e.preventDefault();
                    debounceHandleWorkOrderEnter();
                }
                if (e.key === 'F2') {
                    e.preventDefault();
                    debounceHandleMaterialCodeEnter();
                }
                if (e.key === 'F3') {
                    e.preventDefault();
                    resetForm();
                }
                if (e.key === 'Escape') {
                    Swal.fire({
                        title: localTexts.confirmCancel,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: localTexts.confirmButton,
                        cancelButtonText: localTexts.cancelButtonText
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '/Home/Index';
                        }
                    });
                }
            });

            // 表单提交
            $('#issueForm').on('submit', function (e) {
                e.preventDefault();
                submitIssueForm();
            });

            // 重置按钮
            $('#resetBtn').on('click', resetForm);

            // 取消按钮
            $('#cancelBtn').on('click', function () {
                Swal.fire({
                    title: localTexts.confirmCancel,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: localTexts.confirmButton,
                    cancelButtonText: localTexts.cancelButtonText
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '/Home/Index';
                    }
                });
            });

            // 输入框实时验证
            $('#workOrderNo').on('input', validateWorkOrder);
            $('#assemblySeq').on('input', validateAssemblySeq);
            $('#materialCode').on('input', validateMaterialCode);
            $('#quantity').on('input', validateQuantity);

            // 监听窗口大小变化，动态调整页面标题显示（可选）
            $(window).on('resize', function() {
                // 可以根据需要添加窗口大小变化时的处理逻辑
            });
        });

        // 防抖处理函数
        function debounceHandleWorkOrderEnter() {
            clearTimeout(workOrderDebounceTimer);
            workOrderDebounceTimer = setTimeout(() => {
                if (!isProcessing) {
                    handleWorkOrderEnter();
                }
            }, 200);
        }

        function debounceHandleMaterialCodeEnter() {
            clearTimeout(materialCodeDebounceTimer);
            materialCodeDebounceTimer = setTimeout(() => {
                if (!isProcessing) {
                    handleMaterialCodeEnter();
                }
            }, 200);
        }

        // 条码解析器初始化
        function initializeBarcodeParser() {
            try {
                if (typeof window.BarcodeParser !== 'undefined') {
                    barcodeParser = new window.BarcodeParser();
                    showParseStatus(localTexts.parserReady, 'success');
                } else {
                    throw new Error(localTexts.parserInitFailed);
                }
            } catch (error) {
                console.error('条码解析器初始化失败:', error);
                showParseStatus(localTexts.parserInitFailed + ': ' + error.message, 'error');
            }
        }

        // 清空所有表单字段
        function clearFormFields() {
            $('#workOrderNo, #assemblySeq, #materialCode, #quantity, #Unit, #warehouseCode, #batchNo, #location, #remarks').val('');
            $('.error-message').html('');
            $('#parseStatus').removeClass().hide();
            $('.input-field:not(.readonly)').addClass('reset-animation');
            setTimeout(() => $('.input-field:not(.readonly)').removeClass('reset-animation'), 300);
        }

        // 清空物料相关字段
        function clearMaterialFields() {
            $('#materialCode, #quantity, #Unit, #warehouseCode, #batchNo, #location').val('');
        }

        // 清空工单相关字段
        function clearWorkOrderFields() {
            $('#workOrderNo, #assemblySeq').val('');
        }

        // 统一重置数量信息显示（需求数量/已发数量/未发数量/库存数量）
        function resetQtyInfoDisplay() {
            $('#issueQtyValue, #issuedQtyValue, #unissuedQtyValue, #availableQtyValue').text('--');
        }

        // 工单号 Enter 处理（async/await 确保互斥锁在异步流程完成后才释放）
        async function handleWorkOrderEnter() {
            if (isProcessing) return;
            isProcessing = true;

            try {
                let barcode = $('#workOrderNo').val().trim();
                if (!barcode) {
                    showMessage(localTexts.workOrderRequired, 'warning');
                    $('#workOrderNo').focus();
                    return;
                }
                // 不清空 #remarks：用户可能已预先填写备注
                $('#materialCode, #quantity, #Unit, #warehouseCode, #batchNo, #location').val('');
                resetQtyInfoDisplay();
                $('#parseStatus').removeClass().hide();

                // 尝试解析条码
                if (barcodeParser) {
                    try {
                        const result = barcodeParser.parse(barcode);
                        if (result.success && (result.type === 'workOrder' || (result.data.workOrderNo && result.data.assemblySeq))) {
                            const data = result.data;
                            $('#workOrderNo').val(data.workOrderNo);
                            $('#assemblySeq').val(data.assemblySeq);
                            const valid = await validateJob();
                            if (valid) {
                                setTimeout(() => $('#materialCode').focus().select(), 100);
                            } else {
                                clearWorkOrderFields();
                                $('#workOrderNo').focus().select();
                            }
                            return;
                        }
                    } catch (e) {
                        // 解析异常，忽略，按手动输入处理
                    }
                }

                // 手动输入：再次读取 assemblySeq（用户可能已在前面步骤输入）
                const assemblySeq = $('#assemblySeq').val().trim();
                if (!assemblySeq) {
                    showMessage(localTexts.pleaseEnterAssemblySeq, 'error');
                    $('#assemblySeq').focus().select();
                    return;
                }
                const valid = await validateJob();
                if (valid) {
                    setTimeout(() => $('#materialCode').focus().select(), 100);
                } else {
                    $('#workOrderNo').focus().select();
                }
            } finally {
                isProcessing = false;
            }
        }

        // 物料代码 Enter 处理（async/await 确保互斥锁在异步流程完成后才释放）
        async function handleMaterialCodeEnter() {
            if (isProcessing) return;
            isProcessing = true;

            try {
                let barcode = $('#materialCode').val().trim();
                if (!barcode) {
                    showMessage(localTexts.materialCodeRequired, 'warning');
                    $('#materialCode').focus();
                    return;
                }
                $('#quantity, #Unit, #warehouseCode, #batchNo, #location').val('');
                $('#parseStatus').removeClass().hide();

                // 尝试解析条码
                if (barcodeParser) {
                    try {
                        const result = barcodeParser.parse(barcode);
                        if (result.success && (result.type === 'material' || result.data.materialCode)) {
                            const data = result.data;
                            $('#materialCode').val(data.materialCode);
                            $('#quantity').val(data.quantity);
                            $('#Unit').val(data.unit);
                            $('#warehouseCode').val(data.warehouseCode);
                            $('#location').val(data.binNum);
                            $('#batchNo').val(data.lotNum);
                            const valid = await validateInventory();
                            if (valid) {
                                setTimeout(() => $('#quantity').focus().select(), 100);
                            } else {
                                clearMaterialFields();
                                $('#materialCode').focus().select();
                            }
                            return;
                        }
                    } catch (e) {
                        // 解析异常，忽略，按手动输入处理
                    }
                }

                // 手动输入
                const valid = await validateInventory();
                if (valid) {
                    setTimeout(() => $('#quantity').focus().select(), 100);
                } else {
                    $('#materialCode').focus().select();
                }
            } finally {
                isProcessing = false;
            }
        }

        // 工单验证
        async function validateJob() {
            const workOrderNo = $('#workOrderNo').val().trim();
            const assemblySeqRaw = $('#assemblySeq').val().trim();
            // 使用 Number+isInteger 严格校验，与 validateAssemblySeq 保持一致
            const assemblySeqNum = Number(assemblySeqRaw);

            if (!workOrderNo || !assemblySeqRaw) {
                showMessage(localTexts.jobAndAssemblyRequired, 'error');
                return false;
            }
            if (!Number.isInteger(assemblySeqNum) || assemblySeqNum < 0) {
                showMessage(localTexts.assemblySeqMustBeNumber, 'error');
                return false;
            }
            resetQtyInfoDisplay();
            try {
                const response = await $.ajax({
                    url: '/Issue/ValidateJob',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ workOrderNo: workOrderNo, assemblySeq: assemblySeqNum }),
                    headers: { 'X-CSRF-TOKEN': $('input[name="__RequestVerificationToken"]').val() }
                });
                if (response.success) {
                    return true;
                } else {
                    showMessage(response.message || localTexts.jobValidationFailed, 'error');
                    return false;
                }
            } catch (error) {
                const status = error.status || (error.responseJSON && error.responseJSON.status);
                const msg = (error.responseJSON && error.responseJSON.message)
                    || (error.statusText && error.statusText !== 'error' ? error.statusText : localTexts.networkError);
                showMessage(msg, 'error');
                console.error(error);
                if (status === 401) window.location.href = '/Account/Login';
                return false;
            }
        }

        // 库存验证
        async function validateInventory() {
            const materialCode = $('#materialCode').val().trim();
            const warehouseCode = $('#warehouseCode').val().trim();
            const location = $('#location').val().trim();
            const batchNo = $('#batchNo').val().trim();
            const quantity = parseFloat($('#quantity').val()) || 0;
            const workOrderNo = $('#workOrderNo').val().trim();
            const assemblySeqRaw = $('#assemblySeq').val().trim();
            // 使用 Number+isInteger 严格校验，与 validateJob/validateAssemblySeq 保持一致
            const assemblySeqNum = Number(assemblySeqRaw);
            const Unit = $('#Unit').val().trim();

            if (!workOrderNo || !assemblySeqRaw || !Number.isInteger(assemblySeqNum) || assemblySeqNum < 0) {
                showMessage(localTexts.jobAndAssemblyRequired, 'error');
                return false;
            }
            if (!materialCode) {
                showMessage(localTexts.materialCodeRequiredMsg, 'error');
                return false;
            }
            try {
                const response = await $.ajax({
                    url: '/Issue/ValidateInventory',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        workOrderNo: workOrderNo,
                        assemblySeq: assemblySeqNum,
                        materialCode: materialCode,
                        fromWarehouse: warehouseCode,
                        location: location,
                        batchNo: batchNo,
                        unit: Unit,
                        quantity: quantity
                    }),
                    headers: { 'X-CSRF-TOKEN': $('input[name="__RequestVerificationToken"]').val() }
                });

                // 回填数量信息：需求数量/已发数量/未发数量/库存数量
                if (response.requiredQty !== undefined && response.requiredQty !== null) {
                    $('#issueQtyValue').text(Math.round(response.requiredQty * 1000) / 1000);
                } else {
                    $('#issueQtyValue').text('--');
                }

                if (response.issuedQty !== undefined && response.issuedQty !== null) {
                    $('#issuedQtyValue').text(Math.round(response.issuedQty * 1000) / 1000);
                } else {
                    $('#issuedQtyValue').text('--');
                }

                if (response.unissuedQty !== undefined && response.unissuedQty !== null) {
                    $('#unissuedQtyValue').text(Math.ceil(response.unissuedQty * 1000) / 1000);
                } else {
                    $('#unissuedQtyValue').text('--');
                }

                if (response.availableQty !== undefined && response.availableQty !== null) {
                    $('#availableQtyValue').text(response.availableQty.toFixed(2));
                } else {
                    $('#availableQtyValue').text('--');
                }

                if (response.success) {
                    // 扫码数量超过库存数量时，弹出信息提示（不清空表单，允许修改数量）
                    if (response.availableQty !== undefined && response.availableQty > 0 && quantity > response.availableQty) {
                        showMessage(response.message, 'warning');
                    }
                    // 用建议数量填入数量栏位：min(库存数量, 扫码数量, 未发数量)
                    if (response.suggestedQty !== undefined && response.suggestedQty > 0) {
                        $('#quantity').val(response.suggestedQty);
                    }
                    return true;
                } else {
                    showMessage(response.message || localTexts.inventoryValidationFailed, 'error');
                    // 库存相关失败（unissuedQty > 0 表示已通过工单/物料校验，问题出在库存侧）：
                    // 不清空表单，仅将发料数量重置为 0，保留其他输入供用户调整后重新提交
                    if (response.unissuedQty && response.unissuedQty > 0) {
                        $('#quantity').val(0);
                        setTimeout(() => $('#quantity').focus().select(), 100);
                    }
                    return false;
                }
            } catch (error) {
                const status = error.status || (error.responseJSON && error.responseJSON.status);
                const msg = (error.responseJSON && error.responseJSON.message)
                    || (error.statusText && error.statusText !== 'error' ? error.statusText : localTexts.networkError);
                showMessage(msg, 'error');
                console.error(error);
                if (status === 401) window.location.href = '/Account/Login';
                return false;
            }
        }

        // 显示解析状态
        function showParseStatus(message, type) {
            const $status = $('#parseStatus');
            $status.removeClass().addClass('parse-status ' + type).text(message).show();
            setTimeout(() => $status.removeClass('success error').hide(), 5000);
        }

        // 表单验证
        function validateForm() {
            return validateWorkOrder() && validateAssemblySeq() && validateMaterialCode() && validateQuantity();
        }

        function validateWorkOrder() {
            const value = $('#workOrderNo').val().trim();
            if (!value) {
                $('#workOrderError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.workOrderRequired);
                return false;
            }
            $('#workOrderError').html('');
            return true;
        }

        function validateAssemblySeq() {
            const value = $('#assemblySeq').val().trim();
            if (!value) {
                $('#assemblySeqError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.assemblySeqRequired);
                return false;
            }
            // 必须为非负整数（用 Number+isInteger 严格校验，避免 parseInt("1.5")=1 通过但表单提交 "1.5" 被后端 int 绑定拒绝的不一致）
            const num = Number(value);
            if (!Number.isInteger(num) || num < 0) {
                $('#assemblySeqError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.assemblySeqMustBeNumber);
                return false;
            }
            $('#assemblySeqError').html('');
            return true;
        }

        function validateMaterialCode() {
            const value = $('#materialCode').val().trim();
            if (!value) {
                $('#materialCodeError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.materialCodeRequired);
                return false;
            }
            $('#materialCodeError').html('');
            return true;
        }

        function validateQuantity() {
            const value = parseFloat($('#quantity').val());
            // 使用 Number.isFinite 显式判断 NaN/Infinity，避免依赖隐式转换的可读性问题
            if (!Number.isFinite(value) || value <= 0) {
                $('#quantityError').html('<i class="fas fa-exclamation-circle"></i> ' + localTexts.quantityRequired);
                return false;
            }
            $('#quantityError').html('');
            return true;
        }

        // 一次提交尝试内固定 ID：失败/超时重试复用同一 ID（服务端据此拦截重复过账），成功后重置。
        var pendingRequestId = null;
        function getRequestId() {
            if (!pendingRequestId) {
                pendingRequestId = (window.crypto && typeof crypto.randomUUID === 'function')
                    ? crypto.randomUUID()
                    : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
                        var r = Math.random() * 16 | 0;
                        var v = c === 'x' ? r : (r & 0x3 | 0x8);
                        return v.toString(16);
                    });
            }
            return pendingRequestId;
        }
        function resetRequestId() { pendingRequestId = null; }

        // 表单提交（先重做 Job + Inventory 预校验，防止用户跳过 Enter 流程直接提交）
        async function submitIssueForm() {
            if (!validateForm()) return;

            // 提前禁用提交按钮 + 显示加载态，防止 validateJob + validateInventory 期间用户重复点击
            $('#submitBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> ' + localTexts.submitting);

            // 重做 Job + Inventory 预校验，防止用户跳过 Enter 流程直接提交
            const jobValid = await validateJob();
            if (!jobValid) { resetSubmitButton(); return; }
            const invValid = await validateInventory();
            if (!invValid) { resetSubmitButton(); return; }

            const formData = $('#issueForm').serialize();
            showToast(localTexts.submitting, 'info');

            $.ajax({
                url: $('#issueForm').attr('action'),
                type: 'POST',
                data: formData,
                timeout: 30000,  // 30 秒超时，避免按钮一直处于"提交中"状态
                headers: { 'X-CSRF-TOKEN': $('input[name="__RequestVerificationToken"]').val(),
                           'X-Request-ID': getRequestId() },
                success: function (response) {
                    if (response.success) {
                        resetRequestId();
                        showToast(response.message || localTexts.submitSuccess, 'success');
                        resetAfterSuccess();
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: localTexts.commonError,
                            text: response.message || localTexts.submitFailed,
                            confirmButtonText: localTexts.okButton
                        });
                    }
                    resetSubmitButton();
                },
                error: function (xhr) {
                    // 仅使用 responseJSON.message，避免 responseText 截取后端堆栈/HTML 错误页泄漏
                    let errorMsg = localTexts.networkError;
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    }
                    Swal.fire({
                        icon: 'error',
                        title: localTexts.commonError,
                        text: localTexts.submitFailed + ': ' + errorMsg,
                        confirmButtonText: localTexts.okButton
                    });
                    resetSubmitButton();
                }
            });
        }

        // 发料成功后的重置
        function resetAfterSuccess() {
            $('#materialCode, #quantity, #Unit, #warehouseCode, #batchNo, #location, #remarks').val('');
            $('.error-message').html('');
            $('#parseStatus').removeClass().hide();
            // 重置数量信息显示（需求数量/已发数量/未发数量/库存数量）
            resetQtyInfoDisplay();
            $('#materialCode, #quantity, #Unit, #warehouseCode, #batchNo, #location, #remarks').addClass('reset-animation');
            setTimeout(() => {
                $('#materialCode, #quantity, #Unit, #warehouseCode, #batchNo, #location, #remarks').removeClass('reset-animation');
            }, 300);

            $('#materialCode').focus().select();
        }

        function resetSubmitButton() {
            setTimeout(() => {
                $('#submitBtn').prop('disabled', false).html('<i class="fas fa-paper-plane"></i> @GetText("MaterialIssue", "SubmitButton")');
            }, 1000);
        }

        // 重置表单
        function resetForm() {
            $('#issueForm')[0].reset();
            $('.error-message').html('');
            $('#parseStatus').removeClass().hide();
            $('#workOrderNo, #assemblySeq').val('');
            resetQtyInfoDisplay();
            $('#workOrderNo').focus();
            showMessage(localTexts.formReset, 'info');
        }

        // 通用消息提示 - 只有错误类型使用弹窗，其他类型使用底部toast
        function showMessage(message, type) {
            if (type === 'error') {
                Swal.fire({
                    icon: 'error',
                    title: localTexts.commonError,
                    text: message,
                    confirmButtonText: localTexts.okButton,
                    timer: 3000,
                    timerProgressBar: true
                });
            } else {
                showToast(message, type);
            }
        }

        function getIconForType(type) {
            return {
                success: 'check-circle',

                error: 'exclamation-circle',
                warning: 'exclamation-triangle',
                info: 'info-circle'
            }[type] || 'info-circle';
        }

        $(window).on('beforeunload', function () { });
    </script>
</body>
</html>