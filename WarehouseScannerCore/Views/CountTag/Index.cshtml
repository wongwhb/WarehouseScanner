@model WarehouseScannerCore.Controllers.CountTagModel
@{
    var getText = ViewBag.GetText as Func<string, string, string>;
    var currentCulture = ViewBag.CurrentCulture as string ?? "zh-CN";
    var userId = ViewBag.UserId as string;

    string GetText(string section, string key)
    {
        return getText?.Invoke(section, key) ?? $"[{section}.{key}]";
    }
}

<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>@GetText("CountTag", "Title")</title>

    <link rel="stylesheet" href="~/css/fontawesome/all.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/shared-scanner.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/sweetalert2.css">

    <style>
        @@media (max-width: 768px) {
            .page-header {
                display: none !important;
            }
        }

        .input-field.validating {
            border-color: #f39c12 !important;
            background-color: #fff9e6 !important;
        }

        .input-field.valid-success {
            border-color: #27ae60 !important;
            background-color: #e8f8f0 !important;
        }

        .input-field.valid-error {
            border-color: #e74c3c !important;
            background-color: #fdeaea !important;
        }

        .status-toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0,0,0,0.85);
            color: white;
            padding: 12px 24px;
            border-radius: 40px;
            font-size: 15px;
            z-index: 10000;
            max-width: 90%;
            text-align: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            animation: fadeInUp 0.3s ease;
            font-weight: 500;
        }

            .status-toast.success {
                background: #28a745;
            }

            .status-toast.warning {
                background: #ffc107;
                color: #333;
            }

            .status-toast.info {
                background: #17a2b8;
            }

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateX(-50%) translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }
        }

        .status-message {
            display: none;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="page-header">
            <h1 class="page-title">
                <i class="fas fa-tags"></i> @GetText("CountTag", "Title")
            </h1>
            <div class="page-subtitle">
                @GetText("CountTag", "Subtitle")
            </div>
        </div>

        <div id="statusMessage" class="status-message"></div>

        <div class="form-container">
            <form id="countTagForm" method="post" asp-action="CountTagInventory">
                @Html.AntiForgeryToken()
                <div class="button-group">
                    <button type="submit" class="btn btn-primary" id="submitBtn">
                        <i class="fas fa-check-circle"></i> @GetText("CountTag", "SubmitButton")
                    </button>
                    <button type="button" class="btn btn-secondary" id="resetBtn">
                        <i class="fas fa-redo-alt"></i> @GetText("CountTag", "ResetButton")
                    </button>
                    <button type="button" class="btn btn-danger" id="cancelBtn">
                        <i class="fas fa-times-circle"></i> @GetText("CountTag", "CancelButton")
                    </button>
                    <button type="button" class="btn btn-info" id="btnCycleCountQuery">
                        <i class="fas fa-search"></i> @GetText("CountTag", "CycleCountQuery")
                    </button>
                </div>

                <div class="form-grid form-grid-3">
                    <div class="form-item">
                        <label>@GetText("CountTag", "MaterialCode") <span class="required">*</span></label>
                        <input type="text"
                               class="input-field scan-input"
                               id="materialCode"
                               name="MaterialCode"
                               placeholder="@GetText("CountTag", "MaterialCodePlaceholder")"
                               autocomplete="off"
                               autocorrect="off"
                               autocapitalize="none"
                               inputmode="text">
                        <div class="input-hint">
                            <i class="fas fa-keyboard"></i> @GetText("CountTag", "MatScanPromptMessage")
                        </div>
                        <div class="error-message" id="materialCodeError"></div>
                    </div>

                    <div class="form-item">
                        <label>@GetText("CountTag", "Quantity") <span class="required">*</span></label>
                        <input type="number"
                               class="input-field"
                               id="quantity"
                               name="Quantity"
                               min="0.000001"
                               step="0.000001"
                               placeholder="@GetText("CountTag", "QuantityPlaceholder")"
                               autocomplete="off">
                        <!-- 库存数量显示（红色） -->
                        <div id="inventoryQtyDisplay" style="margin-top:6px;color:#dc3545;font-weight:600;font-size:14px;line-height:1.5;min-height:20px;"></div>
                        <div class="error-message" id="quantityError"></div>
                    </div>

                    <div class="form-item">
                        <label>@GetText("CountTag", "UOM") <span class="required">*</span></label>
                        <input type="text"
                               class="input-field"
                               id="uom"
                               name="UOM"
                               placeholder="@GetText("CountTag", "UOMPlaceholder")"
                               autocomplete="off">
                        <div class="error-message" id="uomError"></div>
                    </div>

                    <div class="form-item">
                        <label>@GetText("CountTag", "FromWarehouse") <span class="required">*</span></label>
                        <input type="text"
                               class="input-field scan-input"
                               id="fromWarehouse"
                               name="FromWarehouse"
                               placeholder="@GetText("CountTag", "FromWarehousePlaceholder")"
                               autocomplete="off"
                               autocorrect="off"
                               autocapitalize="none"
                               inputmode="text">
                        <div class="input-hint">
                            <i class="fas fa-keyboard"></i> @GetText("CountTag", "MatScanPromptMessage")
                        </div>
                        <div class="error-message" id="fromWarehouseError"></div>
                    </div>

                    <div class="form-item">
                        <label>@GetText("CountTag", "Location") <span class="required">*</span></label>
                        <input type="text"
                               class="input-field"
                               id="location"
                               name="FromLocation"
                               placeholder="@GetText("CountTag", "LocationPlaceholder")"
                               autocomplete="off">
                        <div class="error-message" id="locationError"></div>
                    </div>

                    <div class="form-item">
                        <label>@GetText("CountTag", "FromBatch")</label>
                        <input type="text"
                               class="input-field"
                               id="fromBatchNo"
                               name="FromBatchNo"
                               placeholder="@GetText("CountTag", "FromBatchPlaceholder")"
                               autocomplete="off">
                    </div>

                    <div class="form-item full-width">
                        <label>@GetText("CountTag", "Remark")</label>
                        <textarea class="input-field"
                                  id="remark"
                                  name="Remark"
                                  rows="2"
                                  placeholder="@GetText("CountTag", "RemarkPlaceholder")"></textarea>
                    </div>
                </div>

                <div id="operator-section">
                    <label>@GetText("CountTag", "Operator")</label>
                    <input type="text"
                           class="input-field readonly"
                           id="operator"
                           name="Operator"
                           value="@userId"
                           readonly>
                </div>
                <input type="hidden" name="OperatorId" value="@userId" />
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/Scancode-parser.js" asp-append-version="true"></script>
    <script src="~/js/sweetalert.js" asp-append-version="true"></script>

    <script nonce="@Context.Items["CspNonce"]">
        var localTexts = {
            materialCodeRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "MaterialCodeRequired"))),
            quantityRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "QuantityRequired"))),
            quantityPositiveRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "QuantityPositiveRequired"))),
            uomRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "UOMRequired"))),
            fromWarehouseRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "FromWarehouseRequired"))),
            fromLocationRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "FromLocationRequired"))),
            confirmCancel: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "ConfirmCancel"))),
            submitting: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "Submitting"))),
            submitSuccess: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "CountTagSuccess"))),
            submitFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "CountTagFailed"))),
            networkError: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "NetworkError"))),
            parseSuccess: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "ParseSuccess"))),
            parseFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "ParseFailed"))),
            formReset: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "FormReset"))),
            barcodeParseSuccess: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "BarcodeParseSuccess"))),
            pleaseScanValidMaterial: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "PleaseScanValidMaterial"))),
            parseError: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "ParseError"))),
            matScanPromptMessage: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "MatScanPromptMessage"))),
            parserReady: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "ParserReady"))),
            parserInitFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "ParserInitFailed"))),
            validatingCountTag: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "ValidatingCountTag"))),
            countTagValid: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "CountTagValid"))),
            countTagNotFound: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "CountTagNotFound"))),
            countTagValidationError: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "CountTagValidationError"))),
            materialCodeRequiredForCountTag: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "MaterialCodeRequiredForCountTag"))),
            sessionExpired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "SessionExpired"))),
            materialBarcodeParseSuccess: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "BarcodeParseSuccess"))),
            confirmButton: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "Confirm"))),
            cancelButtonText: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "Cancel"))),
            okButton: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "OK"))),
            commonError: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "CommonError"))),
            inventoryOnHandLabel: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "InventoryOnHandLabel"))),
            inventoryLoading: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "InventoryLoading"))),
            inventoryQueryFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "InventoryQueryFailed"))),
            inventoryQueryError: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "InventoryQueryError"))),
            inventoryNotFound: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("CountTag", "InventoryNotFound")))
        };

        let barcodeParser = null;
        let isProcessing = false;
        let toastTimer = null;

        function isMobileDevice() {
            return window.innerWidth <= 768;
        }

        // HTML 转义：动态消息（服务端响应/解析结果）插入 DOM 前统一转义，防止注入（与 CountView 主视图同一实现）
        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str).replace(/&/g, '&amp;')
                              .replace(/</g, '&lt;')
                              .replace(/>/g, '&gt;')
                              .replace(/"/g, '&quot;')
                              .replace(/'/g, '&#039;');
        }

        function showToast(message, type) {
            if (toastTimer) {
                clearTimeout(toastTimer);
            }
            $('.status-toast').remove();

            var $toast = $('<div class="status-toast ' + type + '">' + escapeHtml(message) + '</div>');
            $('body').append($toast);

            toastTimer = setTimeout(function() {
                $toast.fadeOut(300, function() {
                    $(this).remove();
                });
                toastTimer = null;
            }, 2000);
        }

        $(document).ready(function() {
            initializeBarcodeParser();
            $('#materialCode').focus();

            $('.scan-input').on('change', function () {
                $(this).addClass('scan-highlight');
                setTimeout(() => $(this).removeClass('scan-highlight'), 500);
            });

            $('#materialCode').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    handleMaterialCodeEnter();
                }
            });

            // 仓库代码 Enter 事件 - 集成 Scancode-parser.js 仓库条码解析
            bindWarehouseScan({
                warehouseInput: '#fromWarehouse',
                locationInput: '#location',
                nextFocusInput: '#fromBatchNo',
                fallbackTab: false
            });

            $('.input-field:not(#materialCode, #fromWarehouse, .readonly, textarea)').on('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    var $inputs = $('.input-field:not(.readonly)');
                    var index = $inputs.index(e.target);
                    if (index >= 0 && index < $inputs.length - 1) {
                        $inputs.eq(index + 1).focus().select();
                    }
                }
            });

            $(document).on('keydown', function(e) {
                if (e.key === 'F1') {
                    e.preventDefault();
                    $('#materialCode').focus();
                }
                if (e.key === 'F2') {
                    e.preventDefault();
                    resetForm();
                }
                if (e.key === 'Escape') {
                    Swal.fire({
                        title: localTexts.confirmCancel,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: localTexts.confirmButton,
                        cancelButtonText: localTexts.cancelButtonText
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '/Home/Index';
                        }
                    });
                }
            });

            $('#countTagForm').on('submit', function(e) {
                e.preventDefault();
                submitForm();
            });

            $('#resetBtn').on('click', resetForm);

            $('#cancelBtn').on('click', function() {
                Swal.fire({
                    title: localTexts.confirmCancel,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: localTexts.confirmButton,
                    cancelButtonText: localTexts.cancelButtonText
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '/Home/Index';
                    }
                });
            });

            // 盘点查询按钮跳转（避免内联 onclick，符合 CSP 要求）
            $('#btnCycleCountQuery').on('click', function() {
                window.location.href = '/CountView/Index';
            });

            $('#materialCode').on('input', validateMaterialCode);
            $('#quantity').on('input', validateQuantity);
            $('#uom').on('input', validateUOM);
            $('#fromWarehouse').on('input', validateFromWarehouse);
            $('#location').on('input', validateFromLocation);
        });

        async function handleMaterialCodeEnter() {
            if (isProcessing) return;
            isProcessing = true;

            try {
                let barcode = $('#materialCode').val().trim();
                if (!barcode) {
                    showToast(localTexts.materialCodeRequired, 'warning');
                    $('#materialCode').focus();
                    return;
                }

                $('#quantity, #uom, #fromWarehouse, #location, #fromBatchNo').val('');
                $('#inventoryQtyDisplay').text('');

                if (barcodeParser) {
                    try {
                        const result = barcodeParser.parse(barcode);
                        if (result.success && (result.type === 'material' || result.data.materialCode)) {
                            const data = result.data;
                            $('#materialCode').val(data.materialCode);
                            $('#quantity').val(data.quantity || '');
                            $('#uom').val(data.unit || '');
                            $('#fromWarehouse').val(data.warehouseCode || '');
                            $('#location').val(data.binNum || '');
                            $('#fromBatchNo').val(data.lotNum || '');

                            showToast(localTexts.materialBarcodeParseSuccess, 'success');

                            // 扫码解析完成后立即调用库存数量查询（物料+仓库+库位+批次）
                            var matCode = data.materialCode || $('#materialCode').val().trim();
                            var whse = data.warehouseCode || '';
                            var bin = data.binNum || '';
                            var lot = data.lotNum || '';
                            if (matCode) {
                                // 不阻塞 UI，后台加载
                                updateInventoryQtyDisplay(matCode, whse, bin, lot);
                            }

                            setTimeout(() => {
                                if ($('#fromWarehouse').val()) {
                                    validateCountTag();
                                } else {
                                    $('#fromWarehouse').focus().select();
                                }
                            }, 300);
                            return;
                        }
                    } catch (e) {
                    }
                }

                $('#fromWarehouse').focus().select();
            } finally {
                isProcessing = false;
            }
        }

        /**
         * 简单字符串格式化：把 {0} {1} 替换为对应参数
         */
        function formatString(template) {
            var args = Array.prototype.slice.call(arguments, 1);
            return template.replace(/\{(\d+)\}/g, function (match, num) {
                var idx = parseInt(num, 10);
                return idx < args.length ? args[idx] : match;
            });
        }

        /**
         * 调用 /CountTag/QueryInventoryOnHand 按(物料/仓库/库位/批次)查询库存数量
         * 结果以红色显示在数量输入框下方（仅显示库存数量本身，不含可用/已分配）
         */
        async function updateInventoryQtyDisplay(materialCode, whseCode, binNum, lotNumber) {
            try {
                var $display = $('#inventoryQtyDisplay');
                if (!materialCode) {
                    $display.text('');
                    return;
                }

                $display.css('color', '#dc3545').text(localTexts.inventoryLoading);

                var requestData = {
                    materialCode: materialCode,
                    whseCode: whseCode || '',
                    binNum: binNum || '',
                    lotNumber: lotNumber || ''
                };

                await $.ajax({
                    url: '/CountTag/QueryInventoryOnHand',
                    type: 'POST',
                    data: JSON.stringify(requestData),
                    contentType: 'application/json; charset=utf-8',
                    headers: { 'X-CSRF-TOKEN': $('input[name="__RequestVerificationToken"]').val() },
                    success: function (resp) {
                        if (!resp || !resp.success) {
                            $display.css('color', '#dc3545').text(localTexts.inventoryQueryFailed);
                            return;
                        }
                        if (!resp.found) {
                            $display.css('color', '#dc3545').text(localTexts.inventoryNotFound);
                            return;
                        }
                        var unit = resp.ium ? ' ' + resp.ium : '';
                        var label = formatString(localTexts.inventoryOnHandLabel, resp.qtyOnHand, unit);
                        $display.css('color', '#dc3545').text(label);
                    },
                    error: function () {
                        $display.css('color', '#dc3545').text(localTexts.inventoryQueryFailed);
                    }
                });
            } catch (e) {
                console.error('updateInventoryQtyDisplay 异常:', e);
                $('#inventoryQtyDisplay').css('color', '#dc3545').text(localTexts.inventoryQueryError);
            }
        }

        function validateCountTag() {
            var fromWarehouse = $('#fromWarehouse').val().trim();
            var fromLocation = $('#location').val().trim();
            var fromBatchNo = $('#fromBatchNo').val().trim();
            var materialCode = $('#materialCode').val().trim();

            if (!materialCode) {
                showToast(localTexts.materialCodeRequiredForCountTag, 'warning');
                $('#materialCode').focus();
                return false;
            }

            if (!fromWarehouse) {
                showToast(localTexts.fromWarehouseRequired, 'warning');
                $('#fromWarehouse').focus();
                return false;
            }

            var $fromWarehouseField = $('#fromWarehouse');
            $fromWarehouseField.addClass('validating');
            showToast(localTexts.validatingCountTag, 'info');

            var requestData = {
                materialCode: materialCode,
                whseCode: fromWarehouse,
                binNum: fromLocation || '',
                lotNumber: fromBatchNo || ''
            };

            $.ajax({
                url: '/CountTag/ValidateCountTag',
                type: 'POST',
                data: JSON.stringify(requestData),
                contentType: 'application/json; charset=utf-8',
                headers: { 'X-CSRF-TOKEN': $('input[name="__RequestVerificationToken"]').val() },
                success: function(response) {
                    $fromWarehouseField.removeClass('validating');
                    if (response && response.success) {
                        $fromWarehouseField.addClass('valid-success');
                        showToast(localTexts.countTagValid, 'success');
                        // 标签验证通过后，再按(物料/仓库/库位/批次)查一遍库存数量并显示
                        updateInventoryQtyDisplay(materialCode, fromWarehouse, fromLocation, fromBatchNo);
                        setTimeout(() => $('#quantity').focus().select(), 500);
                        return true;
                    } else {
                        $fromWarehouseField.addClass('valid-error');
                        Swal.fire({
                            icon: 'error',
                            title: localTexts.commonError,
                            text: response.message || localTexts.countTagNotFound,
                            confirmButtonText: localTexts.okButton
                        });
                        setTimeout(() => {
                            $fromWarehouseField.removeClass('valid-error');
                        }, 2000);
                        return false;
                    }
                },
                error: function(xhr) {
                    $fromWarehouseField.removeClass('validating');
                    $fromWarehouseField.addClass('valid-error');
                    var errorMsg = localTexts.countTagValidationError;
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    }
                    showToast(errorMsg, 'error');
                    setTimeout(() => {
                        $fromWarehouseField.removeClass('valid-error');
                    }, 2000);
                    return false;
                }
            });
        }

        function initializeBarcodeParser() {
            try {
                if (typeof window.BarcodeParser !== 'undefined') {
                    barcodeParser = new window.BarcodeParser();
                    showToast(localTexts.parserReady, 'success');
                } else {
                    throw new Error(localTexts.parserInitFailed);
                }
            } catch (error) {
                console.error('条码解析器初始化失败:', error);
                showToast(localTexts.parserInitFailed + ': ' + error.message, 'error');
            }
        }

        function showMessage(message, type) {
            if (type === 'error') {
                Swal.fire({
                    icon: 'error',
                    title: localTexts.commonError,
                    text: message,
                    confirmButtonText: localTexts.okButton,
                    timer: 3000,
                    timerProgressBar: true
                });
            } else {
                showToast(message, type);
            }
        }

        function getIconForType(type) {
            const icons = {
                'success': 'check-circle',
                'error': 'exclamation-circle',
                'warning': 'exclamation-triangle',
                'info': 'info-circle'
            };
            return icons[type] || 'info-circle';
        }

        function validateMaterialCode() {
            const val = $('#materialCode').val().trim();
            if (!val) {
                $('#materialCodeError').text(localTexts.materialCodeRequired);
                return false;
            }
            $('#materialCodeError').text('');
            return true;
        }

        function validateQuantity() {
            const val = $('#quantity').val().trim();
            if (!val) {
                $('#quantityError').text(localTexts.quantityRequired);
                return false;
            }
            if (isNaN(parseFloat(val)) || parseFloat(val) <= 0) {
                $('#quantityError').text(localTexts.quantityPositiveRequired);
                return false;
            }
            $('#quantityError').text('');
            return true;
        }

        function validateUOM() {
            const val = $('#uom').val().trim();
            if (!val) {
                $('#uomError').text(localTexts.uomRequired);
                return false;
            }
            $('#uomError').text('');
            return true;
        }

        function validateFromWarehouse() {
            const val = $('#fromWarehouse').val().trim();
            if (!val) {
                $('#fromWarehouseError').text(localTexts.fromWarehouseRequired);
                return false;
            }
            $('#fromWarehouseError').text('');
            return true;
        }

        function validateFromLocation() {
            const val = $('#location').val().trim();
            if (!val) {
                $('#locationError').text(localTexts.fromLocationRequired);
                return false;
            }
            $('#locationError').text('');
            return true;
        }

        // 一次提交尝试内固定 ID：失败/超时重试复用同一 ID（服务端据此拦截重复过账），成功后重置。
        var pendingRequestId = null;
        function getRequestId() {
            if (!pendingRequestId) {
                pendingRequestId = (window.crypto && typeof crypto.randomUUID === 'function')
                    ? crypto.randomUUID()
                    : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
                        var r = Math.random() * 16 | 0;
                        var v = c === 'x' ? r : (r & 0x3 | 0x8);
                        return v.toString(16);
                    });
            }
            return pendingRequestId;
        }
        function resetRequestId() { pendingRequestId = null; }

        function submitForm() {
            const valid = validateMaterialCode()
                        && validateQuantity()
                        && validateUOM()
                        && validateFromWarehouse()
                        && validateFromLocation();
            if (!valid) {
                showToast(localTexts.submitFailed, 'error');
                return;
            }

            const $submitBtn = $('#submitBtn');
            const originalText = $submitBtn.html();
            $submitBtn.prop('disabled', true)
                       .html('<i class="fas fa-spinner fa-spin"></i> ' + localTexts.submitting);

            const formData = {
                MaterialCode: $('#materialCode').val().trim(),
                Quantity: $('#quantity').val().trim(),
                UOM: $('#uom').val().trim(),
                FromWarehouse: $('#fromWarehouse').val().trim(),
                FromLocation: $('#location').val().trim(),
                FromBatchNo: $('#fromBatchNo').val().trim(),
                Remark: $('#remark').val().trim(),
                Operator: $('#operator').val(),
                OperatorId: $('input[name="OperatorId"]').val()
            };

            const token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: $('#countTagForm').attr('action'),
                type: 'POST',
                data: JSON.stringify(formData),
                contentType: 'application/json; charset=utf-8',
                headers: { 'X-CSRF-TOKEN': token,
                           'X-Request-ID': getRequestId() },
                success: function(response) {
                    if (response && response.success) {
                        resetRequestId();
                        Swal.fire({
                            icon: 'success',
                            title: response.message || localTexts.submitSuccess,
                            confirmButtonText: localTexts.okButton,
                            timer: 3000,
                            timerProgressBar: true
                        }).then(function() {
                            resetForm();
                        });
                    } else {
                        const errorMsg = response && response.message ? response.message : localTexts.submitFailed;
                        Swal.fire({
                            icon: 'error',
                            title: localTexts.commonError,
                            text: errorMsg,
                            confirmButtonText: localTexts.okButton
                        });
                    }
                    $submitBtn.prop('disabled', false).html(originalText);
                },
                error: function(xhr) {
                    let errorMsg = localTexts.networkError;
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    }
                    Swal.fire({
                        icon: 'error',
                        title: localTexts.commonError,
                        text: errorMsg,
                        confirmButtonText: localTexts.okButton
                    });
                    $submitBtn.prop('disabled', false).html(originalText);
                }
            });
        }

        function resetForm() {
            $('#countTagForm')[0].reset();
            $('.error-message').text('');
            $('#inventoryQtyDisplay').text('');
            $('.input-field').removeClass('validating valid-success valid-error');
            $('#materialCode').focus().select();
            showToast(localTexts.formReset, 'info');
        }
    </script>
</body>
</html>