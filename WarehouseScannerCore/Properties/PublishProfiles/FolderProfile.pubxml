<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<!--
  生产发布配置：
  - DeleteExistingFiles=false：不删除目标目录已有文件，保护运行时数据（App_Data/config/keys）
  - ExcludeApp_Data=true：发布时不覆盖 App_Data（运行时数据）
  - 运行时数据（keys/、config/、App_Data/）应在部署目录外部管理或部署后从外部恢复
-->
<Project>
  <PropertyGroup>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <ExcludeApp_Data>true</ExcludeApp_Data>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishProvider>FileSystem</PublishProvider>
    <PublishUrl>D:\pubsh</PublishUrl>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <_TargetId>Folder</_TargetId>
    <SiteUrlToLaunchAfterPublish />
    <TargetFramework>net8.0</TargetFramework>
    <ProjectGuid>f4aa7698-e711-4d69-9f2c-b2861113d088</ProjectGuid>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>