        async function generatePackId() {
            var generateBtn = $('#generatePackBtn');
            var originalHtml = generateBtn.html();
            generateBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> ' + localTexts.generatingPackId);

            try {
                var response = await $.ajax({
                    url: '/Outbound/GeneratePackId',
                    type: 'POST',
                    contentType: 'application/json',
                    headers: { 'X-CSRF-TOKEN': $('input[name="__RequestVerificationToken"]').val() }
                });

                if (!response || !response.success) {
                    throw new Error(response?.message || localTexts.generatePackIdFailed);
                }

                var packNum = response.packNum;

                if (packNum) {
                    $('#packId').val(packNum);
                    $('#packIdError').html('');
                    // showMessage(localTexts.generatePackIdSuccess + ': ' + packNum, 'success');
                } else {
                    throw new Error(localTexts.packNumNotObtained);
                }
            } catch (error) {
                console.error('生成 Pack ID 失败:', error);
                showMessage(localTexts.generatePackIdFailed + ': ' + (error.message || localTexts.unknownError), 'error');
                $('#packId').val('');
            } finally {
                generateBtn.prop('disabled', false).html(originalHtml);
            }
        }

        // HTML 转义：动态消息（服务端响应/解析结果）插入 DOM 前统一转义，防止注入（与 CountView 同一实现）
