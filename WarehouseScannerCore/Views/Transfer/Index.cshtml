@model WarehouseScannerCore.Controllers.TransferModel
@{
    var getText = ViewBag.GetText as Func<string, string, string>;
    var currentCulture = ViewBag.CurrentCulture as string ?? "zh-CN";
    var userId = ViewBag.UserId as string;

    string GetText(string section, string key)
    {
        return getText?.Invoke(section, key) ?? $"[{section}.{key}]";
    }
}

<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>@GetText("Transfer", "Title")</title>

    <link rel="stylesheet" href="~/css/fontawesome/all.min.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/shared-scanner.css" asp-append-version="true">
    <!-- SweetAlert2 CSS -->
    <link rel="stylesheet" href="~/css/sweetalert2.css">

    <style>
        /* 手机端隐藏页面标题 */
        @@media (max-width: 768px) {
            .page-header {
                display: none !important;
            }
        }
        /* 验证中状态样式 */
        .input-field.validating {
            border-color: #f39c12 !important;
            background-color: #fff9e6 !important;
        }

        .input-field.valid-success {
            border-color: #27ae60 !important;
            background-color: #e8f8f0 !important;
        }

        .input-field.valid-error {
            border-color: #e74c3c !important;
            background-color: #fdeaea !important;
        }

        /* 源库位候选单选框样式（移动端大触控目标） */
        .bin-radio-container {
            margin-top: 8px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .bin-radio-label {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 16px;
            padding: 10px 12px;
            border: 1px solid #dcdcdc;
            border-radius: 8px;
            background: #ffffff;
            transition: background 0.15s, border-color 0.15s;
            cursor: pointer;
        }

        .bin-radio-label:active {
            background: #e8f0fe;
        }

        .bin-radio-label.checked {
            border-color: #1a73e8;
            background: #e8f0fe;
        }

        .bin-radio-label input[type="radio"] {
            margin: 0;
            width: 20px;
            height: 20px;
            flex: 0 0 auto;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="page-header">
            <h1 class="page-title">
                <i class="fas fa-exchange-alt"></i> @GetText("Transfer", "Title")
            </h1>
            <div class="page-subtitle">
                @GetText("Transfer", "Subtitle")
            </div>
        </div>

        <div id="statusMessage" class="status-message"></div>

        <div class="form-container">
            <form id="transferForm" method="post" asp-action="TransferInventory">
                @Html.AntiForgeryToken()
                <!-- 按钮组 -->
                <div class="button-group">
                    <button type="submit" class="btn btn-primary" id="submitBtn">
                        <i class="fas fa-check-circle"></i> @GetText("Transfer", "SubmitButton")
                    </button>
                    <button type="button" class="btn btn-secondary" id="resetBtn">
                        <i class="fas fa-redo-alt"></i> @GetText("Transfer", "ResetButton")
                    </button>
                    <button type="button" class="btn btn-danger" id="cancelBtn">
                        <i class="fas fa-times-circle"></i> @GetText("Transfer", "CancelButton")
                    </button>
                </div>

                <!-- 三列表格布局 -->
                <div class="form-grid form-grid-3">
                    <!-- 物料代码 -->
                    <div class="form-item">
                        <label>@GetText("Transfer", "MaterialCode") <span class="required">*</span></label>
                        <input type="text"
                               class="input-field scan-input"
                               id="materialCode"
                               name="MaterialCode"
                               placeholder="@GetText("Transfer", "MaterialCodePlaceholder")"
                               autocomplete="off">
                        <div class="error-message" id="materialCodeError"></div>
                    </div>

                    <!-- 数量 -->
                    <div class="form-item">
                        <label>@GetText("Transfer", "Quantity") <span class="required">*</span></label>
                        <input type="number"
                               class="input-field"
                               id="quantity"
                               name="Quantity"
                               min="0.000001"
                               step="0.000001"
                               placeholder="@GetText("Transfer", "QuantityPlaceholder")"
                               autocomplete="off">
                        <div class="error-message" id="quantityError"></div>
                    </div>

                    <!-- 单位 -->
                    <div class="form-item">
                        <label>@GetText("Transfer", "Unit")</label>
                        <input type="text"
                               class="input-field"
                               id="unit"
                               name="Unit"
                               autocomplete="off">
                    </div>

                    <!-- 源位置区域标题 -->
                    <div class="form-item full-width" style="margin-bottom: -10px;">
                        <h4 style="color:#2c3e50; font-size:18px;"><i class="fas fa-arrow-right"></i> @GetText("Transfer", "FromSectionTitle")</h4>
                    </div>

                    <!-- 源仓库 -->
                    <div class="form-item">
                        <label>@GetText("Transfer", "FromWarehouse") <span class="required">*</span></label>
                        <input type="text"
                               class="input-field scan-input"
                               id="fromWarehouse"
                               name="FromWarehouse"
                               placeholder="@GetText("Transfer", "FromWarehousePlaceholder")"
                               autocomplete="off"
                               autocorrect="off"
                               autocapitalize="none"
                               inputmode="text">
                        <div class="input-hint">
                            <i class="fas fa-keyboard"></i> @GetText("Transfer", "MatScanPromptMessage")
                        </div>
                        <div class="error-message" id="fromWarehouseError"></div>
                    </div>

                    <!-- 源库位 -->
                    <div class="form-item">
                        <label>@GetText("Transfer", "FromLocation") <span class="required">*</span></label>
                        <input type="text"
                               class="input-field"
                               id="fromLocation"
                               name="FromLocation"
                               placeholder="@GetText("Transfer", "FromLocationPlaceholder")"
                               autocomplete="off">
                        <div class="error-message" id="fromLocationError"></div>
                        <div id="fromBinRadioList" class="bin-radio-container" style="display:none;"></div>
                    </div>

                    <!-- 源批次 -->
                    <div class="form-item">
                        <label>@GetText("Transfer", "FromBatch")</label>
                        <input type="text"
                               class="input-field"
                               id="fromBatchNo"
                               name="FromBatchNo"
                               placeholder="@GetText("Transfer", "FromBatch")"
                               autocomplete="off">
                    </div>

                    <!-- 目标位置区域标题 -->
                    <div class="form-item full-width" style="margin-bottom: -10px;">
                        <h4 style="color:#2c3e50; font-size:18px;"><i class="fas fa-arrow-left"></i> @GetText("Transfer", "ToSectionTitle")</h4>
                    </div>

                    <!-- 目标仓库 -->
                    <div class="form-item">
                        <label>@GetText("Transfer", "ToWarehouse") <span class="required">*</span></label>
                        <input type="text"
                               class="input-field scan-input"
                               id="toWarehouse"
                               name="ToWarehouse"
                               placeholder="@GetText("Transfer", "ToWarehousePlaceholder")"
                               autocomplete="off"
                               autocorrect="off"
                               autocapitalize="none"
                               inputmode="text">
                        <div class="input-hint">
                            <i class="fas fa-keyboard"></i> @GetText("Transfer", "MatScanPromptMessage")
                        </div>
                        <div class="error-message" id="toWarehouseError"></div>
                    </div>

                    <!-- 目标库位 -->
                    <div class="form-item">
                        <label>@GetText("Transfer", "ToLocation") <span class="required">*</span></label>
                        <input type="text"
                               class="input-field"
                               id="toLocation"
                               name="ToLocation"
                               placeholder="@GetText("Transfer", "ToLocationPlaceholder")"
                               autocomplete="off">
                        <div class="error-message" id="toLocationError"></div>
                    </div>

                    <!-- 目标批次 -->
                    <div class="form-item">
                        <label>@GetText("Transfer", "ToBatch")</label>
                        <input type="text"
                               class="input-field"
                               id="toBatchNo"
                               name="ToBatchNo"
                               placeholder="@GetText("Transfer", "ToBatch")"
                               autocomplete="off">
                    </div>

                    <!-- 备注 -->
                    <div class="form-item full-width">
                        <label>@GetText("Transfer", "Remark")</label>
                        <textarea class="input-field"
                                  id="remark"
                                  name="Remark"
                                  rows="2"
                                  placeholder="@GetText("Transfer", "Remark")"></textarea>
                    </div>
                </div>

                <!-- 隐藏操作员区域 -->
                <div id="operator-section">
                    <label>@GetText("Transfer", "Operator")</label>
                    <input type="text"
                           class="input-field readonly"
                           id="operator"
                           name="Operator"
                           value="@userId"
                           readonly>
                </div>
                <input type="hidden" name="OperatorId" value="@userId" />
            </form>
        </div>
    </div>

    <script src="~/js/Scancode-parser.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <!-- SweetAlert2 JS -->
    <script src="~/js/sweetalert.js"></script>
    <script>
        // 本地化文本配置
        var localTexts = {
            materialCodeRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "MaterialCodeRequired"))),
            quantityRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "QuantityRequired"))),
            quantityPositiveRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "QuantityPositiveRequired"))),
            fromWarehouseRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "FromWarehouseRequired"))),
            fromLocationRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "FromLocationRequired"))),
            toWarehouseRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "ToWarehouseRequired"))),
            toLocationRequired: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "ToLocationRequired"))),
            confirmCancel: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "ConfirmCancel"))),
            submitting: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "Submitting"))),
            submitSuccess: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "TransferSuccess"))),
            submitFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "TransferFailed"))),
            networkError: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "NetworkError"))),
            parseSuccess: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "ParseSuccess"))),
            parseFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "ParseFailed"))),
            formReset: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "FormReset"))),
            barcodeParseSuccess: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "BarcodeParseSuccess"))),
            pleaseScanValidMaterial: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "PleaseScanValidMaterial"))),
            parseError: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "ParseError"))),
            fromAndToSame: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "FromAndToSame"))),
            noAvailableInventory: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "NoAvailableInventory"))),
            insufficientInventory: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "InsufficientInventory"))),
            targetLocationNotFound: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "TargetLocationNotFound"))),
            parserReady: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "ParserReady"))),
            parserInitFailed: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "ParserInitFailed"))),
            // 新增验证相关文本
            validatingSource: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "ValidatingSource"))),
            sourceInventoryValid: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "SourceInventoryValid"))),
            sourceInventoryInvalid: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "SourceInventoryInvalid"))),
            validatingTarget: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "ValidatingTarget"))),
            targetLocationValid: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "TargetLocationValid"))),
            targetBatchExists: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "TargetBatchExists"))),
            targetBatchNotExists: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "TargetBatchNotExists"))),
            materialCodeRequiredForInventory: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "MaterialCodeRequiredForInventory"))),
            confirmButton: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Common", "Confirm"))),
            cancelButtonText: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Common", "Cancel"))),
            availableQuantityLabel: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "AvailableQuantityLabel"))),
            binOnHandFormat: @Html.Raw(Newtonsoft.Json.JsonConvert.ToString(GetText("Transfer", "BinOnHandFormat"))),
            // BinQtyExceeded 英文含撇号：先还原加载期的 HTML 编码，再用会转义 < > & ' 的序列化器生成字面量。
            // 不可直接改为 JsonConvert.ToString(HtmlDecode(...))——该方法不转义这些字符，会重新引入脚本注入。
            binQtyExceeded: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(System.Net.WebUtility.HtmlDecode(GetText("Transfer", "BinQtyExceeded"))))
        };

        // 全局变量
        let barcodeParser = null;

        $(document).ready(function() {
            initializeBarcodeParser();
            $('#fromWarehouse').focus();

            // 输入框扫描高亮效果
            $('.scan-input').on('change', function () {
                $(this).addClass('scan-highlight');
                setTimeout(() => $(this).removeClass('scan-highlight'), 500);
            });

            // 物料代码Enter键事件 - 扫码解析（支持的条码格式与源仓库一致）
            $('#materialCode').on('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    handleMaterialCodeEnter(this);
                }
            });

            // 源仓库Enter键事件 - 增加验证源库存
            $('#fromWarehouse').on('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    var barcode = $(this).val().trim();
                    if (!barcode) {
                        showMessage(localTexts.pleaseScanValidMaterial, 'warning');
                        return;
                    }
                    // 先尝试解析条码，如果解析失败则直接验证仓库
                    if (barcodeParser) {
                        try {
                            const result = barcodeParser.parse(barcode);
                            if (result.success && (result.type === 'material' || result.type === 'warehouse' || result.data.materialCode)) {
                                parseAndFillSourceBarcode(barcode);
                                return;
                            }
                        } catch (error) {
                        }
                    }
                    // 非条码或解析失败，直接验证源库存
                    validateSourceInventory();
                }
            });

            // 目标仓库Enter键事件 - 增加验证目标库位和目标批次
            $('#toWarehouse').on('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    var barcode = $(this).val().trim();
                    if (!barcode) {
                        showMessage(localTexts.pleaseScanValidMaterial, 'warning');
                        return;
                    }
                    // 先尝试解析条码
                    if (barcodeParser) {
                        try {
                            const result = barcodeParser.parse(barcode);
                            if (result.success && (result.type === 'material' || result.type === 'warehouse' || result.data.materialCode)) {
                                parseAndFillTargetBarcode(barcode);
                                return;
                            }
                        } catch (error) {
                        }
                    }
                    // 非条码或解析失败，直接验证目标库位和批次
                    validateTargetLocationAndBatch();
                }
            });

            // 其他文本框Enter键切换字段
            $('.input-field:not(#materialCode, #fromWarehouse, #toWarehouse, .readonly, textarea)').on('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    var $inputs = $('.input-field:not(.readonly)');
                    var index = $inputs.index(e.target);
                    if (index >= 0 && index < $inputs.length - 1) {
                        $inputs.eq(index + 1).focus().select();
                    }
                }
            });

            // 键盘快捷键支持
            $(document).on('keydown', function(e) {
                if (e.key === 'F1') {
                    e.preventDefault();
                    $('#fromWarehouse').focus();
                }
                if (e.key === 'F2') {
                    e.preventDefault();
                    resetForm();
                }
                if (e.key === 'Escape') {
                    e.preventDefault();
                    Swal.fire({
                        title: localTexts.confirmCancel,
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: localTexts.confirmButton,
                        cancelButtonText: localTexts.cancelButtonText
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '/Home/Index';
                        }
                    });
                }
            });

            // 表单提交
            $('#transferForm').on('submit', function(e) {
                e.preventDefault();
                submitForm();
            });

            // 重置按钮
            $('#resetBtn').on('click', resetForm);

            // 取消按钮
            $('#cancelBtn').on('click', function() {
                Swal.fire({
                    title: localTexts.confirmCancel,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: localTexts.confirmButton,
                    cancelButtonText: localTexts.cancelButtonText
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '/Home/Index';
                    }
                });
            });

            // 输入验证
            $('#materialCode').on('input', validateMaterialCode);
            $('#quantity').on('input', validateQuantity);
            $('#fromWarehouse').on('input', validateFromWarehouse);
            $('#fromLocation').on('input', validateFromLocation);
            $('#toWarehouse').on('input', validateToWarehouse);
            $('#toLocation').on('input', validateToLocation);
        });

        // ==================== 新增验证函数 ====================

        // 验证源库存（GetPartNumInventory）增加单位验证
        function validateSourceInventory() {
            var fromWarehouse = $('#fromWarehouse').val().trim();
            var fromLocation = $('#fromLocation').val().trim();
            var fromBatchNo = $('#fromBatchNo').val().trim();
            var materialCode = $('#materialCode').val().trim();
            var quantity = $('#quantity').val().trim();
             var unit = $('#unit').val().trim();
            if (!materialCode) {
                showMessage(localTexts.materialCodeRequiredForInventory, 'warning');
                $('#materialCode').focus();
                return false;
            }

            if (!fromWarehouse) {
                showMessage(localTexts.fromWarehouseRequired, 'warning');
                return false;
            }

            // 显示验证中状态
            var $fromWarehouseField = $('#fromWarehouse');
            $fromWarehouseField.addClass('validating');
            showMessage(localTexts.validatingSource, 'info');

            // 构建请求数据
            var requestData = {
                materialCode: materialCode,
                whseCode: fromWarehouse,
                binNum: fromLocation || '',
                lotNumber: fromBatchNo || '',
                quantity : quantity  || '',
                unit : unit || ''
            };

            $.ajax({
                url: '/Transfer/ValidateSourceInventory',
                type: 'POST',
                data: JSON.stringify(requestData),
                contentType: 'application/json; charset=utf-8',
                headers: { 'X-CSRF-TOKEN': $('input[name="__RequestVerificationToken"]').val() },
                success: function(response) {
                    $fromWarehouseField.removeClass('validating');
                    if (response && response.success) {
                        $fromWarehouseField.addClass('valid-success');
                        // showMessage(response.message || localTexts.sourceInventoryValid, 'success');

                        // 如果有库存信息返回，可以自动填充可用数量提示
                        if (response.availableQuantity !== undefined) {
                            $('#quantity').attr('max', response.availableQuantity);
                            showMessage(localTexts.sourceInventoryValid + ' ' + localTexts.availableQuantityLabel + ' ' + response.availableQuantity, 'success');
                        }

                        // 验证成功后自动跳转到下一个字段
                        setTimeout(() => $('#fromLocation').focus().select(), 500);
                        return true;
                    } else {
                        $fromWarehouseField.addClass('valid-error');
                        showMessage(response.message || localTexts.sourceInventoryInvalid, 'error');
                         // 验证失败时清空相关字段值
                    $('#fromWarehouse').val('');
                    $('#materialCode').val('');
                    $('#quantity').val('');
                    $('#unit').val('');
                    $('#fromLocation').val('');
                    $('#fromBatchNo').val('');
                    hideFromBinRadioList();
                    $fromWarehouseField.removeClass('valid-error');
                    $('#fromWarehouse').focus();
                        return false;
                    }
                },
                error: function(xhr) {
                    $fromWarehouseField.removeClass('validating');
                    $fromWarehouseField.addClass('valid-error');
                    var errorMsg = localTexts.sourceInventoryInvalid;
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    }
                    showMessage(errorMsg, 'error');
                     // 验证失败时清空相关字段值
                    $('#fromWarehouse').val('');
                    $('#materialCode').val('');
                    $('#quantity').val('');
                    $('#unit').val('');
                    $('#fromLocation').val('');
                    $('#fromBatchNo').val('');
                    hideFromBinRadioList();
                    $fromWarehouseField.removeClass('valid-error');
                    $('#fromWarehouse').focus();
                    return false;
                }
            });
        }

        // 验证目标库位和批次（GetBinInfo + GetLotInfo）
        function validateTargetLocationAndBatch() {
            var toWarehouse = $('#toWarehouse').val().trim();
            var toLocation = $('#toLocation').val().trim();
            var toBatchNo = $('#toBatchNo').val().trim();
            var materialCode = $('#materialCode').val().trim();

            if (!toWarehouse) {
                showMessage(localTexts.toWarehouseRequired, 'warning');
                return false;
            }

            // 显示验证中状态
            var $toWarehouseField = $('#toWarehouse');
            $toWarehouseField.addClass('validating');
            showMessage(localTexts.validatingTarget, 'info');

            // 第一步：验证目标库位
            var binRequest = {
                warehouseCode: toWarehouse,
                binNum: toLocation || ''
            };

            $.ajax({
                url: '/Transfer/ValidateTargetBin',
                type: 'POST',
                data: JSON.stringify(binRequest),
                contentType: 'application/json; charset=utf-8',
                headers: { 'X-CSRF-TOKEN': $('input[name="__RequestVerificationToken"]').val() },
                success: function(binResponse) {
                    if (!binResponse || !binResponse.success) {
                        $toWarehouseField.removeClass('validating');
                        $toWarehouseField.addClass('valid-error');
                        showMessage(binResponse?.message || localTexts.targetLocationNotFound, 'error');
                         // 验证失败时清空目标仓库字段值
                        $('#toWarehouse').val('');
                        $('#toLocation').val('');
                        $('#toBatchNo').val('');
                        $toWarehouseField.removeClass('valid-error');
                        $('#toWarehouse').focus();
                        return false;
                    }

                    // 库位验证成功，继续验证批次（如果有输入批次号）
                    if (toBatchNo) {
                        var lotRequest = {
                            company: '@ViewBag.Company',  // 需要从后端传递
                            partNum: materialCode || '',
                            lotNumber: toBatchNo
                        };

                        $.ajax({
                            url: '/Transfer/ValidateTargetLot',
                            type: 'POST',
                            data: JSON.stringify(lotRequest),
                            contentType: 'application/json; charset=utf-8',
                            headers: { 'X-CSRF-TOKEN': $('input[name="__RequestVerificationToken"]').val() },
                            success: function(lotResponse) {
                                $toWarehouseField.removeClass('validating');
                                if (lotResponse && lotResponse.success) {
                                    $toWarehouseField.addClass('valid-success');
                                    // showMessage(localTexts.targetBatchExists, 'success');
                                } else {
                                    $toWarehouseField.addClass('valid-error');
                                    showMessage(localTexts.targetBatchNotExists, 'warning');
                                    // 批次不存在时仅警告，不阻止继续（因为批次可以为空）
                                }
                                // 验证完成后跳转到下一个字段
                                setTimeout(() => $('#toLocation').focus().select(), 500);
                                return true;
                            },
                            error: function() {
                                $toWarehouseField.removeClass('validating');
                                $toWarehouseField.addClass('valid-error');
                                showMessage(localTexts.targetBatchNotExists, 'warning');
                                setTimeout(() => $('#toLocation').focus().select(), 500);
                                return false;
                            }
                        });
                    } else {
                        // 没有批次号，只验证库位成功即可
                        $toWarehouseField.removeClass('validating');
                        $toWarehouseField.addClass('valid-success');
                        // showMessage(localTexts.targetLocationValid, 'success');
                        setTimeout(() => $('#toLocation').focus().select(), 500);
                        return true;
                    }
                },
                error: function(xhr) {
                    $toWarehouseField.removeClass('validating');
                    $toWarehouseField.addClass('valid-error');
                    var errorMsg = localTexts.targetLocationNotFound;
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    }
                    showMessage(errorMsg, 'error');
                    return false;
                }
            });
        }

        // 综合验证目标（供外部调用）
        function validateTarget() {
            return validateTargetLocationAndBatch();
        }

        // ==================== 条码解析相关函数 ====================

        // 条码解析器初始化
        function initializeBarcodeParser() {
            try {
                if (typeof window.BarcodeParser !== 'undefined') {
                    barcodeParser = new window.BarcodeParser();
                    // showMessage(localTexts.parserReady, 'success');
                } else {
                    throw new Error(localTexts.parserInitFailed);
                }
            } catch (error) {
                console.error('条码解析器初始化失败:', error);
                showMessage(localTexts.parserInitFailed + ': ' + error.message, 'error');
            }
        }

        // 物料代码回车处理（扫码解析）
        // 说明：本处接受的条码格式与「源仓库」Enter 扫码完全一致（物料条码 / 仓库条码 / 含物料编码的组合条码），
        //       解析成功后复用 parseAndFillSourceBarcode 完成回填与库存校验，确保两个入口行为一致。
        function handleMaterialCodeEnter(entryField) {
            var barcode = $('#materialCode').val().trim();
            if (!barcode) {
                showMessage(localTexts.pleaseScanValidMaterial, 'warning');
                $('#materialCode').focus();
                return;
            }

            if (barcodeParser) {
                try {
                    const result = barcodeParser.parse(barcode);
                    // 与源仓库 Enter 一致的条码格式判定
                    if (result.success && (result.type === 'material' || result.type === 'warehouse' || result.data.materialCode)) {
                        // 物料代码字段必须能解析出物料编码；否则视为无效条码，避免把条码原文当作物料代码参与查询
                        if (!result.data.materialCode) {
                            showMessage(localTexts.pleaseScanValidMaterial, 'warning');
                            $('#materialCode').focus().select();
                            return;
                        }
                        parseAndFillSourceBarcode(barcode);
                        return;
                    }
                } catch (error) {
                }
            }

            // 非条码（手工输入）或解析失败：保持原有「回车跳下一字段」行为
            var $inputs = $('.input-field:not(.readonly)');
            var index = $inputs.index(entryField);
            if (index >= 0 && index < $inputs.length - 1) {
                $inputs.eq(index + 1).focus().select();
            }
        }

        // 源仓库扫码解析填充
        function parseAndFillSourceBarcode(barcode) {
            if (!barcodeParser) {
                showMessage(localTexts.parserInitFailed, 'error');
                return;
            }

            try {
                const result = barcodeParser.parse(barcode);

                if (result.success) {
                    const data = result.data;

                    if (result.type !== 'material' && result.type !== 'warehouse' && !data.materialCode) {
                        showMessage(localTexts.pleaseScanValidMaterial, 'error');
                        $('#fromWarehouse').val(barcode).focus().select();
                        return;
                    }

                    // Transfer 模块：JOB 字段映射为批号（工单入库/销售出库等模块 JOB 为工单号，此处不修改全局解析器）
                    var transferLotNum = data.lotNum || data.workOrderNo || '';

                    // 填充物料、数量、单位、批次
                    if (data.materialCode) $('#materialCode').val(data.materialCode);
                    if (data.quantity) $('#quantity').val(data.quantity);
                    if (data.unit) $('#unit').val(data.unit);
                    if (transferLotNum) {
                        $('#fromBatchNo').val(transferLotNum);
                        // 目标批次号默认等于源批次号
                        $('#toBatchNo').val(transferLotNum);
                    }

                    var partNum = $('#materialCode').val().trim();
                    var lotNum = $('#fromBatchNo').val().trim();

                    if (!partNum || !lotNum) {
                        showMessage(localTexts.materialCodeRequiredForInventory, 'warning');
                        setTimeout(() => { $('#materialCode').focus().select(); }, 300);
                        return;
                    }

                    // 源仓库：优先取条码中的仓库；否则取源仓库文本框的有效值（排除本次条码原文）
                    var whse = data.warehouseCode || '';
                    if (!whse) {
                        var fieldWhse = $('#fromWarehouse').val().trim();
                        if (fieldWhse && fieldWhse !== barcode) whse = fieldWhse;
                    }
                    $('#fromWarehouse').val(whse);
                    $('#fromLocation').val('');
                    hideFromBinRadioList();

                    // 调用库存查询 BAQ：传入 物料代码 + 仓库 + 批次号 三个参数
                    // 同一仓库同一批次可能分布在多个 BinNum，由返回记录数决定自动回填或手工选择
                    var requestData = { PartNum: partNum, WarehouseCode: whse, LotNum: lotNum };
                    $.ajax({
                        url: '/Transfer/QueryInventoryLocation',
                        type: 'POST',
                        data: JSON.stringify(requestData),
                        contentType: 'application/json; charset=utf-8',
                        headers: { 'X-CSRF-TOKEN': $('input[name="__RequestVerificationToken"]').val() },
                        success: function (response) {
                            if (!response || !response.success) {
                                showMessage((response && response.message) || localTexts.noAvailableInventory, 'warning');
                                setTimeout(() => { $('#fromWarehouse').focus().select(); }, 300);
                                return;
                            }
                            var binList = response.list || [];
                            if (binList.length === 1) {
                                // 仅一条库存记录：将返回的 BinNum 填入源库位文本框
                                if (binList[0].warehouseCode) $('#fromWarehouse').val(binList[0].warehouseCode);
                                $('#fromLocation').val(binList[0].binNum || '');
                                if (binList[0].unit) $('#unit').val(binList[0].unit);
                                hideFromBinRadioList();
                                setTimeout(() => { validateSourceInventory(); }, 300);
                            } else if (binList.length > 1) {
                                // 多条库存记录：清空源库位，列出全部 BinNum 供手工选择
                                if (binList[0].warehouseCode) $('#fromWarehouse').val(binList[0].warehouseCode);
                                if (binList[0].unit) $('#unit').val(binList[0].unit);
                                $('#fromLocation').val('');
                                renderFromBinRadioList(binList);
                            } else {
                                showMessage(localTexts.noAvailableInventory, 'warning');
                                setTimeout(() => { $('#fromWarehouse').focus().select(); }, 300);
                            }
                        },
                        error: function () {
                            showMessage(localTexts.sourceInventoryInvalid, 'error');
                            setTimeout(() => { $('#fromWarehouse').focus().select(); }, 300);
                        }
                    });
                } else {
                    showMessage(localTexts.parseFailed + ': ' + (result.error || ''), 'error');
                    $('#fromWarehouse').val(barcode).focus().select();
                }
            } catch (error) {
                console.error('解析异常:', error);
                showMessage(localTexts.parseError + ': ' + error.message, 'error');
            }
        }

        // 隐藏源库位候选单选框列表
        function hideFromBinRadioList() {
            $('#fromBinRadioList').empty().hide();
        }

        // 数字展示：去掉多余小数尾零
        function formatQty(value) {
            var n = parseFloat(value);
            return isNaN(n) ? '' : String(n);
        }

        // 语言资源占位符替换（{0}/{1}...）
        function formatText(template, values) {
            return (template || '').replace(/\{(\d+)\}/g, function (match, index) {
                var v = values[index];
                return v !== undefined && v !== null ? v : match;
            });
        }

        // 渲染源库位候选单选框（同一仓库同一批次分布在多个 BinNum 时，列出全部供手工选择）
        function renderFromBinRadioList(binList) {
            var $container = $('#fromBinRadioList');
            $container.empty();

            for (var i = 0; i < binList.length; i++) {
                var bin = binList[i];
                var $label = $('<label class="bin-radio-label"></label>');
                $('<input type="radio" name="fromBinSelect">').val(i).appendTo($label);
                // 候选项显示：库位 + 该库位在手库存
                $('<span></span>')
                    .text(formatText(localTexts.binOnHandFormat, [bin.binNum || '', formatQty(bin.onhandQty)]))
                    .appendTo($label);
                $container.append($label);
            }
            $container.show();

            // 选中某个 BinNum 后回填到源库位文本框（同步仓库/单位）；数量超过该库位库存时仅提示、不清空文本框
            $container.find('input[name="fromBinSelect"]').on('change', function () {
                $container.find('.bin-radio-label').removeClass('checked');
                $(this).closest('.bin-radio-label').addClass('checked');
                var idx = parseInt($(this).val());
                var bin = binList[idx];
                if (bin) {
                    $('#fromLocation').val(bin.binNum || '');
                    if (bin.warehouseCode) $('#fromWarehouse').val(bin.warehouseCode);
                    if (bin.unit) $('#unit').val(bin.unit);

                    var qty = parseFloat($('#quantity').val());
                    var binQty = parseFloat(bin.onhandQty);
                    if (!isNaN(qty) && !isNaN(binQty) && qty > binQty) {
                        showMessage(formatText(localTexts.binQtyExceeded,
                            [bin.binNum || '', formatQty(binQty), formatQty(qty)]), 'warning');
                        setTimeout(() => { $('#quantity').focus().select(); }, 300);
                        return;
                    }
                    setTimeout(() => { validateSourceInventory(); }, 300);
                }
            });
        }

        // 目标仓库扫码解析填充
        function parseAndFillTargetBarcode(barcode) {
            if (!barcodeParser) {
                showMessage(localTexts.parserInitFailed, 'error');
                return;
            }

            try {
                const result = barcodeParser.parse(barcode);

                if (result.success) {
                    const data = result.data;

                    if (result.type !== 'material' && result.type !== 'warehouse' && !data.materialCode) {
                        showMessage(localTexts.pleaseScanValidMaterial, 'error');
                        $('#toWarehouse').val(barcode).focus().select();
                        return;
                    }

                    if (data.warehouseCode) $('#toWarehouse').val(data.warehouseCode);
                    if (data.binNum) $('#toLocation').val(data.binNum);
                    if (data.lotNum) $('#toBatchNo').val(data.lotNum);

                    // showMessage(localTexts.barcodeParseSuccess, 'success');

                    // 条码解析填充后，自动验证目标库位和批次
                    setTimeout(() => {
                        validateTargetLocationAndBatch();
                    }, 300);
                } else {
                    showMessage(localTexts.parseFailed + ': ' + (result.error || ''), 'error');
                    $('#toWarehouse').val(barcode).focus().select();
                }
            } catch (error) {
                console.error('解析异常:', error);
                showMessage(localTexts.parseError + ': ' + error.message, 'error');
            }
        }

        // HTML 转义：动态消息（服务端响应/解析结果）插入 DOM 前统一转义，防止注入（与 CountView 同一实现）
        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str).replace(/&/g, '&amp;')
                              .replace(/</g, '&lt;')
                              .replace(/>/g, '&gt;')
                              .replace(/"/g, '&quot;')
                              .replace(/'/g, '&#039;');
        }

        // 通用消息提示
        function showMessage(message, type) {
            const $message = $('#statusMessage');
            $message.removeClass().addClass('status-message message-' + type)
                   .html(`<i class="fas fa-${getIconForType(type)}"></i> ${escapeHtml(message)}`).show();

            let delay = type === 'error' ? 8000 : type === 'success' ? 5000 : type === 'warning' ? 6000 : 4000;
            setTimeout(() => $message.fadeOut(), delay);
        }

        function getIconForType(type) {
            const icons = {
                'success': 'check-circle',
                'error': 'exclamation-circle',
                'warning': 'exclamation-triangle',
                'info': 'info-circle'
            };
            return icons[type] || 'info-circle';
        }

        // 表单验证函数
        function validateMaterialCode() {
            const val = $('#materialCode').val().trim();
            if (!val) {
                $('#materialCodeError').text(localTexts.materialCodeRequired);
                return false;
            }
            $('#materialCodeError').text('');
            return true;
        }

        function validateQuantity() {
            const val = $('#quantity').val().trim();
            if (!val) {
                $('#quantityError').text(localTexts.quantityRequired);
                return false;
            }
            if (isNaN(parseFloat(val)) || parseFloat(val) <= 0) {
                $('#quantityError').text(localTexts.quantityPositiveRequired);
                return false;
            }
            $('#quantityError').text('');
            return true;
        }

        function validateFromWarehouse() {
            const val = $('#fromWarehouse').val().trim();
            if (!val) {
                $('#fromWarehouseError').text(localTexts.fromWarehouseRequired);
                return false;
            }
            $('#fromWarehouseError').text('');
            return true;
        }

        function validateFromLocation() {
            const val = $('#fromLocation').val().trim();
            if (!val) {
                $('#fromLocationError').text(localTexts.fromLocationRequired);
                return false;
            }
            $('#fromLocationError').text('');
            return true;
        }

        function validateToWarehouse() {
            const val = $('#toWarehouse').val().trim();
            if (!val) {
                $('#toWarehouseError').text(localTexts.toWarehouseRequired);
                return false;
            }
            $('#toWarehouseError').text('');
            return true;
        }

        function validateToLocation() {
            const val = $('#toLocation').val().trim();
            if (!val) {
                $('#toLocationError').text(localTexts.toLocationRequired);
                return false;
            }
            $('#toLocationError').text('');
            return true;
        }

        // 一次提交尝试内固定 ID：失败/超时重试复用同一 ID（服务端据此拦截重复过账），成功后重置。
        var pendingRequestId = null;
        function getRequestId() {
            if (!pendingRequestId) {
                pendingRequestId = (window.crypto && typeof crypto.randomUUID === 'function')
                    ? crypto.randomUUID()
                    : 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
                        var r = Math.random() * 16 | 0;
                        var v = c === 'x' ? r : (r & 0x3 | 0x8);
                        return v.toString(16);
                    });
            }
            return pendingRequestId;
        }
        function resetRequestId() { pendingRequestId = null; }

        // 表单提交
        function submitForm() {
            const valid = validateMaterialCode()
                       & validateQuantity()
                        & validateUnit()  // 添加单位验证
                       & validateFromWarehouse()
                       & validateFromLocation()
                       & validateToWarehouse()
                       & validateToLocation();
            if (!valid) {
                showMessage(localTexts.submitFailed, 'error');
                return;
            }

            const $submitBtn = $('#submitBtn');
            const originalText = $submitBtn.html();
            $submitBtn.prop('disabled', true)
                       .html('<i class="fas fa-spinner fa-spin"></i> ' + localTexts.submitting);

            const formData = {
                MaterialCode: $('#materialCode').val().trim(),
                Quantity: $('#quantity').val().trim(),
                Unit: $('#unit').val().trim(),
                FromWarehouse: $('#fromWarehouse').val().trim(),
                FromLocation: $('#fromLocation').val().trim(),
                FromBatchNo: $('#fromBatchNo').val().trim(),
                ToWarehouse: $('#toWarehouse').val().trim(),
                ToLocation: $('#toLocation').val().trim(),
                ToBatchNo: $('#toBatchNo').val().trim(),
                Remark: $('#remark').val().trim(),
                Operator: $('#operator').val(),
                OperatorId: $('input[name="OperatorId"]').val()
            };

            const token = $('input[name="__RequestVerificationToken"]').val();

            showMessage(localTexts.submitting, 'info');

            $.ajax({
                url: $('#transferForm').attr('action'),
                type: 'POST',
                data: JSON.stringify(formData),
                contentType: 'application/json; charset=utf-8',
                headers: { 'X-CSRF-TOKEN': token,
                           'X-Request-ID': getRequestId() },
                success: function(response) {
                    if (response && response.success) {
                        resetRequestId();
                        // showMessage(response.message || localTexts.submitSuccess, 'success');
                        resetForm();
                    } else {
                        const errorMsg = response && response.message ? response.message : localTexts.submitFailed;
                        showMessage(errorMsg, 'error');
                    }
                    $submitBtn.prop('disabled', false).html(originalText);
                },
                error: function(xhr) {
                    console.error('提交失败:', xhr);
                    let errorMsg = localTexts.networkError;
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    } else if (xhr.responseText) {
                        try {
                            const res = JSON.parse(xhr.responseText);
                            if (res.message) errorMsg = res.message;
                        } catch (e) {}
                    }
                    showMessage(errorMsg, 'error');
                    $submitBtn.prop('disabled', false).html(originalText);
                }
            });
        }
                // 添加单位验证函数
        function validateUnit() {
            const val = $('#unit').val().trim();
            if (!val) {
                $('#unitError').text(localTexts.unitRequired);
                return false;
            }
            $('#unitError').text('');
            return true;
        }
        // 重置表单
        function resetForm() {
            $('#transferForm')[0].reset();
            hideFromBinRadioList();
            $('.error-message').text('');
            // 清除验证样式
            $('.input-field').removeClass('validating valid-success valid-error');
            $('#fromWarehouse').focus().select();
            showMessage(localTexts.formReset, 'info');
        }
    </script>
</body>
</html>